diff --git a/src/rendering/renderer_members_vulkan.inc b/src/rendering/renderer_members_vulkan.inc
index bcf7ddd..5f13b54 100644
--- a/src/rendering/renderer_members_vulkan.inc
+++ b/src/rendering/renderer_members_vulkan.inc
@@ -3,6 +3,11 @@
 // #ifndef _WIN32. Definitions live in renderer_vulkan.cpp. This is a pure relocation
 // of what were inline #ifndef _WIN32 members — no logic changes.
 
+// upstream's BeginStereoCaptureGeneration at the left eye's 3D color clear: RenderFrame::Reset(),
+// which also clears the per-frame weapon motion-analysis slots. The Linux path has no EndFrame
+// RenderFrame::Reset(), so it runs the same reset at the start of every game frame's stereo pair.
+void LinuxBeginStereoCaptureGeneration(long frameIdx);
+
 // Cemu framebuffer capture entry points, driven by the clear hooks in framebuffer.cpp.
 void LinuxCopyColorToSwapchain(OpenXR::EyeSide side, VkCommandBuffer cmdBuffer, VkImage srcImage, uint32_t srcWidth, uint32_t srcHeight, long frameIdx);
 void LinuxCopyDepthToSwapchain(OpenXR::EyeSide side, VkCommandBuffer cmdBuffer, VkImage srcImage, uint32_t srcWidth, uint32_t srcHeight, long frameIdx);
diff --git a/src/rendering/renderer_vulkan.cpp b/src/rendering/renderer_vulkan.cpp
index c4e6bc9..e23e286 100644
--- a/src/rendering/renderer_vulkan.cpp
+++ b/src/rendering/renderer_vulkan.cpp
@@ -2299,6 +2299,26 @@ static RenderUtils::UvTransform ComputeEyeUvTransform(OpenXR::EyeSide side, floa
     return RenderUtils::GetPresentationUvTransform(rawFov, renderAspectRatio);
 }
 
+// upstream renderer.cpp:509-521: BeginStereoCaptureGeneration() -> RenderFrame::BeginStereoCapture()
+// -> Reset() runs at the left eye's 3D color clear, before that eye's color is accepted. Reset()
+// clears every per-capture field, including both ranMotionAnalysis slots; BeginStereoCapture()
+// keeps CaptureIssue_MonoCapture and starts a new stereo generation. The Linux path has no
+// Windows EndFrame that resets the frame, so it runs the same reset here, once per game frame.
+void RND_Renderer::LinuxBeginStereoCaptureGeneration(long frameIdx) {
+    if (frameIdx < 0 || frameIdx >= (long)m_renderFrames.size()) {
+        return;
+    }
+    RenderFrame& frame = m_renderFrames[frameIdx];
+    const bool preserveMonoCapture = (frame.issueFlags & CaptureIssue_MonoCapture) != 0;
+    frame.Reset();
+    if (preserveMonoCapture) {
+        frame.AddIssue(CaptureIssue_MonoCapture);
+    }
+    frame.recordKind = CaptureRecordKind::Stereo3D;
+    frame.activeStereoGeneration = m_nextStereoGeneration++;
+    frame.lastActivityOrdinal = NextCaptureActivityOrdinal();
+}
+
 // Linux capture dispatch for the CmdClearColorImage hook. Moved verbatim out of the
 // shared framebuffer.cpp so that hook stays a thin dispatcher. Runs the 3D-color
 // (captureIdx 0) and 2D-HUD (captureIdx 2) capture paths, then issues the transparent
@@ -2370,6 +2390,13 @@ void RND_Renderer::LinuxHandleColorClear(OpenXR::EyeSide side, long captureIdx,
                             this, side, frameIdx, srcFormat, srcWidth, srcHeight);
                     }
                 }
+                // upstream framebuffer.cpp:211-219: the left eye's 3D color clear starts the stereo
+                // generation and resets the frame. That Reset() is what clears ranMotionAnalysis
+                // on the Windows path; run the same reset here, once per game frame, before the
+                // left color copy.
+                if (side == OpenXR::EyeSide::LEFT) {
+                    LinuxBeginStereoCaptureGeneration(frameIdx);
+                }
                 // Keep the normal startup capture path alive even while inventory screens
                 // are visible; suppressing these copies can strand the submit thread in
                 // HUD-only mode if the pause screen state lingers after close.
