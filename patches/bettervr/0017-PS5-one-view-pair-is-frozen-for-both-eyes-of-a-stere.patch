--- a/src/hooking/entity_controller.cpp
+++ b/src/hooking/entity_controller.cpp
@@ -675,6 +675,14 @@ extern "C" bool BetterVR_PS5_Fades() {
     return s_fades;
 }
 
+// PS5: bettervr.json's poseFreeze (default on), cached once. On, the left eye's BeginCameraSide
+// promotes one view pair and both eyes of that pair render and copy it; off is the old per-read
+// latch. The renderer reads this and runtime.cpp logs the same value.
+extern "C" bool BetterVR_PS5_PoseFreeze() {
+    static const bool s_poseFreeze = BetterVR_PS5_Setting("poseFreeze", 1.0f) >= 0.5f;
+    return s_poseFreeze;
+}
+
 static bool ShouldDrivePlayerBodyWithVR(const glm::fvec3& currentHeadPos, const PlayerBase& player) {
     // PS5 experiment: bettervr.json {"roomscale":0} turns the head-driven body movement off (read once). Default on.
     static const bool s_roomscaleOn = BetterVR_PS5_Setting("roomscale", 1.0f) >= 0.5f;
