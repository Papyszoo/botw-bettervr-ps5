@@ -509,6 +529,23 @@ struct LinuxRenderState {
 
 static std::unique_ptr<LinuxRenderState> s_linux;
 
+// poseFreeze proof, read by the app's per-600-frame line (runtime.cpp): per eye, the completed
+// pairs whose camera pose differed from the pose the pair was submitted with, the largest
+// difference in milliseconds, and the StartFrame guard clears.
+extern "C" void BetterVR_PS5_PoseProof(uint64_t* leftStale, uint64_t* rightStale, double* maxAgeMs, uint64_t* guardClears) {
+    uint64_t left = 0, right = 0, ageNs = 0, clears = 0;
+    if (s_linux) {
+        left = s_linux->poseProof.stale[0].load(std::memory_order_relaxed);
+        right = s_linux->poseProof.stale[1].load(std::memory_order_relaxed);
+        ageNs = s_linux->poseProof.maxAgeNs.load(std::memory_order_relaxed);
+        clears = s_linux->poseProof.frozenGuardClears.load(std::memory_order_relaxed);
+    }
+    if (leftStale) *leftStale = left;
+    if (rightStale) *rightStale = right;
+    if (maxAgeMs) *maxAgeMs = (double)ageNs / 1e6;
+    if (guardClears) *guardClears = clears;
+}
+
 // The comfort fade applied to the eye image: a solid colour whose alpha is the combined fade.
