+    if (!m_linuxNeedsLatch.load(std::memory_order_acquire)) return;
+    if (m_linuxStereoPoseFrozen.load(std::memory_order_acquire)) return;
+    std::lock_guard<std::mutex> latchLock(m_linuxLatchMutex);
     if (!m_linuxNeedsLatch.exchange(false, std::memory_order_acquire)) return;
+    if (m_linuxStereoPoseFrozen.load(std::memory_order_acquire)) {
+        // the left pass froze the pair while this caller waited for the lock
