             s_linux->stats.diag3DPendingLeftStarts.fetch_add(1, std::memory_order_relaxed);
@@ -2606,6 +2670,23 @@ void RND_Renderer::LinuxCopyColorToSwapchain(OpenXR::EyeSide side, VkCommandBuff
     pair.eyeCopied[1] = true;
     pair.bufferIdx[1] = wIdx;
     pair.colorCopyAt[1] = captured.colorCopyAt[1];
+    pair.cameraDisplayTime[1] = eyeCameraDisplayTime;
+    pair.cameraTimeValid[1] = hasEyeCameraDisplayTime;
+    // poseFreeze proof: the pair is submitted with the left copy's views. Count an eye when its
+    // camera was built with another pose, and keep the largest age difference.
+    if (pair.hasRenderViews) {
+        for (int eye = 0; eye < 2; ++eye) {
+            if (!pair.cameraTimeValid[eye] || pair.cameraDisplayTime[eye] == 0 || pair.renderDisplayTime == 0) continue;
