+bool PromotePendingViews(bool wait) const;
+bool PromotePendingViewsLocked(bool wait) const;
+
+// poseFreeze: the left BeginCameraSide promotes the stereo pair's views once and both eyes keep
+// them until the right EndCameraSide; off (bettervr.json's poseFreeze=0) the old latch runs.
+void LinuxStereoPoseBegin(OpenXR::EyeSide side) const;
+void LinuxStereoPoseEnd(OpenXR::EyeSide side) const;
+
+// poseFreeze proof: the display time of the views each eye's camera was built with, noted by
+// hook_GetRenderCamera and consumed by that eye's 3D copy.
+void LinuxBeginEyeCameraPose(OpenXR::EyeSide side) const;
+void LinuxNoteEyeCameraPose(OpenXR::EyeSide side) const;
