+            return false; // proceed with stale m_currViews
         }
         views = *s_linux->submit.pendingViews;
         viewsDisplayTime = s_linux->submit.pendingFrameState.predictedDisplayTime;
@@ -2811,6 +2923,59 @@ void RND_Renderer::LatchPendingIfNeeded() const {
         m_currViews = views;
         m_linuxCurrViewsDisplayTime = viewsDisplayTime;
     }
+    return true;
+}
+
+bool RND_Renderer::PromotePendingViewsLocked(bool wait) const {
+    if (!PromotePendingViews(wait)) return false;
+    ++m_linuxPromotionGeneration;
+    return true;
+}
+
+// poseFreeze: called at the left BeginCameraSide, before the game builds that eye's camera.
+void RND_Renderer::LinuxStereoPoseBegin(OpenXR::EyeSide side) const {
+    if (!s_linux || side != OpenXR::EyeSide::LEFT || !BetterVR_PS5_PoseFreeze()) return;
+    std::lock_guard<std::mutex> latchLock(m_linuxLatchMutex);
+    // One promotion per stereo frame. A present-path latch that won the race just before this
+    // point already promoted the pair. This runs on the PPC game thread, so it never waits: it
+    // takes a pending pair if one is already there and otherwise keeps the current views.
+    if (m_linuxPromotionGeneration == m_linuxLastStereoPromotion) {
+        m_linuxNeedsLatch.store(false, std::memory_order_release);
+        PromotePendingViewsLocked(false);
+    }
+    m_linuxLastStereoPromotion = m_linuxPromotionGeneration;
+    m_linuxStereoPoseFrozen.store(true, std::memory_order_release);
+}
+
+// poseFreeze: called at the right EndCameraSide, after the right image has been drawn.
+void RND_Renderer::LinuxStereoPoseEnd(OpenXR::EyeSide side) const {
+    if (!s_linux || side != OpenXR::EyeSide::RIGHT || !BetterVR_PS5_PoseFreeze()) return;
+    m_linuxStereoPoseFrozen.store(false, std::memory_order_release);
+    m_linuxFrozenStartFrames.store(0, std::memory_order_release);
+}
+
+// poseFreeze proof: called by hook_GetRenderCamera before it builds this eye's camera. An early
+// return (menu, flat view, black bars) leaves no time, so that copy is not counted.
+void RND_Renderer::LinuxBeginEyeCameraPose(OpenXR::EyeSide side) const {
+    if (!s_linux) return;
+    const int sideIdx = (int)side;
+    if (sideIdx < 0 || sideIdx >= 2) return;
+    s_linux->poseProof.cameraTimeValid[sideIdx].store(false, std::memory_order_release);
+}
+
+// poseFreeze proof: the display time of the views the camera was just built with. poseFreeze holds
+// them for the whole pair, so this is the time the image is rendered with.
+void RND_Renderer::LinuxNoteEyeCameraPose(OpenXR::EyeSide side) const {
+    if (!s_linux) return;
+    const int sideIdx = (int)side;
+    if (sideIdx < 0 || sideIdx >= 2) return;
+    XrTime displayTime = 0;
+    {
+        std::shared_lock viewsLock(m_viewsMutex);
+        displayTime = m_linuxCurrViewsDisplayTime;
+    }
+    s_linux->poseProof.cameraDisplayTime[sideIdx].store(displayTime, std::memory_order_relaxed);
+    s_linux->poseProof.cameraTimeValid[sideIdx].store(true, std::memory_order_release);
 }
 
 // Backend-specific view accessor used by the shared pose getters in renderer.h.
