+std::string CemuHost::GetShadowPreset() {
+    return HostModule::GetGraphicPackPreset(s_graphicsPack, "Shadows");
+}
+
+float CemuHost::GetShadowResolutionScale() {
+    // the preset names carry the scale, e.g. "High (200%)": reading it once keeps the map size the one the game
+    // started with, even if the menu saves another preset for the next start
+    static const float scale = [] {
+        const std::string preset = HostModule::GetGraphicPackPreset(s_graphicsPack, "Shadows");
+        const auto percent = preset.find('%');
+        const auto open = preset.rfind('(', percent);
+        if (percent == std::string::npos || open == std::string::npos || open > percent)
+            return 0.0f;
+        try {
+            return std::stof(preset.substr(open + 1, percent - open - 1)) / 100.0f;
+        }
+        catch (const std::exception&) {
+            return 0.0f;
+        }
+    }();
+    return scale;
+}
+
