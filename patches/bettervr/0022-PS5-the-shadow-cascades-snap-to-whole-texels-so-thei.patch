diff --git a/src/game/botw/shadow_stabilizer.cpp b/src/game/botw/shadow_stabilizer.cpp
new file mode 100644
index 0000000..bd412fb
--- /dev/null
+++ b/src/game/botw/shadow_stabilizer.cpp
@@ -0,0 +1,82 @@
+#include "pch.h"
+#include "shadow_stabilizer.h"
+#include "cemu/cemu_host.h"
+#include "cemu/guest_memory.h"
+#include "utils/logger.h"
+
+// The game fits the cascaded shadow map to the record camera every frame. With a head that moves, the fit's origin
+// crawls by a fraction of a texel a frame, so the 2x2 PCF taps land on different texels and the dapple re-forms. The
+// matrices are written by the game just before the shadow pass and the receivers use the same ones: rounding their
+// translation to whole shadow-map texels moves the fit in visible steps of one texel instead.
+
+namespace {
+    // BreathOfTheWild_Graphics/rules.txt: the cascade render targets before $shadowRes (768x720, 720x720, 384x368,
+    // 384x360). The Graphics pack multiplies them by the Shadows preset's number.
+    constexpr std::array<int, 4> kCascadeWidth{768, 720, 384, 384};
+    constexpr std::array<int, 4> kCascadeHeight{720, 720, 368, 360};
+
+    // the ShadowPrePass slot 0 holds three cascade view-projection matrices; their output is clip space, so one
+    // texel is two units. The DepthShadowProj slot 17 matrices output shadow UV, where one texel is one unit.
+    void SnapTranslation(uint32_t matrix, int width, int height, float scale, bool clipSpace) {
+        const float unitsPerTexel = clipSpace ? 2.0f : 1.0f;
+        const float stepX = unitsPerTexel / (width * scale);
+        const float stepY = unitsPerTexel / (height * scale);
+
+        float x = 0.0f;
+        float y = 0.0f;
+        Guest::ReadBE(matrix + 12, &x);  // row 0's w, 3 floats in
+        Guest::ReadBE(matrix + 28, &y);  // row 1's w, 7 floats in
+        const float snappedX = std::round(x / stepX) * stepX;
+        const float snappedY = std::round(y / stepY) * stepY;
+        if (snappedX == x && snappedY == y)
+            return;
+        Guest::WriteBE(matrix + 12, &snappedX);
+        Guest::WriteBE(matrix + 28, &snappedY);
+    }
+
+    float ShadowScale() {
+        static const float scale = CemuHost::GetShadowResolutionScale();
+        static const bool logged = [] {
+            if (scale > 0.0f)
+                Log::print<INFO>("Shadow cascades: 1-texel snap on, Shadows \"{}\" ({:.2f}x)", CemuHost::GetShadowPreset(), scale);
+            else
+                Log::print<WARNING>("Shadow cascades: no Shadows preset scale, no texel snap");
+            return true;
+        }();
+        (void)logged;
+        return scale;
+    }
+
+    // DepthShadowProj[cascade], view space -> shadow UV: the sampling matrix of one cascade
+    void hook_SnapShadowCascadeProj(PPCInterpreter_t* hCPU) {
+        hCPU->instructionPointer = hCPU->sprNew.LR;
+
+        const uint32_t cascade = hCPU->gpr[4];
+        const uint32_t matrix = hCPU->gpr[5];
+        if (matrix == 0 || cascade >= kCascadeWidth.size())
+            return;
+        const float scale = ShadowScale();
+        if (scale <= 0.0f)
+            return;
+        SnapTranslation(matrix, kCascadeWidth[cascade], kCascadeHeight[cascade], scale, false);
+    }
+
+    // ShadowPrePass slot 0, the three near cascades' view-projection matrices used to render the map
+    void hook_SnapShadowCascadePrePass(PPCInterpreter_t* hCPU) {
+        hCPU->instructionPointer = hCPU->sprNew.LR;
+
+        const uint32_t matrices = hCPU->gpr[4];
+        if (matrices == 0)
+            return;
+        const float scale = ShadowScale();
+        if (scale <= 0.0f)
+            return;
+        for (uint32_t cascade = 0; cascade < 3; cascade++)
+            SnapTranslation(matrices + cascade * 64, kCascadeWidth[cascade], kCascadeHeight[cascade], scale, true);
+    }
+}
+
+void ShadowStabilizer::RegisterHooks() {
+    CemuHost::RegisterHook("hook_SnapShadowCascadeProj", &hook_SnapShadowCascadeProj);
+    CemuHost::RegisterHook("hook_SnapShadowCascadePrePass", &hook_SnapShadowCascadePrePass);
+}
