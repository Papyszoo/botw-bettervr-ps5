+
+bool HandAim::TryGetGazeWorldRay(const glm::vec3& stageDirection, glm::vec3& outOrigin, glm::vec3& outDirection) {
+    const std::optional<glm::fmat4> head = Tracking::HeadPose();
+    if (!head.has_value() || !IsAllFinite(stageDirection) || glm::length2(stageDirection) < 0.000001f) {
+        return false;
+    }
+
+    const glm::mat4 reference = ResolveCameraReferenceMtx(-1);
+    outOrigin = glm::vec3(reference * glm::vec4(RemoveHeadsetHorizontalOffset(glm::vec3((*head)[3])), 1.0f));
+    outDirection = glm::normalize(glm::mat3(reference) * stageDirection);
+    return IsAllFinite(outOrigin) && IsAllFinite(outDirection);
+}
