From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Fri, 20 Nov 2026 02:22:07 +0100
Subject: [PATCH] PS5: a gaze throw assist acts only on a real gaze sample and
 bends a left-hand throw around the left hand; built, untested on console

---
 src/game/botw/input/controls.cpp | 28 ++++++++++++++--------------
 src/rendering/imgui_menus.cpp    |  2 +-
 2 files changed, 15 insertions(+), 15 deletions(-)

diff --git a/src/game/botw/input/controls.cpp b/src/game/botw/input/controls.cpp
index a5d2fd9..fda8fe6 100644
--- a/src/game/botw/input/controls.cpp
+++ b/src/game/botw/input/controls.cpp
@@ -818,9 +818,9 @@ static void ProcessLeftTriggerBindings(
 }
 
 // A throw is bent toward where the player looks, by at most kGazeThrowMaxBend degrees, keeping the
-// hand's speed. Without an eye-gaze sample the head's forward direction is the target, so the
-// assist still works with eye tracking off, just less precisely. Returns the velocity unchanged
-// when there is no head pose or the wanted direction cannot be formed.
+// hand's speed. The assist acts only on a valid eye-gaze sample: without one the velocity is handed
+// back unchanged, as the release direction is the player's own. `hand` is the hand the throw left
+// from, so a left-hand throw is bent around the left hand's position rather than the right's.
 static bool NormalizeDirection(const glm::fvec3& direction, glm::fvec3& outDirection) {
     if (!glm::all(glm::isfinite(direction)) || glm::dot(direction, direction) <= 1.0e-6f)
         return false;
@@ -828,7 +828,7 @@ static bool NormalizeDirection(const glm::fvec3& direction, glm::fvec3& outDirec
     return true;
 }
 
-static glm::fvec3 ApplyGazeThrowAssist(const glm::fvec3& velocity, const OpenXR::InputState& inputs) {
+static glm::fvec3 ApplyGazeThrowAssist(const glm::fvec3& velocity, const OpenXR::InputState& inputs, OpenXR::EyeSide hand) {
     constexpr float targetDistance = 10.0f;
     constexpr float maxBendDegrees = 15.0f;
 
@@ -838,18 +838,15 @@ static glm::fvec3 ApplyGazeThrowAssist(const glm::fvec3& velocity, const OpenXR:
     if (!head.has_value())
         return velocity;
 
-    const glm::fmat4 reference = Camera::GetReferenceMtx();
-    glm::fvec3 directionStage;
-    const char* source = "head";
     const std::optional<glm::fvec3> gaze = Tracking::EyeGaze();
-    if (gaze.has_value() && NormalizeDirection(*gaze, directionStage))
-        source = "gaze";
-    else if (!NormalizeDirection(glm::mat3(*head) * glm::fvec3(0.0f, 0.0f, -1.0f), directionStage))
+    glm::fvec3 directionStage;
+    if (!gaze.has_value() || !NormalizeDirection(*gaze, directionStage))
         return velocity;
 
+    const glm::fmat4 reference = Camera::GetReferenceMtx();
     const glm::fvec3 headWorld = glm::vec3(reference * glm::fvec4(glm::fvec3((*head)[3]), 1.0f));
     const glm::fvec3 target = headWorld + glm::normalize(glm::mat3(reference) * directionStage) * targetDistance;
-    const glm::fvec3 handWorld = glm::vec3(reference * glm::fvec4(ToGLM(inputs.shared.poseLocation[OpenXR::EyeSide::RIGHT].pose.position), 1.0f));
+    const glm::fvec3 handWorld = glm::vec3(reference * glm::fvec4(ToGLM(inputs.shared.poseLocation[hand].pose.position), 1.0f));
     glm::fvec3 wanted;
     if (!NormalizeDirection(target - handWorld, wanted))
         return velocity;
@@ -861,7 +858,7 @@ static glm::fvec3 ApplyGazeThrowAssist(const glm::fvec3& velocity, const OpenXR:
     const float bend = std::min(angle, glm::radians(maxBendDegrees));
     const glm::fvec3 axis = glm::cross(current, wanted);
     const glm::fvec3 assisted = glm::dot(axis, axis) > 1.0e-8f ? glm::angleAxis(bend, glm::normalize(axis)) * current : current;
-    Log::print<INFO>("[Throw] gaze assist bent {:.1f} degrees toward the {}", glm::degrees(bend), source);
+    Log::print<INFO>("[Throw] gaze assist bent {:.1f} degrees toward the gaze", glm::degrees(bend));
     return assisted * glm::length(velocity);
 }
 
@@ -922,8 +919,11 @@ static void ProcessHandThrow(uint32_t& buttonHold, const OpenXR::InputState& inp
         const float handSpeed = glm::length(releaseVelocity.value());
         const float boost = glm::mix(1.0f, maxThrowBoost, glm::smoothstep(boostStartSpeed, boostFullSpeed, handSpeed));
         glm::fvec3 throwVelocity = glm::mat3(Camera::GetReferenceMtx()) * releaseVelocity.value() * boost;
-        if (GetSettings().eyeGazeThrowAssist)
-            throwVelocity = ApplyGazeThrowAssist(throwVelocity, inputs);
+        if (GetSettings().eyeGazeThrowAssist) {
+            // the game throws from its right hand; with nothing in that hand the throw is the left's
+            const bool leftHandThrow = state.hasSomethingInLeftHand && !state.hasSomethingInRightHand;
+            throwVelocity = ApplyGazeThrowAssist(throwVelocity, inputs, leftHandThrow ? OpenXR::EyeSide::LEFT : OpenXR::EyeSide::RIGHT);
+        }
         Player::RequestHandThrow(throwVelocity);
         Log::print<CONTROLS>("[Throw] released with hand speed {:.2f}, boosted {:.2f}x", handSpeed, boost);
     }
diff --git a/src/rendering/imgui_menus.cpp b/src/rendering/imgui_menus.cpp
index c1e6f87..7b032b8 100644
--- a/src/rendering/imgui_menus.cpp
+++ b/src/rendering/imgui_menus.cpp
@@ -1188,7 +1188,7 @@ void RND_Renderer::ImGuiOverlay::DrawControlsPage(bool* changed) {
                 DrawEnumSegments(settings.swingSensitivity, swingChoices, changed);
             });
             if (VRManager::instance().XR->m_capabilities.supportsEyeGaze && BetterVR_PS5_EyeGazeAvailable() != 0) {
-                DrawSetting(ICON_MS_EYE_TRACKING, "Gaze Throw Assist", "Bends a throw up to 15 degrees toward where you look; with eye tracking off, toward where you face. Off by default.", [&]() {
+                DrawSetting(ICON_MS_EYE_TRACKING, "Gaze Throw Assist", "Bends a throw up to 15 degrees toward your eye-tracked gaze; without a gaze sample a throw is unchanged. Off by default.", [&]() {
                     DrawToggle(settings.eyeGazeThrowAssist, changed);
                 });
             }
