From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Thu, 19 Nov 2026 20:32:26 +0100
Subject: [PATCH] PS5: the runtime's one clock decides a held Options, so a
 press is a recenter or a pause; built, untested on console

The runtime's 1 s hold and BetterVR's own 1 s timer ran on different clocks, so a release at about a second could recenter and then send the game's +: the runtime polled the pad on its own schedule while the game measured from its next frame. The runtime now publishes whether the press became its recenter (BetterVR_PS5_OptionsRecentered, one per input), and controls.cpp reads that decision on the release; its own clock remains only for the `[menu] Options up after N ms` line. One clock and one threshold, on the Sense and the DualSense: a press is the recenter or the pause, never both.
---
 src/game/botw/input/controls.cpp | 28 +++++++++++++++-------------
 1 file changed, 15 insertions(+), 13 deletions(-)

diff --git a/src/game/botw/input/controls.cpp b/src/game/botw/input/controls.cpp
index af37baa..9fc82dc 100644
--- a/src/game/botw/input/controls.cpp
+++ b/src/game/botw/input/controls.cpp
@@ -1109,6 +1109,9 @@ static void ProcessInputPrevention(ControlState& state, std::chrono::steady_cloc
 #if defined(__PROSPERO__)
 // the runtime's: whether Options on the right Sense controller is down (port/bettervr/xr/runtime.cpp)
 extern "C" bool BetterVR_PS5_OptionsDown();
+// the runtime's: whether this Options press became its recenter, on the input the caller names (true: the
+// DualSense). Its one clock and one threshold decide between the recenter and the game's pause.
+extern "C" bool BetterVR_PS5_OptionsRecentered(bool pad);
 
 // The DualSense's touchpad + Options tap (port/ps5/pad.cpp): BetterVR's menu, as the left Square's long press opens
 // it. The port calls this, so it can run with no VR session: what it returns is whether there was a menu to toggle.
@@ -1129,28 +1132,29 @@ extern "C" bool BetterVR_PS5_ToggleModMenu() {
 // sends it. The Touch profile gives the Sense's button no action, so that one is read from the runtime. The left X
 // (Square) long press below still opens BetterVR's menu, and on the DualSense the touchpad's click with it does.
 
-// one input's Options state: the Sense's and the pad's are independent, so one cannot swallow the other's press
+// one input's Options state: the Sense's and the pad's are independent, so one cannot swallow the other's press.
+// The clock here is only the log's: the runtime's hold decides whether the press is a recenter or the game's pause.
 struct OptionsButtonState {
     bool wasDown = false;
-    bool longPressDone = false;
+    bool recenterLogged = false;
     std::chrono::steady_clock::time_point downAt;
 };
 
 static OptionsButtonState s_senseOptions;
 static OptionsButtonState s_padOptions;
 
-static void ProcessOptionsButton(uint32_t& buttonHold, ControlState& state, bool down, OptionsButtonState& s) {
-    constexpr auto kLongPress = std::chrono::milliseconds(1000);
+static void ProcessOptionsButton(uint32_t& buttonHold, ControlState& state, bool down, bool pad, OptionsButtonState& s) {
     const auto now = std::chrono::steady_clock::now();
     if (down && !s.wasDown) {
         s.wasDown = true;
-        s.longPressDone = false;
+        s.recenterLogged = false;
         s.downAt = now;
         Log::print<INFO>("[menu] Options down");
         return;
     }
-    if (down && !s.longPressDone && now - s.downAt >= kLongPress) {
-        s.longPressDone = true;
+    // the runtime owns the hold: one clock, one threshold, so a press is the recenter or the pause, never both
+    if (down && !s.recenterLogged && BetterVR_PS5_OptionsRecentered(pad)) {
+        s.recenterLogged = true;
         Log::print<INFO>("[menu] Options held for 1 s: the view recenters, no pause");
         return;
     }
@@ -1159,10 +1163,8 @@ static void ProcessOptionsButton(uint32_t& buttonHold, ControlState& state, bool
     s.wasDown = false;
     const auto heldMs = std::chrono::duration_cast<std::chrono::milliseconds>(now - s.downAt).count();
     Log::print<INFO>("[menu] Options up after {} ms", (long long)heldMs);
-    if (s.longPressDone)
-        return;
-    // a stall can hide the second from every game frame: the release still decides, with the measured time
-    if (now - s.downAt >= kLongPress) {
+    // a stalled game frame can miss the line above, not the decision: the runtime still says whether it recentered
+    if (BetterVR_PS5_OptionsRecentered(pad)) {
         Log::print<INFO>("[menu] release after the second: no pause");
         return;
     }
@@ -1655,8 +1657,8 @@ static void hook_InjectXRInput(PPCInterpreter_t* hCPU) {
     // the pad's + is the same Options press: the game never sees it while it is held, so a hold never pauses (the
     // recenter is the runtime's) and the release sends the tap
     vpadStatus.hold = vpadStatus.hold.getLE() & ~static_cast<uint32_t>(VPAD_BUTTON_PLUS);
-    ProcessOptionsButton(newXRBtnHold, state, BetterVR_PS5_OptionsDown(), s_senseOptions);
-    ProcessOptionsButton(newXRBtnHold, state, (physicalHold & VPAD_BUTTON_PLUS) != 0, s_padOptions);
+    ProcessOptionsButton(newXRBtnHold, state, BetterVR_PS5_OptionsDown(), false, s_senseOptions);
+    ProcessOptionsButton(newXRBtnHold, state, (physicalHold & VPAD_BUTTON_PLUS) != 0, true, s_padOptions);
 #endif
     UpdateGuide(inputs, isMenuOpen);
     HandGestureState leftGesture = {};
