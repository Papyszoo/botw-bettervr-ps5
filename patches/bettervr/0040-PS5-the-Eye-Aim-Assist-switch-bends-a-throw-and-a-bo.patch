+// Eye Aim Assist pulls a player's arrow toward where the player looks by its strength, and only while the gaze
+// is already inside a cone that widens as the strength falls (5 degrees at a quarter, none at full): a gaze
+// further off leaves the arrow where the bow points. The target moves with the direction, so a homing arrow and
+// the actor's launch transform agree.
+static bool ApplyEyeAimBowAssist(BowVisualizationState& state) {
+    constexpr float gazeDistance = kLaunchTargetDistance;
+
+    const float strength = GetSettings().eyeAimAssist;
+    if (strength <= 0.0f || !state.hasLaunchOrigin || !state.hasLaunchDirection)
+        return false;
+    const std::optional<glm::fvec3> gaze = Tracking::EyeGaze();
+    if (!gaze.has_value() || !HasFiniteDirection(*gaze))
+        return false;
+    const std::optional<glm::fmat4> head = Tracking::HeadPose();
+    if (!head.has_value())
+        return false;
+
+    const glm::mat4 reference = Camera::GetReferenceMtx();
+    const glm::vec3 headWorld = glm::vec3(reference * glm::vec4(glm::vec3((*head)[3]), 1.0f));
+    const glm::vec3 target = headWorld + glm::normalize(glm::mat3(reference) * glm::normalize(*gaze)) * gazeDistance;
+    if (!HasFiniteDirection(target - state.launchOrigin))
+        return false;
+    const glm::vec3 wanted = glm::normalize(target - state.launchOrigin);
+
+    const glm::vec3 aim = glm::normalize(state.launchDirection);
+    const float angle = std::acos(glm::clamp(glm::dot(aim, wanted), -1.0f, 1.0f));
+    const float gate = strength >= 0.999f ? glm::pi<float>() : glm::radians(5.0f) / strength;
+    if (angle > gate || angle < glm::radians(0.5f))
+        return false;
+
+    float targetDistance = kLaunchTargetDistance;
+    if (state.hasTargetPos && IsFiniteVec3(state.targetPos)) {
+        const float distance = glm::distance(state.launchOrigin, state.targetPos);
+        if (std::isfinite(distance) && distance > 0.0001f)
+            targetDistance = distance;
+    }
+
+    const float bend = angle * strength;
+    const glm::vec3 axis = glm::cross(aim, wanted);
+    const glm::vec3 assisted = strength >= 0.999f ? wanted :
+        (glm::dot(axis, axis) > 1.0e-8f ? glm::angleAxis(bend, glm::normalize(axis)) * aim : aim);
+
+    state.launchDirection = assisted;
+    state.targetPos = state.launchOrigin + assisted * targetDistance;
+    state.hasTargetPos = true;
+    state.eyeAimAssisted = true;
+    state.eyeAimRawDegrees = glm::degrees(angle);
+    state.eyeAimAppliedDegrees = glm::degrees(bend);
+    state.eyeAimStrength = strength;
+    return true;
+}
+
