+// a strength from off to full; the Eye Aim Assist row was an on/off switch, and its old "true" is 25 %
+class EyeAimAssistSetting : public FloatSetting {
+public:
+    EyeAimAssistSetting(): FloatSetting("EyeAimAssist", 0.0f, 0.0f, 1.0f) {}
+
+    void Deserialize(std::string_view valueString) override {
+        if (IEquals(valueString, "true") || IEquals(valueString, "on")) {
+            *this = 0.25f;
+            return;
+        }
+        if (IEquals(valueString, "false") || IEquals(valueString, "off")) {
+            *this = 0.0f;
+            return;
+        }
+        FloatSetting::Deserialize(valueString);
+    }
+};
