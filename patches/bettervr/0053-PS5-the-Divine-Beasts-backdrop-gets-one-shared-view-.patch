 ; ================================================================================
@@ -338,6 +472,8 @@ stw r4, 0x10(r1)
 stw r5, 0x14(r1)
 bl import.coreinit.hook_SnapShadowCascadeProj ; round the cascade fit to whole texels, see shadow_stabilizer.cpp
