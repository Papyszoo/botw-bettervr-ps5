+static void LogBackgroundSummary(bool left, bool wrote, uint32_t blockIndex) {
+    const uint64_t now = GetTimeStamp();
+    if (left) {
+        ++s_backgroundLeftPrepares;
+        if (wrote) ++s_backgroundLeftWrites;
+    }
+    else {
+        ++s_backgroundRightPrepares;
+        if (wrote) ++s_backgroundRightWrites;
+    }
+    if (wrote) s_backgroundLastBlockIndex = blockIndex;
+
+    if (s_backgroundLastSummaryNs == 0) {
+        s_backgroundLastSummaryNs = now;
+        return;
+    }
+    if (now - s_backgroundLastSummaryNs < kBackgroundSummaryIntervalNs) {
+        return;
+    }
+    Log::print<INFO>("[bgcam] summary: block {}, left {}/{} right {}/{} (written/prepared)",
+        s_backgroundLastBlockIndex, s_backgroundLeftWrites, s_backgroundLeftPrepares,
+        s_backgroundRightWrites, s_backgroundRightPrepares);
+    s_backgroundLeftPrepares = s_backgroundLeftWrites = 0;
+    s_backgroundRightPrepares = s_backgroundRightWrites = 0;
+    s_backgroundLastSummaryNs = now;
+}
+
+// the replay's per-view recalc, redirected to the background pass's block: the host finds the block whose view is
+// the background camera's, swaps the eye's shared matrices for the background view and that eye's projection, and
+// recalcBackgroundGpuView (patch_RND_StereoReplay.asm) writes that one block. It returns 1 in r3 when it prepared
+// the swap, 0 when no block matches
+static void hook_PrepareBackgroundGpuView(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+
+    const uint32_t ctx = hCPU->gpr[3];
+    const float eyeOffset = hCPU->fpr[1].fp0;
+    const bool left = eyeOffset < 0.0f;
+    hCPU->gpr[3] = 0;
+    s_backgroundGpuViewState.prepared = false;
+
+    if (!Tracking::IsSessionRunning()) {
+        return;
+    }
+    // a loading screen is a map change: a record from before it belongs to the map that is going away
+    if (Screens::IsLoadingVisible()) {
+        ClearBackgroundCamera();
+        return;
+    }
+    // the record hook leaves the pose alone in these modes, so the replay must leave the pass alone too
+    if (GameState::UseBlackBarsDuringEvents() || GameState::UseFlatCameraPresentation() || GameState::UseMonoFrameBufferTemporarilyDuringMenusOrPictures()) {
+        return;
+    }
+
+    BackgroundRecord record = {};
+    {
+        std::scoped_lock lock(s_backgroundRecordMutex);
+        if (!s_backgroundValid || GetTimeStamp() - s_backgroundRecord.recordedAtNs > kBackgroundRecordMaxAgeNs) {
+            s_backgroundValid = false;
+            return;
+        }
+        record = s_backgroundRecord;
+    }
+    if (ctx == 0) {
+        return;
+    }
+
+    BackgroundBlockLookup lookup;
+    const bool found = FindBackgroundBlock(ctx, record, lookup);
+
+    // the entry's one view-block line: a hit and an untouched pass can be told apart
+    if (!record.loggedViewProbe) {
+        bool logProbe = false;
+        {
+            std::scoped_lock lock(s_backgroundRecordMutex);
+            if (!s_backgroundRecord.loggedViewProbe) {
+                s_backgroundRecord.loggedViewProbe = true;
+                logProbe = true;
+            }
+        }
+        if (logProbe) {
+            if (found && lookup.blockMatches) {
+                Log::print<INFO>("[bgcam] view block {} matched at {:08X} (VFC {} views): its slot 0 already holds the background view; the pass's view is written for each eye",
+                    lookup.index, lookup.blockEntry, lookup.vfcCount);
+            }
+            else if (found && lookup.blockReadable) {
+                Log::print<INFO>("[bgcam] view block {} at {:08X} (VFC {} views): its slot 0 does not hold the background view yet; the pass's view is written for each eye",
+                    lookup.index, lookup.blockEntry, lookup.vfcCount);
+            }
+            else if (found) {
+                Log::print<INFO>("[bgcam] view block {} at {:08X} (VFC {} views): its slot 0 is unreadable; backdrop left unchanged",
+                    lookup.index, lookup.blockEntry, lookup.vfcCount);
+            }
+            else if (lookup.shaderCtx == 0 || lookup.shaderCtxField4 == 0) {
+                Log::print<INFO>("[bgcam] view block not found: no shader context (VFC {} views)", lookup.vfcCount);
+            }
+            else {
+                Log::print<INFO>("[bgcam] view block not found (VFC {} views, closest index {} differs by {:.3f}): backdrop left unchanged",
+                    lookup.vfcCount, lookup.closestIndex, lookup.closestDiff);
+            }
+        }
+    }
+
+    bool wrote = false;
+    if (found && lookup.blockReadable) {
+        const uint32_t sharedAddress = StereoView::GetSharedMemoryAddress();
+        if (sharedAddress != 0) {
+            const uint32_t sharedMemAddress = sharedAddress + offsetof(VRSharedMemoryRoot, shared);
+            VRSharedMemory sharedMem = {};
+            Guest::Read(sharedMemAddress, &sharedMem);
+
+            BEMatrix34 mainView;
+            BEMatrix44 mainProj;
+            float mainNear = 0.0f;
+            float mainFar = 0.0f;
+            float mainFovy = 0.0f;
+            float mainAspect = 0.0f;
+            float mainStuff5 = 0.0f;
+            GetEyeShared(sharedMem, left, mainView, mainProj, mainNear, mainFar, mainFovy, mainAspect, mainStuff5);
+
+            // the eye's own horizontal and vertical projection, the background projection's depth range
+            BEMatrix44 backgroundProj = mainProj;
+            backgroundProj.a22 = record.projA22;
+            backgroundProj.a23 = record.projA23;
+            backgroundProj.a32 = record.projA32;
+            backgroundProj.a33 = record.projA33;
+
+            const float proj11 = backgroundProj.a11.getLE();
+            const float proj00 = backgroundProj.a00.getLE();
+            const float stuff5 = proj11 != 0.0f ? 1.0f / proj11 : mainStuff5;
+            const float aspect = proj00 != 0.0f && proj11 != 0.0f ? proj11 / proj00 : mainAspect;
+
+            s_backgroundGpuViewState.prepared = true;
+            s_backgroundGpuViewState.left = left;
+            s_backgroundGpuViewState.sharedMemAddress = sharedMemAddress;
+            s_backgroundGpuViewState.shaderCtx = lookup.shaderCtx;
+            s_backgroundGpuViewState.shaderCtxField4 = lookup.shaderCtxField4;
+            s_backgroundGpuViewState.mainView = mainView;
+            s_backgroundGpuViewState.mainProj = mainProj;
+            s_backgroundGpuViewState.mainNear = mainNear;
+            s_backgroundGpuViewState.mainFar = mainFar;
+            s_backgroundGpuViewState.mainFovy = mainFovy;
+            s_backgroundGpuViewState.mainAspect = mainAspect;
+            s_backgroundGpuViewState.mainStuff5 = mainStuff5;
+
+            SetEyeShared(sharedMem, left, record.view, backgroundProj, record.nearZ, record.farZ, mainFovy, aspect, stuff5);
+            Guest::Write(sharedMemAddress, &sharedMem);
+            WriteGuestU32(lookup.shaderCtx + 4, lookup.blockEntry);
+            wrote = true;
+        }
+    }
+
+    LogBackgroundSummary(left, wrote, lookup.index);
+    if (wrote) {
+        hCPU->gpr[3] = 1;
+    }
+}
+
+static void hook_RestoreBackgroundGpuView(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    if (!s_backgroundGpuViewState.prepared) {
+        return;
+    }
+
+    VRSharedMemory sharedMem = {};
+    Guest::Read(s_backgroundGpuViewState.sharedMemAddress, &sharedMem);
+    SetEyeShared(sharedMem, s_backgroundGpuViewState.left, s_backgroundGpuViewState.mainView, s_backgroundGpuViewState.mainProj,
+        s_backgroundGpuViewState.mainNear, s_backgroundGpuViewState.mainFar, s_backgroundGpuViewState.mainFovy,
+        s_backgroundGpuViewState.mainAspect, s_backgroundGpuViewState.mainStuff5);
+    Guest::Write(s_backgroundGpuViewState.sharedMemAddress, &sharedMem);
+    WriteGuestU32(s_backgroundGpuViewState.shaderCtx + 4, s_backgroundGpuViewState.shaderCtxField4);
+    s_backgroundGpuViewState.prepared = false;
+}
