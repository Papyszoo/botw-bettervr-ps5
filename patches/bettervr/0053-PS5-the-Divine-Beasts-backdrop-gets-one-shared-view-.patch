+; ================================================================================
+; the Divine Beasts' background view block: hook_recalcGpuView writes the block the background pass reads, but it
+; also rewrites the frame's shadow and env uniforms and the per-eye previous-view cache, which belong to the main
+; camera. Keep those as they are and let only the view block write through.
+; ================================================================================
+.align 2
+bgZero:
+.float 0.0
+
+recalcBackgroundGpuView:
+mflr r0
+stwu r1, -0x220(r1)
+stw r0, 0x224(r1)
+stmw r30, 0x08(r1)
+stfd f31, 0x10(r1)
+mr r31, r3
+fmr f31, f1
+
+; keep the previous-view cache, 114 words for both eyes, and stop the recalc from writing its slots 11-14
+lis r3, _ab8a815a3d735ad3_ZL19s_previousViewSlots@ha
+addi r3, r3, _ab8a815a3d735ad3_ZL19s_previousViewSlots@l
+addi r4, r1, 0x30
+li r5, 114
+mtctr r5
+bgSavePrev:
+lwz r6, 0(r3)
+stw r6, 0(r4)
+addi r3, r3, 4
+addi r4, r4, 4
+bdnz bgSavePrev
+
+lis r3, _ab8a815a3d735ad3_ZL19s_previousViewSlots@ha
+addi r3, r3, _ab8a815a3d735ad3_ZL19s_previousViewSlots@l
+lis r12, bgZero@ha
+lfs f0, bgZero@l(r12)
+fcmpu cr0, f31, f0
+blt bgLeftEye
+addi r3, r3, 0xE4                        ; right eye's entry
+bgLeftEye:
+li r0, 0
+stw r0, 0(r3)                            ; valid = 0, so the background block keeps its recorded slots 11-14
+
+; the shadow and env lists write frame-wide uniforms: empty them for this call, then put them back
+lis r3, _ab8a815a3d735ad3_ZL16s_shadowMatCount@ha
+lwz r6, _ab8a815a3d735ad3_ZL16s_shadowMatCount@l(r3)
+stw r6, 0x20(r1)
+li r0, 0
+stw r0, _ab8a815a3d735ad3_ZL16s_shadowMatCount@l(r3)
+lis r3, _ab8a815a3d735ad3_ZL14s_envViewCount@ha
+lwz r6, _ab8a815a3d735ad3_ZL14s_envViewCount@l(r3)
+stw r6, 0x24(r1)
+stw r0, _ab8a815a3d735ad3_ZL14s_envViewCount@l(r3)
+
+; the recalc skips a camera at x = 0 or looking along z = 0, a guard for the default camera; the background
+; camera is a real one, so hide the layer from it for this call
+lwz r6, 0x208(r31)
+stw r6, 0x28(r1)
+stw r0, 0x208(r31)
+
+mr r3, r31
+fmr f1, f31
+bl hook_recalcGpuView
+
+lwz r6, 0x28(r1)
+stw r6, 0x208(r31)
+lis r3, _ab8a815a3d735ad3_ZL16s_shadowMatCount@ha
+lwz r6, 0x20(r1)
+stw r6, _ab8a815a3d735ad3_ZL16s_shadowMatCount@l(r3)
+lis r3, _ab8a815a3d735ad3_ZL14s_envViewCount@ha
+lwz r6, 0x24(r1)
+stw r6, _ab8a815a3d735ad3_ZL14s_envViewCount@l(r3)
+
+lis r3, _ab8a815a3d735ad3_ZL19s_previousViewSlots@ha
+addi r3, r3, _ab8a815a3d735ad3_ZL19s_previousViewSlots@l
+addi r4, r1, 0x30
+li r5, 114
+mtctr r5
+bgRestorePrev:
+lwz r6, 0(r4)
+stw r6, 0(r3)
+addi r3, r3, 4
+addi r4, r4, 4
+bdnz bgRestorePrev
+
+lfd f31, 0x10(r1)
+lmw r30, 0x08(r1)
+lwz r0, 0x224(r1)
+addi r1, r1, 0x220
+mtlr r0
+blr
