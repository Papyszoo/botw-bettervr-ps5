 }
 
+// the Divine Beasts draw the outside world with a background camera of their own; the wrapper at 0x02C43450 runs
+// after the game has set that camera's projection. It keeps the camera's own position (the outside world is a
+// different, scaled world, away from Link), takes the gameplay yaw composed with the head's middle rotation, and
+// gives the record's culling the combined eye FOV. The replay writes one shared view and each eye's projection into
+// the background pass's own view block (see hook_PrepareBackgroundGpuView).
+static void hook_ModifyProjectionUsingCamera(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+
+    // a loading screen is a map change: a record from before it belongs to the map that is going away
+    if (Screens::IsLoadingVisible()) {
+        ClearBackgroundCamera();
+        return;
+    }
+
+    if (GameState::UseBlackBarsDuringEvents() || GameState::UseFlatCameraPresentation() || GameState::UseMonoFrameBufferTemporarilyDuringMenusOrPictures()) {
+        return;
+    }
+
+    const uint32_t cameraPtr = hCPU->gpr[7];
+    const uint32_t projectionPtr = hCPU->gpr[4];
+    const uint32_t returnAddress = hCPU->gpr[6];
+    if (cameraPtr == 0 || projectionPtr == 0 || !Tracking::IsSessionRunning()) {
+        return;
+    }
+
+    const std::optional<Tracking::HeadViews> views = Tracking::Views();
+    if (!views.has_value()) {
+        return;
+    }
+
+    BESeadLookAtCamera camera = {};
+    Guest::Read(cameraPtr, &camera);
+
+    const glm::mat4 worldGame = glm::inverse(glm::mat4(camera.mtx.getLEMatrix()));
+    const glm::fvec3 basePos = glm::vec3(worldGame[3]);
+    auto [gameplayPos, gameplayRot] = Camera::ResolveGameplayBasePose(camera);
+    (void)gameplayPos;
+
+    // only the rotation is taken from the head; BuildMiddlePose's position is the gameplay anchor and is not used
+    auto [middlePos, middleRot] = Camera::BuildMiddlePose(views, basePos, gameplayRot);
+    (void)middlePos;
+    SetCameraWorld(camera, glm::translate(glm::identity<glm::fmat4>(), basePos) * glm::mat4_cast(middleRot));
+    Guest::Write(cameraPtr, &camera);
+
+    BESeadPerspectiveProjection perspectiveProjection = {};
+    Guest::Read(projectionPtr, &perspectiveProjection);
+    const std::optional<XrFovf> combinedFov = TryGetCombinedFOV(views);
+    if (combinedFov.has_value()) {
+        // the record's culling and its one draw use one projection; the combined eye FOV covers both eyes
+        ApplyProjectionFov(perspectiveProjection, combinedFov.value());
+        Guest::Write(projectionPtr, &perspectiveProjection);
+    }
+
+    BackgroundRecord record = {};
+    record.cameraPtr = cameraPtr;
+    record.projectionPtr = projectionPtr;
+    record.recordedAtNs = GetTimeStamp();
+    record.view = camera.mtx;
+    record.projA22 = perspectiveProjection.matrix.a22.getLE();
+    record.projA23 = perspectiveProjection.matrix.a23.getLE();
+    record.projA32 = perspectiveProjection.matrix.a32.getLE();
+    record.projA33 = perspectiveProjection.matrix.a33.getLE();
+    record.nearZ = perspectiveProjection.zNear.getLE();
+    record.farZ = perspectiveProjection.zFar.getLE();
+
+    bool logEntry = false;
+    {
+        std::scoped_lock lock(s_backgroundRecordMutex);
+        logEntry = s_backgroundRecord.loggedCameraPtr != cameraPtr;
+        if (logEntry) {
+            record.loggedCameraPtr = cameraPtr;
+            record.loggedViewProbe = false;
+            record.loggedShadowProbe = false;
+        }
+        else {
+            record.loggedCameraPtr = s_backgroundRecord.loggedCameraPtr;
+            record.loggedViewProbe = s_backgroundRecord.loggedViewProbe;
+            record.loggedShadowProbe = s_backgroundRecord.loggedShadowProbe;
+        }
+        s_backgroundRecord = record;
+        s_backgroundValid = true;
+    }
+
+    // one line per Beast entry, including a return to the same Beast: the loading screen reset the marker above
+    if (logEntry) {
+        Log::print<INFO>("[bgcam] entry: camera {:08X} projection {:08X} lr {:08X} near {:.3f} far {:.0f} fov {:.1f}deg basePos ({:.1f}, {:.1f}, {:.1f}) yaw {:.1f}deg",
+            cameraPtr, projectionPtr, returnAddress, record.nearZ, record.farZ,
+            glm::degrees(perspectiveProjection.fovYRadiansOrAngle.getLE()),
+            basePos.x, basePos.y, basePos.z, glm::degrees(glm::eulerAngles(middleRot).y));
+    }
+}
+
+struct BackgroundBlockLookup {
+    bool found = false;
+    bool viewFound = false;
+    bool blockReadable = false;
+    bool blockMatches = false;
+    uint32_t index = 0;
+    uint32_t blockEntry = 0;
+    uint32_t shaderCtx = 0;
+    uint32_t shaderCtxField4 = 0;
+    uint32_t vfcCount = 0;
+    uint32_t closestIndex = 0;
+    float closestDiff = 0.0f;
+};
+
+// the model scene's view array holds the background camera's view; the per-view uniform blocks are 48 bytes apart
+// and the block is at +4 of its entry (the layout hook_recalcGpuView and the shadow capture already use)
+static bool FindBackgroundBlock(uint32_t ctx, const BackgroundRecord& record, BackgroundBlockLookup& lookup) {
+    const uint32_t shaderCtx = ReadGuestU32(ctx + 0x1A8);
+    const uint32_t field4 = shaderCtx == 0 ? 0 : ReadGuestU32(shaderCtx + 4);
+    lookup.shaderCtx = shaderCtx;
+    lookup.shaderCtxField4 = field4;
+    if (shaderCtx == 0 || field4 == 0) {
+        return false;
+    }
+
+    const uint32_t vfcArray = ReadGuestU32(ctx + 0x0C);
+    const uint32_t vfcCount = ReadGuestU32(ctx + 0x08);
+    lookup.vfcCount = vfcCount;
+    if (vfcArray == 0 || vfcCount == 0) {
+        return false;
+    }
+
+    const float viewFloats[12] = {
+        record.view.x_x.getLE(), record.view.y_x.getLE(), record.view.z_x.getLE(), record.view.pos_x.getLE(),
+        record.view.x_y.getLE(), record.view.y_y.getLE(), record.view.z_y.getLE(), record.view.pos_y.getLE(),
+        record.view.x_z.getLE(), record.view.y_z.getLE(), record.view.z_z.getLE(), record.view.pos_z.getLE(),
+    };
+
+    // view 0 is the main camera and views 3 to 6 are the shadow cascades; neither is the background camera
+    const uint32_t scanCount = vfcCount < 32 ? vfcCount : 32;
+    lookup.closestDiff = 1.0e30f;
+    bool viewFound = false;
+    for (uint32_t i = 1; i < scanCount && !viewFound; i++) {
+        if (i >= 3 && i <= 6) continue;
+        for (uint32_t row = 0; row < 2 && !viewFound; row++) {
+            float worst = 0.0f;
+            for (uint32_t k = 0; k < 12; k++) {
+                float difference = ReadGuestFloat(vfcArray + i * 0x31C + row * 0x60 + k * 4) - viewFloats[k];
+                if (difference < 0.0f) difference = -difference;
+                if (difference > worst) worst = difference;
+            }
+            if (worst < lookup.closestDiff) {
+                lookup.closestDiff = worst;
+                lookup.closestIndex = i;
+            }
+            if (worst <= 0.001f) {
+                lookup.index = i;
+                viewFound = true;
+            }
+        }
+    }
+
+    auto blockHoldsView = [&](uint32_t index, uint32_t& entry) {
+        entry = field4 + index * 48;
+        float blockView[12];
+        if (!ReadUniformBlockView(entry + 4, blockView)) {
+            return false;
+        }
+        for (uint32_t k = 0; k < 12; k++) {
+            float difference = blockView[k] - viewFloats[k];
+            if (difference < 0.0f) difference = -difference;
+            if (difference > 0.001f) {
+                return false;
+            }
+        }
+        return true;
+    };
+
+    lookup.viewFound = viewFound;
+
+    // the view array names the background view; its own block is the one to rewrite even when it still holds the
+    // main camera's view, which is the state this fix exists to replace. Entry 0 is the main camera's block and is
+    // never the background's, whatever a stale record says.
+    if (viewFound) {
+        lookup.blockEntry = field4 + lookup.index * 48;
+        float blockView[12];
+        lookup.blockReadable = ReadUniformBlockView(lookup.blockEntry + 4, blockView);
+        if (lookup.blockReadable) {
+            lookup.blockMatches = true;
+            for (uint32_t k = 0; k < 12; k++) {
+                float difference = blockView[k] - viewFloats[k];
+                if (difference < 0.0f) difference = -difference;
+                if (difference > 0.001f) {
+                    lookup.blockMatches = false;
+                    break;
+                }
+            }
+        }
+        lookup.found = true;
+        return true;
+    }
+
+    // the view index and the block index need not be the same: find the block by the view it holds
+    for (uint32_t i = 1; i < scanCount; i++) {
+        if (i >= 3 && i <= 6) continue;
+        uint32_t entry = 0;
+        if (blockHoldsView(i, entry)) {
+            lookup.index = i;
+            lookup.blockEntry = entry;
+            lookup.blockReadable = true;
+            lookup.blockMatches = true;
+            lookup.found = true;
+            return true;
+        }
+    }
+    return false;
+}
