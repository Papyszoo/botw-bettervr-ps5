diff --git a/src/game/botw/camera/stereo_view.cpp b/src/game/botw/camera/stereo_view.cpp
index ff781cc..69306bb 100644
--- a/src/game/botw/camera/stereo_view.cpp
+++ b/src/game/botw/camera/stereo_view.cpp
@@ -17,6 +17,204 @@ static std::atomic<float> s_flatCameraFovYRadians = glm::radians(90.0f);
 static std::mutex s_gameCameraMutex;
 static std::optional<glm::mat4> s_gameCameraWorld;
 
+// the Divine Beasts draw the outside world with a background camera of their own, away from the dungeon and Link.
+// The record hook keeps that camera's own position, composes the gameplay yaw with the head's middle rotation and
+// leaves the orientation here with the background projection's depth rows; the replay writes them into the
+// background pass's per-view block once for each eye, so both eyes share one viewpoint and differ only in projection.
+struct BackgroundRecord {
+    uint32_t cameraPtr = 0;
+    uint32_t projectionPtr = 0;
+    uint32_t loggedCameraPtr = 0;
+    bool loggedViewProbe = false;
+    bool loggedShadowProbe = false;
+    uint64_t recordedAtNs = 0;
+    BEMatrix34 view = {};
+    float projA22 = 0.0f;
+    float projA23 = 0.0f;
+    float projA32 = 0.0f;
+    float projA33 = 0.0f;
+    float nearZ = 0.0f;
+    float farZ = 0.0f;
+};
+
+static BackgroundRecord s_backgroundRecord;
+static std::mutex s_backgroundRecordMutex;
+static bool s_backgroundValid = false;
+
+// a record older than this is not from the frame being drawn (a stage change that skipped the loading screen)
+static constexpr uint64_t kBackgroundRecordMaxAgeNs = 1'000'000'000;
+// the summary line, at most one per five seconds while a Beast's background is drawn
+static constexpr uint64_t kBackgroundSummaryIntervalNs = 5'000'000'000;
+static uint64_t s_backgroundLastSummaryNs = 0;
+static uint32_t s_backgroundLastBlockIndex = 0;
+static uint32_t s_backgroundLeftPrepares = 0;
+static uint32_t s_backgroundLeftWrites = 0;
+static uint32_t s_backgroundRightPrepares = 0;
+static uint32_t s_backgroundRightWrites = 0;
+
+// one display list's prepared write, consumed by hook_RestoreBackgroundGpuView
+struct BackgroundGpuViewState {
+    bool prepared = false;
+    bool left = false;
+    uint32_t sharedMemAddress = 0;
+    uint32_t shaderCtx = 0;
+    uint32_t shaderCtxField4 = 0;
+    BEMatrix34 mainView = {};
+    BEMatrix44 mainProj = {};
+    float mainNear = 0.0f;
+    float mainFar = 0.0f;
+    float mainFovy = 0.0f;
+    float mainAspect = 0.0f;
+    float mainStuff5 = 0.0f;
+};
+
+static BackgroundGpuViewState s_backgroundGpuViewState;
+
+static uint32_t ReadGuestU32(uint32_t address) {
+    BEType<uint32_t> value;
+    Guest::Read(address, &value);
+    return value.getLE();
+}
+
+static uint16_t ReadGuestU16(uint32_t address) {
+    BEType<uint16_t> value;
+    Guest::Read(address, &value);
+    return value.getLE();
+}
+
+static uint8_t ReadGuestU8(uint32_t address) {
+    BEType<uint8_t> value;
+    Guest::Read(address, &value);
+    return value.getLE();
+}
+
+static float ReadGuestFloat(uint32_t address) {
+    BEType<float> value;
+    Guest::Read(address, &value);
+    return value.getLE();
+}
+
+static void WriteGuestU32(uint32_t address, uint32_t value) {
+    BEType<uint32_t> beValue(value);
+    Guest::Write(address, &beValue);
+}
+
+// the view at slot 0 of an agl::UniformBlock, when the block and its slot are readable and the slot is a mat3x4
+// (the game's resolveSlot: block -> descriptor table -> slot offset and type, rows four words wide)
+static bool ReadUniformBlockView(uint32_t uniformBlock, float out[12]) {
+    if (uniformBlock < 0x04000000 || uniformBlock >= 0x50000000) return false;
+    const uint32_t descriptorPtr = ReadGuestU32(uniformBlock);
+    if (descriptorPtr < 0x04000000 || descriptorPtr >= 0x50000000) return false;
+    const uint32_t descriptorTable = ReadGuestU32(descriptorPtr);
+    if (descriptorTable < 0x04000000 || descriptorTable >= 0x50000000) return false;
+    const uint16_t descriptorOffset = ReadGuestU16(descriptorTable + 4);
+    const uint8_t typeIndex = ReadGuestU8(descriptorTable + 8);
+    if (ReadGuestU8(0x10362A70 + typeIndex * 4) != 4) return false;
+    const uint32_t bufferBase = ReadGuestU32(uniformBlock + 4);
+    if (bufferBase < 0x04000000 || bufferBase >= 0x50000000) return false;
+    const uint32_t dstVA = bufferBase + descriptorOffset;
+    for (uint32_t i = 0; i < 12; i++) {
+        out[i] = ReadGuestFloat(dstVA + i * 4);
+    }
+    return true;
+}
+
+// the background camera has stopped being used (a map change): forget the record and the once-per-entry markers, so
+// the next Beast entry logs its entry and view-block lines again
+static void ClearBackgroundCamera() {
+    std::scoped_lock lock(s_backgroundRecordMutex);
+    s_backgroundValid = false;
+    s_backgroundRecord = BackgroundRecord{};
+    s_backgroundLastSummaryNs = 0;
+    s_backgroundLastBlockIndex = 0;
+    s_backgroundLeftPrepares = s_backgroundLeftWrites = 0;
+    s_backgroundRightPrepares = s_backgroundRightWrites = 0;
+}
+
+// the background GPU setup writes the shadow slot through the same shader context the frame's view blocks hang off.
+// Log that context's slot 0 once per entry: it says whether the background camera reaches that block, which is the
+// one thing the replay's view-array scan cannot show from the code alone. Called from the wrapper at 0x39DF234.
+static void hook_ProbeBackgroundShadowContext(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+
+    const uint32_t shaderCtx = hCPU->gpr[3];
+    if (shaderCtx == 0) {
+        return;
+    }
+
+    std::scoped_lock lock(s_backgroundRecordMutex);
+    if (!s_backgroundValid || s_backgroundRecord.loggedShadowProbe) {
+        return;
+    }
+    s_backgroundRecord.loggedShadowProbe = true;
+
+    const uint32_t field4 = ReadGuestU32(shaderCtx + 4);
+    float blockView[12];
+    if (field4 == 0 || !ReadUniformBlockView(field4 + 4, blockView)) {
+        Log::print<INFO>("[bgcam] shadow context {:08X}: block slot 0 unreadable", shaderCtx);
+        return;
+    }
+
+    const BEMatrix34& view = s_backgroundRecord.view;
+    const float backgroundView[12] = {
+        view.x_x.getLE(), view.y_x.getLE(), view.z_x.getLE(), view.pos_x.getLE(),
+        view.x_y.getLE(), view.y_y.getLE(), view.z_y.getLE(), view.pos_y.getLE(),
+        view.x_z.getLE(), view.y_z.getLE(), view.z_z.getLE(), view.pos_z.getLE(),
+    };
+    float worst = 0.0f;
+    for (uint32_t k = 0; k < 12; k++) {
+        float difference = blockView[k] - backgroundView[k];
+        if (difference < 0.0f) difference = -difference;
+        if (difference > worst) worst = difference;
+    }
+
+    Log::print<INFO>("[bgcam] shadow context {:08X}: block slot 0 pos ({:.1f}, {:.1f}, {:.1f}), background pos ({:.1f}, {:.1f}, {:.1f}), match {}",
+        shaderCtx, blockView[3], blockView[7], blockView[11], backgroundView[3], backgroundView[7], backgroundView[11],
+        worst <= 0.001f ? "yes" : "no");
+}
+
+static void GetEyeShared(VRSharedMemory& sharedMem, bool left, BEMatrix34& view, BEMatrix44& proj, float& nearZ, float& farZ, float& fovy, float& aspect, float& stuff5) {
+    if (left) {
+        view = sharedMem.leftView;
+        proj = sharedMem.leftProj;
+        nearZ = sharedMem.leftNear.getLE();
+        farZ = sharedMem.leftFar.getLE();
+        fovy = sharedMem.leftFovy.getLE();
+        aspect = sharedMem.leftAspect.getLE();
+        stuff5 = sharedMem.leftStuff5.getLE();
+    }
+    else {
+        view = sharedMem.rightView;
+        proj = sharedMem.rightProj;
+        nearZ = sharedMem.rightNear.getLE();
+        farZ = sharedMem.rightFar.getLE();
+        fovy = sharedMem.rightFovy.getLE();
+        aspect = sharedMem.rightAspect.getLE();
+        stuff5 = sharedMem.rightStuff5.getLE();
+    }
+}
+
+static void SetEyeShared(VRSharedMemory& sharedMem, bool left, const BEMatrix34& view, const BEMatrix44& proj, float nearZ, float farZ, float fovy, float aspect, float stuff5) {
+    if (left) {
+        sharedMem.leftView = view;
+        sharedMem.leftProj = proj;
+        sharedMem.leftNear = nearZ;
+        sharedMem.leftFar = farZ;
+        sharedMem.leftFovy = fovy;
+        sharedMem.leftAspect = aspect;
+        sharedMem.leftStuff5 = stuff5;
+    }
+    else {
+        sharedMem.rightView = view;
+        sharedMem.rightProj = proj;
+        sharedMem.rightNear = nearZ;
+        sharedMem.rightFar = farZ;
+        sharedMem.rightFovy = fovy;
+        sharedMem.rightAspect = aspect;
+        sharedMem.rightStuff5 = stuff5;
+    }
+}
+
