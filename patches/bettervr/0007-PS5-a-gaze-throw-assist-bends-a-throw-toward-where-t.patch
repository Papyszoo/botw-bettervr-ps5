--- a/src/game/botw/input/controls.cpp
+++ b/src/game/botw/input/controls.cpp
@@ -791,6 +791,54 @@ static void ProcessLeftTriggerBindings(
     }    
 }
 
+// A throw is bent toward where the player looks, by at most kGazeThrowMaxBend degrees, keeping the
+// hand's speed. Without an eye-gaze sample the head's forward direction is the target, so the
+// assist still works with eye tracking off, just less precisely. Returns the velocity unchanged
+// when there is no head pose or the wanted direction cannot be formed.
+static bool NormalizeDirection(const glm::fvec3& direction, glm::fvec3& outDirection) {
+    if (!glm::all(glm::isfinite(direction)) || glm::dot(direction, direction) <= 1.0e-6f)
+        return false;
+    outDirection = glm::normalize(direction);
+    return true;
+}
+
+static glm::fvec3 ApplyGazeThrowAssist(const glm::fvec3& velocity, const OpenXR::InputState& inputs) {
+    constexpr float targetDistance = 10.0f;
+    constexpr float maxBendDegrees = 15.0f;
+
+    if (!glm::all(glm::isfinite(velocity)) || glm::dot(velocity, velocity) <= 1.0e-6f)
+        return velocity;
+    const std::optional<glm::fmat4> head = Tracking::HeadPose();
+    if (!head.has_value())
+        return velocity;
+
+    const glm::fmat4 reference = Camera::GetReferenceMtx();
+    glm::fvec3 directionStage;
+    const char* source = "head";
+    const std::optional<glm::fvec3> gaze = Tracking::EyeGaze();
+    if (gaze.has_value() && NormalizeDirection(*gaze, directionStage))
+        source = "gaze";
+    else if (!NormalizeDirection(glm::mat3(*head) * glm::fvec3(0.0f, 0.0f, -1.0f), directionStage))
+        return velocity;
+
+    const glm::fvec3 headWorld = glm::vec3(reference * glm::fvec4(glm::fvec3((*head)[3]), 1.0f));
+    const glm::fvec3 target = headWorld + glm::normalize(glm::mat3(reference) * directionStage) * targetDistance;
+    const glm::fvec3 handWorld = glm::vec3(reference * glm::fvec4(ToGLM(inputs.shared.poseLocation[OpenXR::EyeSide::RIGHT].pose.position), 1.0f));
+    glm::fvec3 wanted;
+    if (!NormalizeDirection(target - handWorld, wanted))
+        return velocity;
+
+    const glm::fvec3 current = glm::normalize(velocity);
+    const float angle = std::acos(std::clamp(glm::dot(current, wanted), -1.0f, 1.0f));
+    if (angle < glm::radians(0.5f))
+        return velocity;
+    const float bend = std::min(angle, glm::radians(maxBendDegrees));
+    const glm::fvec3 axis = glm::cross(current, wanted);
+    const glm::fvec3 assisted = glm::dot(axis, axis) > 1.0e-8f ? glm::angleAxis(bend, glm::normalize(axis)) * current : current;
+    Log::print<INFO>("[Throw] gaze assist bent {:.1f} degrees toward the {}", glm::degrees(bend), source);
+    return assisted * glm::length(velocity);
+}
+
 // the trigger or grip throws, but one that was already held when picking something up (like a bomb) has to be pressed again
 static void ProcessHandThrow(uint32_t& buttonHold, const OpenXR::InputState& inputs, ControlState& state) {
     constexpr XrDuration releaseVelocityWindowNs = 100'000'000;
@@ -847,7 +895,10 @@ static void ProcessHandThrow(uint32_t& buttonHold, const OpenXR::InputState& inp
     if (releaseVelocity.has_value()) {
         const float handSpeed = glm::length(releaseVelocity.value());
         const float boost = glm::mix(1.0f, maxThrowBoost, glm::smoothstep(boostStartSpeed, boostFullSpeed, handSpeed));
-        Player::RequestHandThrow(glm::mat3(Camera::GetReferenceMtx()) * releaseVelocity.value() * boost);
+        glm::fvec3 throwVelocity = glm::mat3(Camera::GetReferenceMtx()) * releaseVelocity.value() * boost;
+        if (GetSettings().eyeGazeThrowAssist)
+            throwVelocity = ApplyGazeThrowAssist(throwVelocity, inputs);
+        Player::RequestHandThrow(throwVelocity);
         Log::print<CONTROLS>("[Throw] released with hand speed {:.2f}, boosted {:.2f}x", handSpeed, boost);
     }
     else {
