@@ -14,7 +22,10 @@ namespace platform {
 
     // Handle to the current process's own module / global symbol table.
     inline ModuleHandle OpenSelfModule() {
-#ifdef _WIN32
+#if defined(__PROSPERO__)
+        static int self;
+        return &self;
+#elif defined(_WIN32)
         return GetModuleHandleA(NULL);
 #else
         return dlopen(NULL, RTLD_LAZY);
@@ -23,7 +34,13 @@ namespace platform {
 
     // Resolve an exported symbol by name; returns nullptr if not found.
     inline void* GetModuleSymbol(ModuleHandle module, const char* name) {
-#ifdef _WIN32
+#if defined(__PROSPERO__)
+        (void)module;
+        if (std::strcmp(name, "gameMeta_getTitleId") == 0) return reinterpret_cast<void*>(&gameMeta_getTitleId);
+        if (std::strcmp(name, "memory_getBase") == 0) return reinterpret_cast<void*>(&memory_getBase);
+        if (std::strcmp(name, "osLib_registerHLEFunction") == 0) return reinterpret_cast<void*>(&osLib_registerHLEFunction);
+        return nullptr;
+#elif defined(_WIN32)
         return reinterpret_cast<void*>(GetProcAddress(module, name));
 #else
         return dlsym(module, name);
@@ -32,7 +49,9 @@ namespace platform {
 
     inline void CloseModule(ModuleHandle module) {
         if (!module) return;
-#ifdef _WIN32
+#if defined(__PROSPERO__)
+        (void)module;
+#elif defined(_WIN32)
         FreeLibrary(module);
 #else
         dlclose(module);
