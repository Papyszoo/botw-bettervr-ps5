diff --git a/src/utils/mod_settings.h b/src/utils/mod_settings.h
index 067ae5d..82e210e 100644
--- a/src/utils/mod_settings.h
+++ b/src/utils/mod_settings.h
@@ -1,4 +1,6 @@
 #pragma once
+#include <cerrno>
+#include <cstdlib>
 
 class ModSettingBase;
 
@@ -134,7 +136,30 @@ public:
             valueString.remove_prefix(1);
         }
         T parsed{};
+#if defined(__PROSPERO__) && defined(_LIBCPP_VERSION)
+        // the PS5 SDK's libc++ 18 has no floating-point std::from_chars: strtod, with its errors as from_chars gives them
+        std::errc ec{};
+        if constexpr (std::floating_point<T>) {
+            const std::string text(valueString);
+            char* end = nullptr;
+            errno = 0;
+            const double value = std::strtod(text.c_str(), &end);
+            if (end == text.c_str() || *end != '\0') {
+                ec = std::errc::invalid_argument;
+            }
+            else if (errno == ERANGE || value > (double)std::numeric_limits<T>::max() || value < (double)std::numeric_limits<T>::lowest()) {
+                ec = std::errc::result_out_of_range;
+            }
+            else {
+                parsed = (T)value;
+            }
+        }
+        else {
+            ec = std::from_chars(valueString.data(), valueString.data() + valueString.size(), parsed).ec;
+        }
+#else
         const auto [parseEnd, ec] = std::from_chars(valueString.data(), valueString.data() + valueString.size(), parsed);
+#endif
         if (ec == std::errc::result_out_of_range) {
             parsed = valueString.starts_with('-') ? std::numeric_limits<T>::lowest() : std::numeric_limits<T>::max();
         }
