+// The Linux backend left EndSession to renderer.cpp, which is Windows-only (a shared library links
+// without it). Its threads are stopped first, as the destructor does.
+void RND_Renderer::EndSession() {
+    if (m_session == XR_NULL_HANDLE) {
+        return;
+    }
+    s_linux.reset();
+    if (XrResult result = xrEndSession(m_session); XR_FAILED(result)) {
+        Log::print<ERROR>("Failed to end OpenXR session (result {})!", (int)result);
+    }
+}
