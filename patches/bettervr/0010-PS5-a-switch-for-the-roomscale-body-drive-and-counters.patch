     }
 
+    if (actorName == "GameROMPlayer" && hCPU->gpr[3] != 1 && side < 2) {
+        g_diagPlayerJobRuns[DiagPlayerJobIndex(jobNameStr)][side]++;
+    }
+
     if (hCPU->gpr[3] == 0) {
