+// PS5 diagnostics (controls.cpp [diag]): how often the player's actor jobs ran, per job and eye pass, and how often
+// each pass ended (hook_EndCameraSide): one of each per game frame if the stereo frame is as upstream's
+uint32_t g_diagPlayerJobRuns[8][2] = {};
+uint32_t g_diagEndCameraSide[2] = {};
+static int DiagPlayerJobIndex(const std::string& job) {
+    static const char* const names[8] = { "job0_1", "job0_2", "job1_1", "job1_2", "job2_1_ragdoll_related", "job2_2", "job4", "" };
+    for (int i = 0; i < 7; i++)
+        if (job == names[i])
+            return i;
+    return 7;
+}
