From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 12:00:00 +0100
Subject: [PATCH] PS5: Options toggles the menu from the action's own edges,
 with [menu] logs

Build26 logged nothing on Options presses. ButtonState's ShortPress needs a release within 250 ms; a longer
press counts as a long press, which the PS5 build ignores, so an ordinary press may never have toggled. The toggle now takes the mod menu
action's own down and up edges (a press released within a second toggles, a hold does nothing) and logs
[menu] switch, [menu] Options down/up, [menu] toggle and whether the action is active.

---
 src/hooking/controls.cpp          | 38 +++++++++++++++++++++++--------
 src/hooking/entity_controller.cpp |  6 ++++-
 2 files changed, 34 insertions(+), 10 deletions(-)

diff --git a/src/hooking/controls.cpp b/src/hooking/controls.cpp
index 886de1d..190d800 100644
--- a/src/hooking/controls.cpp
+++ b/src/hooking/controls.cpp
@@ -916,15 +916,35 @@ void processModMenuInput(std::atomic_bool& isMenuOpen, OpenXR::InputState& input
 #endif
 
 #ifndef _WIN32
-    // PS5: Options on the right Sense is bound to the mod menu action (controller_bindings.h); a short press opens
-    // and closes the menu when bettervr.json's "menu" is on. The input state is a copy of the last XR sync, so a
-    // press is taken once, by the sync's time.
-    static XrTime s_lastToggleInputTime = 0;
-    if (BetterVR_PS5_Menu() && inputs.shared.modMenuState.lastEvent == ButtonState::Event::ShortPress && inputs.shared.inputTime != s_lastToggleInputTime) {
-        s_lastToggleInputTime = inputs.shared.inputTime;
-        auto* renderer = VRManager::instance().XR->GetRenderer();
-        if (renderer && !renderer->m_menuInitFailed)
-            isMenuOpen = !isMenuOpen;
+    // PS5: Options on the right Sense is bound to the mod menu action (controller_bindings.h). When bettervr.json's
+    // "menu" is on, a short press (released within a second; a hold does nothing) opens and closes the menu. The edges
+    // are taken here from the action's state, not from ButtonState, whose 250 ms long-press limit is shorter than an
+    // ordinary press.
+    if (BetterVR_PS5_Menu()) {
+        static bool s_wasDown = false, s_activeLogged = false, s_lastActive = false;
+        static int s_activeLines = 0;
+        static std::chrono::steady_clock::time_point s_downAt;
+        const bool active = inputs.shared.modMenu.isActive == XR_TRUE;
+        if ((!s_activeLogged || active != s_lastActive) && s_activeLines++ < 12) {
+            s_activeLogged = true;
+            s_lastActive = active;
+            Log::print<INFO>("[menu] mod menu action is {} ({})", active ? "active" : "not active", inputs.shared.in_game ? "in game" : "in the game's menu");
+        }
+        const bool down = active && inputs.shared.modMenu.currentState == XR_TRUE;
+        if (down && !s_wasDown) {
+            s_downAt = std::chrono::steady_clock::now();
+            Log::print<INFO>("[menu] Options down");
+        }
+        else if (!down && s_wasDown) {
+            const auto heldMs = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - s_downAt).count();
+            Log::print<INFO>("[menu] Options up after {} ms", (long long)heldMs);
+            auto* renderer = VRManager::instance().XR->GetRenderer();
+            if (heldMs < 1000 && renderer && !renderer->m_menuInitFailed) {
+                isMenuOpen = !isMenuOpen;
+                Log::print<INFO>("[menu] toggle -> {}", isMenuOpen.load() ? "open" : "closed");
+            }
+        }
+        s_wasDown = down;
     }
 #endif
 
diff --git a/src/hooking/entity_controller.cpp b/src/hooking/entity_controller.cpp
index df8a7dd..d9d2655 100644
--- a/src/hooking/entity_controller.cpp
+++ b/src/hooking/entity_controller.cpp
@@ -760,7 +760,11 @@ extern "C" bool BetterVR_PS5_PoseFreeze() {
 // PS5: bettervr.json's menu (default 0 = off), cached once. On, Options on the right Sense opens the BetterVR menu
 // (stage A: a small panel); off, nothing of it runs: no overlay, no toggle, the mod menu stays shut.
 extern "C" bool BetterVR_PS5_Menu() {
-    static const bool s_menu = BetterVR_PS5_Setting("menu", 0.0f) >= 0.5f;
+    static const bool s_menu = [] {
+        const bool on = BetterVR_PS5_Setting("menu", 0.0f) >= 0.5f;
+        Log::print<INFO>("[menu] switch: {} (bettervr.json's menu)", on ? "on" : "off");
+        return on;
+    }();
     return s_menu;
 }
 
