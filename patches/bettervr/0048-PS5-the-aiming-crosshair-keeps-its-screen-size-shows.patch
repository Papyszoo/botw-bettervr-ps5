diff --git a/src/game/botw/player/bow.cpp b/src/game/botw/player/bow.cpp
index 8df50c1..b030921 100644
--- a/src/game/botw/player/bow.cpp
+++ b/src/game/botw/player/bow.cpp
@@ -1370,14 +1370,35 @@ static uint32_t ScaleColorAlpha(uint32_t color, float scale) {
     return (color & 0x00FFFFFF) | ((uint32_t)a << 24);
 }
 
+// the aiming crosshair's presets; yellow is the one upstream drew, and the alpha is the crosshair's own, so the
+// Opacity row is its final on-screen alpha
+static uint32_t AimingDotPresetColor(AimingDotColor preset) {
+    switch (preset) {
+        case AimingDotColor::WHITE: return DebugDrawColor(255, 255, 255);
+        case AimingDotColor::RED: return DebugDrawColor(255, 52, 36);
+        case AimingDotColor::GREEN: return DebugDrawColor(64, 255, 96);
+        case AimingDotColor::YELLOW: return DebugDrawColor(255, 214, 64);
+        case AimingDotColor::CYAN: return DebugDrawColor(64, 224, 255);
+    }
+    return DebugDrawColor(255, 214, 64);
+}
+
 static void DrawAimingArc(const AimingArcCache& cache) {
-    const uint32_t targetColor = DebugDrawColor(255, 214, 64, 100);
     const uint32_t fallMarkerColor = DebugDrawColor(255, 52, 36, 200);
     constexpr float kThickness = 1.5f;
+    // a quarter of upstream's 0.16 m, so Size 100 % is a quarter of the size the previous build showed at the same
+    // distance; the Size row spans 10-400 %, so it still reaches the previous build's size at 400 %
+    constexpr float kAimingCrosshairRadius = 0.04f;
+    // the sphere is world-sized, so its radius follows its distance to keep the crosshair the size it has at 10 m;
+    // the limits keep it sane against a wall and across a valley
+    constexpr float kAimingCrosshairReferenceDistance = 10.0f;
+    constexpr float kAimingCrosshairDistanceScaleMin = 0.1f;
+    constexpr float kAimingCrosshairDistanceScaleMax = 20.0f;
     constexpr bool kPreviewXray = false;
 
-    const bool dotOnly = GetSettings().IsBowArcDotOnly();
-    const float alphaScale = dotOnly ? 1.0f : GetSettings().GetBowArcOpacity();
+    const ModSettings& settings = GetSettings();
+    const bool dotOnly = settings.IsBowArcDotOnly();
+    const float alphaScale = dotOnly ? 1.0f : settings.GetBowArcOpacity();
 
     if (!dotOnly && cache.pointCount >= 2) {
         std::array<uint32_t, kPresetDefaultMaxFrames + 2> colors = {};
@@ -1400,7 +1421,13 @@ static void DrawAimingArc(const AimingArcCache& cache) {
     }
 
     if (cache.hasTargetPos) {
-        DebugDraw::instance().Sphere(cache.targetPos, 0.16f, ScaleColorAlpha(targetColor, dotOnly ? 2.2f : alphaScale), 12, true);
+        const glm::vec3 crosshairOrigin = cache.pointCount > 0 ? cache.points[0] : cache.targetPos;
+        const float distanceScale = glm::clamp(
+            glm::distance(crosshairOrigin, cache.targetPos) / kAimingCrosshairReferenceDistance,
+            kAimingCrosshairDistanceScaleMin,
+            kAimingCrosshairDistanceScaleMax
+        );
+        DebugDraw::instance().Sphere(cache.targetPos, kAimingCrosshairRadius * settings.aimingDotSize * distanceScale, ScaleColorAlpha(AimingDotPresetColor(settings.aimingDotColor), settings.aimingDotOpacity), 12, true, true);
     }
 }
 
@@ -1430,7 +1457,9 @@ void Bow::QueueAimingArcPreview(long frameIdx) {
         AimingArcCache cache = {};
         if (BuildPreviewTrajectory(launchState, cache.points, cache.pointCount, cache.firstFallIndex)) {
             cache.valid = true;
-            cache.hasTargetPos = launchState.hasTargetPos && !launchState.usedSyntheticTargetPos;
+            // in first person the crosshair draws at the synthetic point too, so an empty sky still shows where the arrow is aimed;
+            // third person always uses that point and it is not where the arrow lands, so it keeps upstream's suppression
+            cache.hasTargetPos = launchState.hasTargetPos && (!launchState.usedSyntheticTargetPos || !GameState::IsThirdPerson());
             cache.targetPos = launchState.targetPos;
             s_aimingArcCache = cache;
             Log::print<ARROW_SHOT_CAPTURE>("[BowViz] Rendering {} arc points (origin={}, direction={}, firstFall={}, draw={:.3f}, atRange={:.1f})", cache.pointCount, launchState.launchOrigin, launchState.launchDirection, cache.firstFallIndex, launchState.drawAmount, launchState.atRange);
