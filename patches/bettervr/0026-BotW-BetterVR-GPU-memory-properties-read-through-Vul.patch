From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patryk <papyszoo@gmail.com>
Date: Mon, 16 Nov 2026 11:03:26 +0100
Subject: [PATCH] BotW-BetterVR: GPU memory properties read through Vulkan 1.1
 (Crementif/BotW-BetterVR@47ea413)

patches/bettervr 0026: drivers leave the KHR alias null when its extension is not enabled; the core call is always there.
---
 src/rendering/vulkan.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/rendering/vulkan.cpp b/src/rendering/vulkan.cpp
index 52de800..edd9f23 100644
--- a/src/rendering/vulkan.cpp
+++ b/src/rendering/vulkan.cpp
@@ -19,7 +19,7 @@ RND_Vulkan::RND_Vulkan(VkInstance vkInstance, VkPhysicalDevice vkPhysDevice, VkD
     // AMD GPU FIX: Initialize sType before calling vkGetPhysicalDeviceMemoryProperties2
     m_memoryProperties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2;
     m_memoryProperties.pNext = nullptr;
-    m_physicalDeviceDispatch->GetPhysicalDeviceMemoryProperties2KHR(vkPhysDevice, &m_memoryProperties);
+    m_physicalDeviceDispatch->GetPhysicalDeviceMemoryProperties2(vkPhysDevice, &m_memoryProperties);
 
     VkPhysicalDeviceProperties props{};
     m_instanceDispatch->GetPhysicalDeviceProperties(vkPhysDevice, &props);
