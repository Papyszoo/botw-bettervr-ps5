From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Sun, 22 Nov 2026 21:01:22 +0100
Subject: [PATCH] PS5: the aiming dot's size, color and opacity are three rows
 on the Comfort page; built, untested on console

The dot at the arrow's target is BetterVR's own: DrawAimingArc draws a 0.16 m yellow
(255, 214, 64) sphere at the game's weapon target position, with alpha 100 scaled by the Bow
Aiming Arc transparency (or 2.2x in Dot Only mode). It is not the game's HUD reticle, which is
only ever a texture on the floating HUD panel.

Three settings beside Bow Aiming Arc: Aiming Dot Size (50-300 %, the radius), Aiming Dot Color
(White, Red, Green, Yellow, Cyan) and Aiming Dot Opacity (0-100 %, a multiplier on the alpha the
dot already had). At 100 %, Yellow and 100 % the sphere is the same 0.16 m, color and alpha as
before, in arc and Dot Only modes alike; the arc and the fall marker do not change. The rows use
the existing percent slider and combo helpers, whose label and setting-name PushIDs give each
row its own focus, as 0046 did for the Vibration page.
---
 src/game/botw/player/bow.cpp  | 22 ++++++++++++++++++----
 src/rendering/imgui_menus.cpp | 16 ++++++++++++++++
 src/utils/mod_settings.h      | 26 ++++++++++++++++++++++++++
 3 files changed, 60 insertions(+), 4 deletions(-)

diff --git a/src/game/botw/player/bow.cpp b/src/game/botw/player/bow.cpp
index 8df50c1..cfbadf3 100644
--- a/src/game/botw/player/bow.cpp
+++ b/src/game/botw/player/bow.cpp
@@ -1370,14 +1370,27 @@ static uint32_t ScaleColorAlpha(uint32_t color, float scale) {
     return (color & 0x00FFFFFF) | ((uint32_t)a << 24);
 }
 
+// the aiming dot's presets; yellow is the one upstream drew, so at the defaults the dot is unchanged
+static uint32_t AimingDotPresetColor(AimingDotColor preset) {
+    switch (preset) {
+        case AimingDotColor::WHITE: return DebugDrawColor(255, 255, 255, 100);
+        case AimingDotColor::RED: return DebugDrawColor(255, 52, 36, 100);
+        case AimingDotColor::GREEN: return DebugDrawColor(64, 255, 96, 100);
+        case AimingDotColor::YELLOW: return DebugDrawColor(255, 214, 64, 100);
+        case AimingDotColor::CYAN: return DebugDrawColor(64, 224, 255, 100);
+    }
+    return DebugDrawColor(255, 214, 64, 100);
+}
+
 static void DrawAimingArc(const AimingArcCache& cache) {
-    const uint32_t targetColor = DebugDrawColor(255, 214, 64, 100);
     const uint32_t fallMarkerColor = DebugDrawColor(255, 52, 36, 200);
     constexpr float kThickness = 1.5f;
+    constexpr float kAimingDotRadius = 0.16f;
     constexpr bool kPreviewXray = false;
 
-    const bool dotOnly = GetSettings().IsBowArcDotOnly();
-    const float alphaScale = dotOnly ? 1.0f : GetSettings().GetBowArcOpacity();
+    const ModSettings& settings = GetSettings();
+    const bool dotOnly = settings.IsBowArcDotOnly();
+    const float alphaScale = dotOnly ? 1.0f : settings.GetBowArcOpacity();
 
     if (!dotOnly && cache.pointCount >= 2) {
         std::array<uint32_t, kPresetDefaultMaxFrames + 2> colors = {};
@@ -1400,7 +1413,8 @@ static void DrawAimingArc(const AimingArcCache& cache) {
     }
 
     if (cache.hasTargetPos) {
-        DebugDraw::instance().Sphere(cache.targetPos, 0.16f, ScaleColorAlpha(targetColor, dotOnly ? 2.2f : alphaScale), 12, true);
+        const float dotAlphaScale = (dotOnly ? 2.2f : alphaScale) * settings.aimingDotOpacity;
+        DebugDraw::instance().Sphere(cache.targetPos, kAimingDotRadius * settings.aimingDotSize, ScaleColorAlpha(AimingDotPresetColor(settings.aimingDotColor), dotAlphaScale), 12, true);
     }
 }
 
diff --git a/src/rendering/imgui_menus.cpp b/src/rendering/imgui_menus.cpp
index 363ff56..08fb8bf 100644
--- a/src/rendering/imgui_menus.cpp
+++ b/src/rendering/imgui_menus.cpp
@@ -1169,6 +1169,22 @@ void RND_Renderer::ImGuiOverlay::DrawComfortPage(bool* changed) {
             DrawSetting(nullptr, "Bow Aiming Arc", [&]() {
                 DrawBowArcSlider(settings.bowArcOpacity, changed);
             });
+            static constexpr EnumChoice<AimingDotColor> aimingDotColorChoices[] = {
+                { AimingDotColor::WHITE, "White" },
+                { AimingDotColor::RED, "Red" },
+                { AimingDotColor::GREEN, "Green" },
+                { AimingDotColor::YELLOW, "Yellow" },
+                { AimingDotColor::CYAN, "Cyan" },
+            };
+            DrawSetting(nullptr, "Aiming Dot Size", [&]() {
+                DrawPercentSlider(settings.aimingDotSize, 50.0f, 300.0f, changed);
+            });
+            DrawSetting(nullptr, "Aiming Dot Color", [&]() {
+                DrawEnumCombo(settings.aimingDotColor, aimingDotColorChoices, changed);
+            });
+            DrawSetting(nullptr, "Aiming Dot Opacity", [&]() {
+                DrawPercentSlider(settings.aimingDotOpacity, 0.0f, 100.0f, changed);
+            });
             EndCard();
         }
     }
diff --git a/src/utils/mod_settings.h b/src/utils/mod_settings.h
index dbbea25..096aa49 100644
--- a/src/utils/mod_settings.h
+++ b/src/utils/mod_settings.h
@@ -567,6 +567,27 @@ struct EnumTable<SwingSensitivity> {
     });
 };
 
+// the aiming dot at the arrow's target (game/botw/player/bow.cpp): a preset colour, and the size and opacity
+// that scale the sphere and the alpha the bow arc's transparency already gives it
+enum class AimingDotColor : int32_t {
+    WHITE = 0,
+    RED = 1,
+    GREEN = 2,
+    YELLOW = 3,
+    CYAN = 4,
+};
+
+template <>
+struct EnumTable<AimingDotColor> {
+    static constexpr auto entries = std::to_array<EnumEntry<AimingDotColor>>({
+        { AimingDotColor::WHITE, "WHITE", "White" },
+        { AimingDotColor::RED, "RED", "Red" },
+        { AimingDotColor::GREEN, "GREEN", "Green" },
+        { AimingDotColor::YELLOW, "YELLOW", "Yellow" },
+        { AimingDotColor::CYAN, "CYAN", "Cyan" }
+    });
+};
+
 enum class TurnMode : int32_t {
     SMOOTH_SLOW = 0,
     SMOOTH_NORMAL = 1,
@@ -611,6 +632,11 @@ struct ModSettings {
     FloatSetting hudDistance{ "HudDistance", 1.85f, 0.5f, 2.5f };
     FloatSetting hudSize{ "HudSize", 0.85f, 0.4f, 1.75f };
     FloatSetting bowArcOpacity{ "BowArcTransparency", 0.7f, 0.0f, 1.0f };
+    // the aiming dot at the end of the arc: the defaults draw exactly the sphere and colour the code had, and the
+    // opacity multiplies the alpha the arc's transparency already gave the dot, in the "Dot Only" mode too
+    FloatSetting aimingDotSize{ "AimingDotSize", 1.0f, 0.5f, 3.0f };
+    EnumSetting<AimingDotColor> aimingDotColor{ "AimingDotColor", AimingDotColor::YELLOW };
+    FloatSetting aimingDotOpacity{ "AimingDotOpacity", 1.0f, 0.0f, 1.0f };
 
     BoolSetting enableDebuggerTools{ "EnableDebugOverlay", false };
     BoolSetting showDebugConsole{ "ShowDebugConsole", false, &Log::SetConsoleVisible };
