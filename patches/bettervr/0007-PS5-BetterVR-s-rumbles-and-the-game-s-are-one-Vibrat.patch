+// A damage reaction state is the frame a hit lands (vib.md, "Damage taken"): one falling rumble on both hands, once
+// per state change, since the hook can fire again for the same hit. The state's name is also logged once each, as
+// the first-person block below never reaches the state-change line.
+static void PlayDamageRumble(uint32_t stateNamePtr) {
+    using clock = std::chrono::steady_clock;
+    static clock::time_point s_lastPlayed{};
+    static uint32_t s_lastState = 0;
+    static int s_namesLogged = 0;
+    const auto now = clock::now();
+    if (stateNamePtr == s_lastState && now - s_lastPlayed < std::chrono::milliseconds(300))
+        return;
+    s_lastState = stateNamePtr;
+    s_lastPlayed = now;
+
+    if (s_namesLogged < 6) {
+        s_namesLogged++;
+        Log::print<INFO>("[vib] damage state '{}' (0x{:08X})", Guest::CString(stateNamePtr), stateNamePtr);
+    }
+
+    constexpr RumbleParameters damageRumble = { true, 0, RumbleType::Falling, 0.5f, false, 0.4, 0.1f, 0.8f };
+    Haptics::Play(damageRumble, HapticCategory::Damage);
+    RumbleParameters otherHand = damageRumble;
+    otherHand.hand = 1;
+    Haptics::Play(otherHand, HapticCategory::Damage);
+}
