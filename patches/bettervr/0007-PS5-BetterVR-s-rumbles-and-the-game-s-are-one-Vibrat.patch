diff --git a/src/utils/mod_settings.cpp b/src/utils/mod_settings.cpp
index 8967cda..87fd34d 100644
--- a/src/utils/mod_settings.cpp
+++ b/src/utils/mod_settings.cpp
@@ -16,6 +16,66 @@ ModSettings& GetSettings() {
     return g_settings;
 }
 
+BoolSetting& ModSettings::HapticsEnabled(HapticCategory category) {
+    switch (category) {
+        case HapticCategory::Swing: return hapticsSwing;
+        case HapticCategory::Bow: return hapticsBow;
+        case HapticCategory::Guard: return hapticsGuard;
+        case HapticCategory::Equip: return hapticsEquip;
+        case HapticCategory::UseThrow: return hapticsUseThrow;
+        case HapticCategory::Rune: return hapticsRune;
+        case HapticCategory::Damage: return hapticsDamage;
+        case HapticCategory::Explosion: return hapticsExplosion;
+        case HapticCategory::Game:
+        case HapticCategory::Count:
+        default: return hapticsGame;
+    }
+}
+
+UIntSetting& ModSettings::HapticsStrength(HapticCategory category) {
+    switch (category) {
+        case HapticCategory::Swing: return hapticsSwingStrength;
+        case HapticCategory::Bow: return hapticsBowStrength;
+        case HapticCategory::Guard: return hapticsGuardStrength;
+        case HapticCategory::Equip: return hapticsEquipStrength;
+        case HapticCategory::UseThrow: return hapticsUseThrowStrength;
+        case HapticCategory::Rune: return hapticsRuneStrength;
+        case HapticCategory::Damage: return hapticsDamageStrength;
+        case HapticCategory::Explosion: return hapticsExplosionStrength;
+        case HapticCategory::Game:
+        case HapticCategory::Count:
+        default: return hapticsGameStrength;
+    }
+}
+
+UIntSetting& ModSettings::HapticsDevices(HapticCategory category) {
+    switch (category) {
+        case HapticCategory::Swing: return hapticsSwingDevices;
+        case HapticCategory::Bow: return hapticsBowDevices;
+        case HapticCategory::Guard: return hapticsGuardDevices;
+        case HapticCategory::Equip: return hapticsEquipDevices;
+        case HapticCategory::UseThrow: return hapticsUseThrowDevices;
+        case HapticCategory::Rune: return hapticsRuneDevices;
+        case HapticCategory::Damage: return hapticsDamageDevices;
+        case HapticCategory::Explosion: return hapticsExplosionDevices;
+        case HapticCategory::Game:
+        case HapticCategory::Count:
+        default: return hapticsGameDevices;
+    }
+}
+
+float ModSettings::GetHapticsGain(HapticCategory category) {
+    if (!haptics.load() || !HapticsEnabled(category).load())
+        return 0.0f;
+    return HapticsStrength(category).load() / 100.0f;
+}
+
+uint32_t ModSettings::GetHapticsDeviceMask(HapticCategory category) {
+    if (GetHapticsGain(category) <= 0.0f)
+        return 0;
+    return HapticsDevices(category).load();
+}
+
 void Settings_LogSavedSettings() {
     Log::print<INFO>("VR Settings Saved:\n{}", GetSettings().ToString());
 }
