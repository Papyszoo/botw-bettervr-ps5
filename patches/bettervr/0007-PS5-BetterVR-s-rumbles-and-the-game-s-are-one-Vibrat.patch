diff --git a/src/rendering/haptic_types.h b/src/rendering/haptic_types.h
new file mode 100644
index 0000000..f3141e0
--- /dev/null
+++ b/src/rendering/haptic_types.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstdint>
+
+// The situations a rumble belongs to, as the Vibration page groups them (rendering/imgui_menus.cpp). The game's
+// own rumble is one category in this build: the [vib] pattern log in controls.cpp is what will split it later.
+enum class HapticCategory : uint8_t {
+    Swing,
+    Bow,
+    Guard,
+    Equip,
+    UseThrow,
+    Rune,
+    Game,
+    Damage,
+    Explosion,
+    Count,
+};
+
+// The devices a category can be felt on, one bit each in Haptics<Category>Devices (utils/mod_settings.h).
+enum HapticDevice : uint32_t {
+    HapticDeviceSense = 1,
+    HapticDeviceHeadset = 2,
+    HapticDevicePad = 4,
+    HapticDeviceAll = HapticDeviceSense | HapticDeviceHeadset | HapticDevicePad,
+};
