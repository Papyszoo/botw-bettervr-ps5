+
 static RumbleManager* GetRumbleManager() {
     auto& xr = VRManager::instance().XR;
     return xr ? xr->GetRumbleManager() : nullptr;
 }
 
-void Haptics::Play(const RumbleParameters& rumble) {
+void Haptics::Play(const RumbleParameters& rumble, HapticCategory category) {
+    // the strength and the on/off are read again for each frame of the envelope (RumbleManager::updateHaptics), so the
+    // page's changes are live; a request made while the category is off is dropped here
+    if (GetSettings().GetHapticsGain(category) <= 0.0f)
+        return;
+    RumbleParameters tagged = rumble;
+    tagged.category = category;
     if (RumbleManager* manager = GetRumbleManager())
-        manager->enqueueInputsRumbleCommand(rumble);
