+#if defined(__PROSPERO__)
+// The game's own rumble, one [vib] line per event for the v0.6 console run (at most 40 lines, 150 ms apart). The
+// caller names the game system that started it (Route B in the v0.6 research); sead's PatternRumbleAddon keeps the
+// authored pattern string at +0x14 ("*" is on) and its repeat count at +0x1C, and when the addon's this is one of the
+// callee-saved registers or on the stack (Route A) its string is printed too. The VPAD bytes are only the rhythm.
+// This logs and nothing else: the game's rumble stays one category until a run has shown what the patterns mean.
+static void LogGameRumbleEvent(PPCInterpreter_t* hCPU, const uint8_t* pattern, uint8_t length, bool stopped) {
+    static std::chrono::steady_clock::time_point s_last{};
+    static int s_logged = 0;
+    if (!GetSettings().hapticsLogPatterns || s_logged >= 40)
+        return;
+    const auto now = std::chrono::steady_clock::now();
+    if (s_last != std::chrono::steady_clock::time_point{} && now - s_last < std::chrono::milliseconds(150))
+        return;
+    s_last = now;
+    s_logged++;
+
+    char text[41] = {};
+    uint32_t addon = 0;
+    uint32_t repeat = 0;
+    auto probe = [&](uint32_t candidate) {
+        if (addon != 0 || candidate < 0x10000000 || candidate >= 0x50000000 || (candidate & 3) != 0)
+            return;
+        const uint32_t vtable = Guest::Get<uint32_t>(candidate).getLE();
+        if (vtable < 0x02000000 || vtable >= 0x05000000)
+            return;
+        const uint32_t stringPtr = Guest::Get<uint32_t>(candidate + 0x14).getLE();
+        if (stringPtr < 0x10000000 || stringPtr >= 0x50000000 || (stringPtr & 3) != 0)
+            return;
+        const char* chars = Guest::CString(stringPtr);
+        size_t charsRead = 0;
+        bool hasOn = false;
+        while (charsRead < sizeof(text) - 1 && chars[charsRead] != '\0') {
+            const char c = chars[charsRead];
+            if (c < 0x20 || c > 0x7e)
+                return;
+            hasOn |= c == '*';
+            charsRead++;
+        }
+        if (charsRead < 2 || charsRead >= sizeof(text) - 1 || !hasOn)
+            return;
+        std::memcpy(text, chars, charsRead);
+        addon = candidate;
+        repeat = Guest::Get<uint32_t>(candidate + 0x1C).getLE();
+    };
+    for (int reg = 31; reg >= 24; reg--)
+        probe((uint32_t)hCPU->gpr[reg]);
+    const uint32_t stackPointer = (uint32_t)hCPU->gpr[1];
+    if (stackPointer >= 0x10000000 && stackPointer < 0x50000000)
+        for (uint32_t offset = 4; offset <= 0x24 && addon == 0; offset += 4)
+            probe(Guest::Get<uint32_t>(stackPointer + offset).getLE());
+
+    std::string state = GameState::IsShowingMenu() ? "menu" : (GameState::IsInGame() ? "in-game" : "not-in-game");
+    if (Player::IsRiding()) state += "+riding";
+    if (Player::IsGliding()) state += "+gliding";
+    if (Player::IsClimbing()) state += "+climbing";
+    if (Events::IsActive()) state += "+event";
+    std::string bytes;
+    if (!stopped) {
+        const int count = std::min<int>(15, (length + 7) / 8);
+        for (int i = 0; i < count; i++)
+            bytes += fmt::format("{}{:02x}", i ? " " : "", pattern[i]);
+    }
+    Log::print<INFO>("[vib] game rumble #{} {} caller=0x{:08X} {} bytes=[{}] pattern=\"{}\" repeat={} addon=0x{:08X}",
+        s_logged, stopped ? "stop" : "start", hCPU->sprNew.LR, state, bytes, text[0] != '\0' ? text : "?", repeat, addon);
+}
+#endif
+
 static void hook_XRRumble_VPADControlMotor(PPCInterpreter_t* hCPU) {
     hCPU->instructionPointer = hCPU->sprNew.LR;
 
     uint8_t* pattern = Guest::HostPointer<uint8_t>(hCPU->gpr[4]);
     uint8_t length = (uint8_t)hCPU->gpr[5];
+#if defined(__PROSPERO__)
+    LogGameRumbleEvent(hCPU, pattern, length, false);
+#endif
     Haptics::PlayGamePattern(pattern, length);
 }
 
 static void hook_XRRumble_VPADStopMotor(PPCInterpreter_t* hCPU) {
     hCPU->instructionPointer = hCPU->sprNew.LR;
 
+#if defined(__PROSPERO__)
+    LogGameRumbleEvent(hCPU, nullptr, 0, true);
+#endif
     Haptics::StopGamePattern();
 }
 
