diff --git a/src/hooking/entity_controller.cpp b/src/hooking/entity_controller.cpp
index ef3e57f..1969b4c 100644
--- a/src/hooking/entity_controller.cpp
+++ b/src/hooking/entity_controller.cpp
@@ -92,6 +92,34 @@ enum class RoomscaleBodyDriveMode : uint8_t {
 uint32_t g_diagRoomscaleBegin = 0, g_diagRoomscaleCast = 0, g_diagRoomscaleWarp = 0;
 bool g_diagRoomscaleEnabled = true;
 
+// PS5 physics (controls.cpp [phys]): the gate's entries (per eye side), runs and skips, the game frames
+// they fall in, the PPC core, and the runs that took the due word at least one game frame after the frame
+// it was armed for. The gate itself is decided in the asm (playerOnceEnabled, playerVelocityUpdateDue);
+// nothing here changes a run.
+extern "C" bool BetterVR_PS5_PlayerOnce();
+
+struct PhysDiagnostics {
+    std::atomic<uint32_t> mainFrame{0};
+    std::atomic<uint32_t> entries[2] = {};
+    std::atomic<uint32_t> runs{0};
+    std::atomic<uint32_t> coreEntries[3] = {};
+    std::atomic<uint32_t> coreRuns[3] = {};
+    std::atomic<uint32_t> lateRuns{0};
+};
+static PhysDiagnostics s_phys;
+
+static void RecordPhysGate(uint32_t core, uint32_t eye, uint32_t frame, uint32_t dueFrame, bool run) {
+    const std::memory_order relaxed = std::memory_order_relaxed;
+    s_phys.entries[eye != 0 ? 1 : 0].fetch_add(1, relaxed);
+    if (core < 3) s_phys.coreEntries[core].fetch_add(1, relaxed);
+    if (!run) return;
+    s_phys.runs.fetch_add(1, relaxed);
+    if (core < 3) s_phys.coreRuns[core].fetch_add(1, relaxed);
+    // playerOnce: a take in the same or next frame is on time (frame - dueFrame is 0 or 1); late is a
+    // take at least one game frame after the frame it was armed for (frame - dueFrame >= 2).
+    if (BetterVR_PS5_PlayerOnce() && (int32_t)(frame - dueFrame) > 1) s_phys.lateRuns.fetch_add(1, relaxed);
+}
+
 static RoomscaleState s_roomscaleState;
 static std::atomic<float> s_roomscaleFadeAmount = 0.0f;
 static RoomscaleBodyDriveMode s_roomscaleBodyDriveMode = RoomscaleBodyDriveMode::DisabledNotInGame;
@@ -633,6 +661,13 @@ static void PrimeRoomscaleBaseline(const glm::fvec3& headPos) {
 
 extern "C" float BetterVR_PS5_Setting(const char* name, float fallback);
 
+// PS5: bettervr.json's playerOnce (default on), cached once so the boot log's gate line, the guest flag
+// and the [phys] mode all name the value the gate actually runs (runtime.cpp calls this too).
+extern "C" bool BetterVR_PS5_PlayerOnce() {
+    static const bool s_playerOnce = BetterVR_PS5_Setting("playerOnce", 1.0f) >= 0.5f;
+    return s_playerOnce;
+}
+
 static bool ShouldDrivePlayerBodyWithVR(const glm::fvec3& currentHeadPos, const PlayerBase& player) {
     // PS5 experiment: bettervr.json {"roomscale":0} turns the head-driven body movement off (read once). Default on.
     static const bool s_roomscaleOn = BetterVR_PS5_Setting("roomscale", 1.0f) >= 0.5f;
@@ -812,6 +847,112 @@ void CemuHooks::hook_BeginRoomscaleMovement(PPCInterpreter_t* hCPU) {
     BetterVRProfiler::BeginSpan(BetterVRProfiler::Section::RoomscaleResolve);
 }
 
+void CemuHooks::hook_PhysFrame(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    s_phys.mainFrame.store(hCPU->gpr[3], std::memory_order_relaxed);
+
+    // PS5: write bettervr.json's playerOnce (default on) into the guest gate flag once, from the same
+    // cached value the boot log's line names. r4 is the flag's address (patch_RND_StereoRendering.asm).
+    static std::atomic<bool> s_gateWritten{false};
+    if (!s_gateWritten.exchange(true, std::memory_order_relaxed)) {
+        uint32_t enabled = BetterVR_PS5_PlayerOnce() ? 1u : 0u;
+        writeMemoryBE<uint32_t>(hCPU->gpr[4], &enabled);
+    }
+}
+
+void CemuHooks::hook_PlayerUpdateGate(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+
+    const uint32_t eye = hCPU->gpr[3];
+    const uint32_t frame = hCPU->gpr[4];
+    const uint32_t dueFrame = hCPU->gpr[5];
+    const bool run = hCPU->gpr[6] != 0;
+
+    // The asm already took the due word (or ran upstream's check); this just records it and returns run/skip.
+    RecordPhysGate(hCPU->sprNew.UPIR, eye, frame, dueFrame, run);
+    hCPU->gpr[3] = run ? 1 : 0;
+}
+
+void CemuHooks::LogPhysicsDiagnostics(bool inGame) {
+    static auto s_lastLine = std::chrono::steady_clock::now();
+    static auto s_start = s_lastLine;
+    static uint32_t s_lines = 0;
+    static bool s_wasInGame = false;
+    static uint32_t s_lastFrame = 0;
+    static uint32_t s_lastEntries[2] = {};
+    static uint32_t s_lastRuns = 0;
+    static uint32_t s_lastCoreEntries[3] = {};
+    static uint32_t s_lastCoreRuns[3] = {};
+    static uint32_t s_lastLateRuns = 0;
+
+    if (!inGame) {
+        s_wasInGame = false;
+        return;
+    }
+    if (s_lines >= 1200)
+        return;
+    const auto now = std::chrono::steady_clock::now();
+    const std::memory_order relaxed = std::memory_order_relaxed;
+    if (!s_wasInGame) {
+        // Start at the first in-game frame: the title and loading screens are not a physics sample.
+        s_wasInGame = true;
+        s_lastLine = s_start = now;
+        s_lastFrame = s_phys.mainFrame.load(relaxed);
+        for (int side = 0; side < 2; side++) s_lastEntries[side] = s_phys.entries[side].load(relaxed);
+        s_lastRuns = s_phys.runs.load(relaxed);
+        for (int core = 0; core < 3; core++) {
+            s_lastCoreEntries[core] = s_phys.coreEntries[core].load(relaxed);
+            s_lastCoreRuns[core] = s_phys.coreRuns[core].load(relaxed);
+        }
+        s_lastLateRuns = s_phys.lateRuns.load(relaxed);
+        return;
+    }
+    if (now - s_lastLine < std::chrono::seconds(2))
+        return;
+
+    const uint32_t frame = s_phys.mainFrame.load(relaxed);
+    const uint32_t frames = frame - s_lastFrame;
+    if (frames == 0)
+        return;
+
+    const uint32_t entriesL = s_phys.entries[0].load(relaxed) - s_lastEntries[0];
+    const uint32_t entriesR = s_phys.entries[1].load(relaxed) - s_lastEntries[1];
+    const uint32_t runs = s_phys.runs.load(relaxed) - s_lastRuns;
+    const uint32_t entries = entriesL + entriesR;
+    const uint32_t skips = entries > runs ? entries - runs : 0; // separate atomics: never show an underflow
+    const uint32_t lateRuns = s_phys.lateRuns.load(relaxed) - s_lastLateRuns;
+    uint32_t coreEntries[3], coreRuns[3];
+    for (int core = 0; core < 3; core++) {
+        coreEntries[core] = s_phys.coreEntries[core].load(relaxed) - s_lastCoreEntries[core];
+        coreRuns[core] = s_phys.coreRuns[core].load(relaxed) - s_lastCoreRuns[core];
+    }
+
+    s_lastLine = now;
+    s_lines++;
+    s_lastFrame = frame;
+    s_lastEntries[0] = s_phys.entries[0].load(relaxed);
+    s_lastEntries[1] = s_phys.entries[1].load(relaxed);
+    s_lastRuns = s_phys.runs.load(relaxed);
+    for (int core = 0; core < 3; core++) {
+        s_lastCoreEntries[core] = s_phys.coreEntries[core].load(relaxed);
+        s_lastCoreRuns[core] = s_phys.coreRuns[core].load(relaxed);
+    }
+    s_lastLateRuns = s_phys.lateRuns.load(relaxed);
+
+    const double seconds = std::chrono::duration<double>(now - s_start).count();
+    const double runsPerFrame = (double)runs / (double)frames;
+
+    // One bounded line (2 s, at most 1200): entries per eye side, runs and skips, runs per game frame
+    // (about 0.02-0.04 before the fix, 1.00 after), the PPC cores, and runs that took the due at least one
+    // game frame after the frame it was armed for (an on-time take is the same or next frame).
+    Log::print<INFO>("[phys] t={:.1f} frames={} mode={} entries L={} R={} runs={} skips={} runs/f {:.2f} late={} "
+        "cores entries 0:{} 1:{} 2:{} runs 0:{} 1:{} 2:{}",
+        seconds, frames, BetterVR_PS5_PlayerOnce() ? "once" : "upstream",
+        entriesL, entriesR, runs, skips, runsPerFrame, lateRuns,
+        coreEntries[0], coreEntries[1], coreEntries[2],
+        coreRuns[0], coreRuns[1], coreRuns[2]);
+}
+
 void CemuHooks::hook_PrepareRoomscaleRaycast(PPCInterpreter_t* hCPU) {
     hCPU->instructionPointer = hCPU->sprNew.LR;
     uint32_t scratchPtr = hCPU->gpr[3];
