     static void hook_BuildRoomscaleWarpTransform(PPCInterpreter_t* hCPU);
diff --git a/src/hooking/controls.cpp b/src/hooking/controls.cpp
index b2857ab..202cbbd 100644
--- a/src/hooking/controls.cpp
+++ b/src/hooking/controls.cpp
@@ -1322,6 +1322,7 @@ void CemuHooks::hook_InjectXRInput(PPCInterpreter_t* hCPU) {
             g_diagEndCameraSide[0] = g_diagEndCameraSide[1] = 0;
             g_diagRoomscaleBegin = g_diagRoomscaleCast = g_diagRoomscaleWarp = 0;
         }
