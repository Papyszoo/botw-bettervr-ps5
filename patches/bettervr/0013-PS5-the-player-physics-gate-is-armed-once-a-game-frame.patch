From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patryk Kowalczyk <papyszoo@gmail.com>
Date: Thu, 5 Nov 2026 23:49:42 +0100
Subject: [PATCH] PS5: the player physics gate is armed once a game frame

The right-eye pass arms a due word before its calcDraw; OnlyRunPlayerUpdateJobOnce takes it atomically (lwarx/stwcx.) so the player's velocity update runs exactly once a game frame whichever pass or core asks first, and a late call still consumes its frame's due. The gate saves the caller's r3-r12, CR and CTR in its own frame and restores them before the bctrl, so the updater is called with the same registers and CR0 as upstream's hook. bettervr.json {"playerOnce":0} keeps upstream's right-eye check, read from a guest flag the host writes once at the start from the same cached value the boot log names. The [phys] line reports gate entries per eye side, runs and skips, runs per game frame, the PPC core, and runs that took the due at least one game frame after the frame it was armed for. The tail hook is gone.
---
 .../patch_RND_StereoRendering.asm             |  39 +++++
 .../patch_RND_StereoRendering_ActorJobs.asm   | 115 ++++++++++++--
 src/hooking/cemu_hooks.h                      |   5 +
 src/hooking/controls.cpp                      |   1 +
 src/hooking/entity_controller.cpp             | 141 ++++++++++++++++++
 5 files changed, 288 insertions(+), 13 deletions(-)

diff --git a/resources/BreathOfTheWild_BetterVR/patch_RND_StereoRendering.asm b/resources/BreathOfTheWild_BetterVR/patch_RND_StereoRendering.asm
index 576ae00..266b59b 100644
--- a/resources/BreathOfTheWild_BetterVR/patch_RND_StereoRendering.asm
+++ b/resources/BreathOfTheWild_BetterVR/patch_RND_StereoRendering.asm
@@ -21,6 +21,24 @@ currentEyeSide:
 currentFrameCounter:
 .int 0
 
+; PS5 physics: a monotonic game frame, increased with currentFrameCounter. The right-eye pass arms the
+; player's velocity update once a game frame: the frame is stored first, then the due word, and the first
+; update call after it takes the word (OnlyRunPlayerUpdateJobOnce), so the update runs once whichever
+; pass or core asks first and a late call still consumes its frame's due.
+physFrameCounter:
+.int 0
+
+playerVelocityUpdateDue:
+.int 0
+
+playerVelocityUpdateDueFrame:
+.int 0
+
+; Written once by the host when the pack starts: bettervr.json's playerOnce (default on), or 0 for
+; upstream's right-eye check (hook_PhysFrame, entity_controller.cpp; the boot log names the same value).
+playerOnceEnabled:
+.int 1
+
 0x10463EB0 = FadeProgress__sInstance:
 0x031FB1B4 = sub_31FB1B4_getTimeForGameUpdateMaybe:
 0x0309F72C = sead_GameFramework_lockFrameDrawContext:
@@ -158,6 +176,16 @@ li r3, 0
 skip_resetFrameCounter:
 stw r3, currentFrameCounter@l(r12)
 
+; PS5 physics: one game frame more. The host keeps the frame for the [phys] line, and writes playerOnce
+; (default on) into playerOnceEnabled once, before the first gate call.
+lis r12, physFrameCounter@ha
+lwz r3, physFrameCounter@l(r12)
+addi r3, r3, 1
+stw r3, physFrameCounter@l(r12)
+lis r4, playerOnceEnabled@ha
+addi r4, r4, playerOnceEnabled@l
+bla import.coreinit.hook_PhysFrame
+
 ; start rendering for the left eye
 li r0, 0
 lis r12, currentEyeSide@ha
@@ -227,6 +255,17 @@ bl import.coreinit.hook_EndCameraSide
 li r0, 1
 lis r12, currentEyeSide@ha
 stw r0, currentEyeSide@l(r12)
+
+; PS5 physics: this game frame's player velocity update is due. The frame goes first, then the due word,
+; so the call that takes it can say how many frames after the arm it ran (the [phys] line's late runs).
+lis r12, physFrameCounter@ha
+lwz r0, physFrameCounter@l(r12)
+lis r12, playerVelocityUpdateDueFrame@ha
+stw r0, playerVelocityUpdateDueFrame@l(r12)
+li r0, 1
+lis r12, playerVelocityUpdateDue@ha
+stw r0, playerVelocityUpdateDue@l(r12)
+
 li r3, 1
 bl import.coreinit.hook_BeginCameraSide
 
diff --git a/resources/BreathOfTheWild_BetterVR/patch_RND_StereoRendering_ActorJobs.asm b/resources/BreathOfTheWild_BetterVR/patch_RND_StereoRendering_ActorJobs.asm
index 025bcd9..a3dbc27 100644
--- a/resources/BreathOfTheWild_BetterVR/patch_RND_StereoRendering_ActorJobs.asm
+++ b/resources/BreathOfTheWild_BetterVR/patch_RND_StereoRendering_ActorJobs.asm
@@ -951,29 +951,118 @@ blr
 
 OnlyRunPlayerUpdateJobOnce:
 mflr r0
-stwu r1, -0x20(r1)
-stw r0, 0x24(r1)
-stw r3, 0x1C(r1)
-stw r4, 0x18(r1)
-stw r5, 0x14(r1)
+stwu r1, -0x40(r1)
+stw r0, 0x44(r1)
+stw r3, 0x2C(r1)
+stw r4, 0x28(r1)
+stw r5, 0x24(r1)
+stw r6, 0x20(r1)
+stw r7, 0x1C(r1)
+stw r8, 0x18(r1)
+stw r9, 0x14(r1)
+stw r10, 0x10(r1)
+stw r11, 0x0C(r1)
+stw r12, 0x08(r1)
+mfcr r0
+stw r0, 0x30(r1)
+mfctr r0
+stw r0, 0x34(r1)
+
+; PS5 physics: bettervr.json's playerOnce (default on) takes the due word that the right-eye pass armed.
+; The update runs once a game frame, whichever pass or core asks first after the arm, and a late call still
+; consumes its frame's due. playerOnce=0 keeps upstream's right-eye check exactly. The host hook only
+; records the side, frame, due frame and core, and returns run/skip in r3.
+;
+; The take, the host hook and the branch are new code between 0x037FFE34 and the bctrl into 0x0344CECC.
+; Upstream's hook has only changed r3 (the updater address, then reloaded from 0x1C), CTR (the updater)
+; and CR0 (cmpwi currentEyeSide) at the call; every other register and CR field is still the caller's.
+; The frame above saves the caller's r3-r12, CR and CTR so the run path can put them back before bctrl.
+li r6, 0
+lis r3, playerOnceEnabled@ha
+lwz r3, playerOnceEnabled@l(r3)
+cmpwi r3, 0
+beq upstream_OnlyRunPlayerUpdateJobOnce
 
+lis r4, playerVelocityUpdateDue@ha
+addi r4, r4, playerVelocityUpdateDue@l
+takePlayerVelocityUpdate:
+lwarx r3, 0, r4
+cmpwi r3, 0
+beq record_PlayerUpdateGate
+li r5, 0
+stwcx. r5, 0, r4
+bne takePlayerVelocityUpdate
+li r6, 1
+b record_PlayerUpdateGate
+
+upstream_OnlyRunPlayerUpdateJobOnce:
 lis r3, currentEyeSide@ha
 lwz r3, currentEyeSide@l(r3)
 cmpwi r3, 0
-beq exit_OnlyRunPlayerUpdateJobOnce
+beq record_PlayerUpdateGate
+li r6, 1
 
+record_PlayerUpdateGate:
+lis r3, currentEyeSide@ha
+lwz r3, currentEyeSide@l(r3)
+lis r4, physFrameCounter@ha
+lwz r4, physFrameCounter@l(r4)
+lis r5, playerVelocityUpdateDueFrame@ha
+lwz r5, playerVelocityUpdateDueFrame@l(r5)
+bla import.coreinit.hook_PlayerUpdateGate
+cmpwi r3, 0
+beq skip_PlayerUpdateGate
+
+; Run: restore the caller's r4-r12 and CR1-CR7, then set r3, CR0 and CTR exactly as upstream does.
+lwz r4, 0x28(r1)
+lwz r5, 0x24(r1)
+lwz r6, 0x20(r1)
+lwz r7, 0x1C(r1)
+lwz r8, 0x18(r1)
+lwz r9, 0x14(r1)
+lwz r10, 0x10(r1)
+lwz r11, 0x0C(r1)
+lwz r12, 0x08(r1)
+lwz r3, 0x30(r1)
+mtcrf 0xFF, r3
+lis r3, currentEyeSide@ha
+lwz r3, currentEyeSide@l(r3)
+cmpwi r3, 0
 lis r3, originalPlayerVelocityUpdater@ha
 addi r3, r3, originalPlayerVelocityUpdater@l
 mtctr r3
-lwz r3, 0x1C(r1)
+lwz r3, 0x2C(r1)
+lwz r0, 0x44(r1)
 bctrl
 
-exit_OnlyRunPlayerUpdateJobOnce:
-lwz r5, 0x14(r1)
-lwz r4, 0x18(r1)
-lwz r3, 0x1C(r1)
-lwz r0, 0x24(r1)
-addi r1, r1, 0x20
+; Upstream's exit after the update: put back r3-r5 and r0; the callee owns r6-r12 and CR1-CR7.
+lwz r5, 0x24(r1)
+lwz r4, 0x28(r1)
+lwz r3, 0x2C(r1)
+lwz r0, 0x44(r1)
+addi r1, r1, 0x40
+mtlr r0
+blr
+
+skip_PlayerUpdateGate:
+; Upstream's skip leaves the caller's registers and CTR alone and only the side cmpwi in CR0. Put back
+; r3-r12, CR1-CR7 and CTR; CR0 is the run/skip cmpwi (0 here), which is upstream's EQ for side 0.
+lwz r3, 0x2C(r1)
+lwz r4, 0x28(r1)
+lwz r5, 0x24(r1)
+lwz r6, 0x20(r1)
+lwz r7, 0x1C(r1)
+lwz r8, 0x18(r1)
+lwz r9, 0x14(r1)
+lwz r10, 0x10(r1)
+lwz r11, 0x0C(r1)
+lwz r12, 0x08(r1)
+lwz r0, 0x30(r1)
+mtcrf 0x7F, r0
+lwz r0, 0x34(r1)
+mtctr r0
+lwz r0, 0x44(r1)
+addi r1, r1, 0x40
 mtlr r0
 blr
 
