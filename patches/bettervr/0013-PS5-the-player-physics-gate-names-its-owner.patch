index da08cce..c04314d 100644
--- a/resources/BreathOfTheWild_BetterVR/patch_CTRL_EntityController.asm
+++ b/resources/BreathOfTheWild_BetterVR/patch_CTRL_EntityController.asm
@@ -28,6 +28,16 @@ stw r0, 0x184(r1)
 stw r30, 0x14(r1)
 stw r31, 0x18(r1)
 
+; PS5 physics diagnosis: the updater's tail, at the same site as the roomscale hook, with its core, eye and frame
+lis r3, currentEyeSide@ha
+lwz r3, currentEyeSide@l(r3)
+lis r4, physFrameCounter@ha
+lwz r4, physFrameCounter@l(r4)
+lis r5, lastRightPassFrame@ha
+lwz r5, lastRightPassFrame@l(r5)
+bla import.coreinit.hook_PlayerUpdateTail
+lwz r31, 0x18(r1)
+
 mr r3, r31
 addi r4, r1, RoomscaleScratch
 bla import.coreinit.hook_BeginRoomscaleMovement
