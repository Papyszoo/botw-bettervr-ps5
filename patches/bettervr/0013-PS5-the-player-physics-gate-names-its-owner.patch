 .../patch_RND_StereoRendering.asm             |  23 ++
 .../patch_RND_StereoRendering_ActorJobs.asm   |   7 +
 src/hooking/cemu_hooks.h                      |   7 +
 src/hooking/controls.cpp                      |   1 +
 src/hooking/entity_controller.cpp             | 270 ++++++++++++++++++
 6 files changed, 318 insertions(+)

