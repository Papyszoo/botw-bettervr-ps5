diff --git a/src/hooking/entity_controller.cpp b/src/hooking/entity_controller.cpp
index ef3e57f..11f6353 100644
--- a/src/hooking/entity_controller.cpp
+++ b/src/hooking/entity_controller.cpp
@@ -92,6 +92,109 @@ enum class RoomscaleBodyDriveMode : uint8_t {
 uint32_t g_diagRoomscaleBegin = 0, g_diagRoomscaleCast = 0, g_diagRoomscaleWarp = 0;
 bool g_diagRoomscaleEnabled = true;
 
+// PS5 physics diagnosis (controls.cpp [phys]): the player's velocity updater runs in a job on one of the
+// PPC cores, so its entry (OnlyRunPlayerUpdateJobOnce's gate) and its tail (the roomscale hook's site) are
+// counted with the core, the eye side and the game frame. A frame's bin is finished a few frames after the
+// main thread has passed it, because a late job can still arrive. Logging only; nothing here changes a run.
+constexpr uint32_t kPhysFrameBins = 256;
+constexpr uint32_t kPhysFrameMargin = 16; // frames still possibly in flight when a [phys] line is written
+struct PhysFrameBin {
+    uint32_t frame = 0xFFFFFFFF;
+    uint16_t calls = 0;
+    uint16_t runs = 0;
+    uint16_t tails = 0;
+    uint16_t seenCalls[2] = {};
+    uint16_t seenRuns[2] = {};
+    uint16_t expectedRuns[2] = {};
+    uint16_t expectedSkips[2] = {};
+    uint16_t coreCalls[3] = {};
+    uint16_t coreRuns[3] = {};
+    uint16_t coreTails[3] = {};
+    uint32_t lagSum = 0;
+    uint32_t lagCount = 0;
+    uint16_t lagMin = 0xFFFF;
+    uint16_t lagMax = 0;
+    uint32_t gapSum = 0;
+    uint32_t gapCount = 0;
+    uint16_t gapMin = 0xFFFF;
+    uint16_t gapMax = 0;
+};
+struct PhysDiagnostics {
+    std::mutex mutex;
+    PhysFrameBin bins[kPhysFrameBins];
+    uint32_t mainFrame = 0;
+    uint32_t finalizedFrame = 0;
+    bool hasFinalized = false;
+    uint32_t lastCallFrame = 0;
+    bool hasCall = false;
+    uint32_t zeroRunStreak = 0;
+    uint32_t zeroRunMax = 0; // longest run of frames with no updater run, since boot
+    uint32_t lateCalls = 0; // a job older than the line's margin: the queue is more than a second behind
+    uint32_t lateRuns = 0;
+    std::atomic<int> mode{-1}; // -1 unknown, 0 upstream's eye check, 1 bettervr.json's playerOnce
+};
+static PhysDiagnostics s_phys;
+
+static void RecordPhysGate(uint32_t core, uint32_t eye, uint32_t frame, uint32_t lastRightPass, bool run) {
+    const uint32_t seen = eye != 0 ? 1 : 0;
+    const uint32_t expected = frame == lastRightPass ? 1 : 0; // the pass that dispatched the job
+    const uint32_t lag = frame >= lastRightPass ? frame - lastRightPass : 0;
+
+    std::lock_guard lock(s_phys.mutex);
+    // A call for a frame whose bin was already written must not reset a newer frame's bin (the modulo
+    // repeats every 256 frames); count it as late instead. The line's margin makes this rare.
+    if (s_phys.hasFinalized && frame <= s_phys.finalizedFrame) {
+        s_phys.lateCalls++;
+        if (run) s_phys.lateRuns++;
+        return;
+    }
+    PhysFrameBin& bin = s_phys.bins[frame % kPhysFrameBins];
+    if (bin.frame != frame) {
+        bin = PhysFrameBin{};
+        bin.frame = frame;
+    }
+    bin.calls++;
+    bin.seenCalls[seen]++;
+    if (run) {
+        bin.runs++;
+        bin.seenRuns[seen]++;
+        bin.expectedRuns[expected]++;
+    }
+    else {
+        bin.expectedSkips[expected]++;
+    }
+    if (core < 3) {
+        bin.coreCalls[core]++;
+        if (run) bin.coreRuns[core]++;
+    }
+    bin.lagSum += lag;
+    bin.lagCount++;
+    if (lag < bin.lagMin) bin.lagMin = (uint16_t)lag;
+    if (lag > bin.lagMax) bin.lagMax = (uint16_t)lag;
+    if (!s_phys.hasCall || frame >= s_phys.lastCallFrame) {
+        if (s_phys.hasCall) {
+            const uint32_t gap = frame - s_phys.lastCallFrame;
+            bin.gapSum += gap;
+            bin.gapCount++;
+            if (gap < bin.gapMin) bin.gapMin = (uint16_t)gap;
+            if (gap > bin.gapMax) bin.gapMax = (uint16_t)gap;
+        }
+        s_phys.lastCallFrame = frame;
+        s_phys.hasCall = true;
+    }
+}
+
+static void RecordPhysTail(uint32_t core, uint32_t frame) {
+    std::lock_guard lock(s_phys.mutex);
+    PhysFrameBin& bin = s_phys.bins[frame % kPhysFrameBins];
+    if (bin.frame != frame) {
+        bin = PhysFrameBin{};
+        bin.frame = frame;
+    }
+    bin.tails++;
+    if (core < 3) bin.coreTails[core]++;
+}
+
 static RoomscaleState s_roomscaleState;
 static std::atomic<float> s_roomscaleFadeAmount = 0.0f;
 static RoomscaleBodyDriveMode s_roomscaleBodyDriveMode = RoomscaleBodyDriveMode::DisabledNotInGame;
@@ -812,6 +915,173 @@ void CemuHooks::hook_BeginRoomscaleMovement(PPCInterpreter_t* hCPU) {
     BetterVRProfiler::BeginSpan(BetterVRProfiler::Section::RoomscaleResolve);
 }
 
+void CemuHooks::hook_PhysFrame(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    std::lock_guard lock(s_phys.mutex);
+    s_phys.mainFrame = hCPU->gpr[3];
+}
+
+void CemuHooks::hook_PlayerUpdateGate(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+
+    const uint32_t eye = hCPU->gpr[3];
+    const uint32_t frame = hCPU->gpr[4];
+    const uint32_t lastRightPass = hCPU->gpr[5];
+    const uint32_t core = hCPU->sprNew.UPIR;
+
+    // PS5: bettervr.json {"playerOnce":1} makes this gate one run a game frame, whichever pass or core
+    // asks first. The latch is the frame itself (physFrameCounter is increased where currentFrameCounter
+    // is), so it clears at the frame boundary without another write. Default off: upstream's right eye.
+    static const bool s_playerOnce = BetterVR_PS5_Setting("playerOnce", 0.0f) >= 0.5f;
+    static std::atomic<uint32_t> s_lastRunFrame{0xFFFFFFFFu};
+    s_phys.mode.store(s_playerOnce ? 1 : 0, std::memory_order_relaxed);
+
+    bool run = false;
+    if (s_playerOnce) {
+        uint32_t last = s_lastRunFrame.load(std::memory_order_relaxed);
+        while ((int32_t)(frame - last) > 0) {
+            if (s_lastRunFrame.compare_exchange_weak(last, frame, std::memory_order_relaxed)) {
+                run = true;
+                break;
+            }
+        }
+    }
+    else {
+        run = eye != 0;
+    }
+
+    hCPU->gpr[3] = run ? 1 : 0;
+    RecordPhysGate(core, eye, frame, lastRightPass, run);
+}
+
+void CemuHooks::hook_PlayerUpdateTail(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    RecordPhysTail(hCPU->sprNew.UPIR, hCPU->gpr[4]);
+}
+
+void CemuHooks::LogPhysicsDiagnostics(bool inGame) {
+    static auto s_lastLine = std::chrono::steady_clock::now();
+    static auto s_start = s_lastLine;
+    static uint32_t s_lines = 0;
+    static bool s_wasInGame = false;
+    if (!inGame) {
+        s_wasInGame = false;
+        return;
+    }
+    if (s_lines >= 1200)
+        return;
+    const auto now = std::chrono::steady_clock::now();
+    if (!s_wasInGame) {
+        // Start at the first in-game frame: the title and loading screens are not a physics sample.
+        s_wasInGame = true;
+        s_lastLine = s_start = now;
+        std::lock_guard lock(s_phys.mutex);
+        s_phys.finalizedFrame = s_phys.mainFrame;
+        s_phys.hasFinalized = false;
+        s_phys.zeroRunStreak = s_phys.zeroRunMax = 0;
+        s_phys.lateCalls = s_phys.lateRuns = 0;
+        s_phys.hasCall = false;
+        return;
+    }
+    if (now - s_lastLine < std::chrono::seconds(2))
+        return;
+
+    uint32_t frames = 0, calls = 0, runs = 0, tails = 0;
+    uint32_t callHist[4] = {}, runHist[4] = {}, tailHist[4] = {};
+    uint32_t seenRuns[2] = {}, seenCalls[2] = {};
+    uint32_t expectedRuns[2] = {}, expectedSkips[2] = {};
+    uint32_t coreCalls[3] = {}, coreRuns[3] = {}, coreTails[3] = {};
+    uint32_t lagMin = 0xFFFFFFFF, lagMax = 0, lagCount = 0;
+    uint64_t lagSum = 0;
+    uint32_t gapMin = 0xFFFFFFFF, gapMax = 0, gapCount = 0;
+    uint64_t gapSum = 0;
+    uint32_t zeroRunMax = 0;
+    uint32_t lateCalls = 0, lateRuns = 0;
+
+    {
+        std::lock_guard lock(s_phys.mutex);
+        const uint32_t upto = s_phys.mainFrame > kPhysFrameMargin ? s_phys.mainFrame - kPhysFrameMargin : 0;
+        for (uint32_t frame = s_phys.finalizedFrame + 1; frame <= upto; frame++) {
+            const PhysFrameBin& bin = s_phys.bins[frame % kPhysFrameBins];
+            const bool hasBin = bin.frame == frame;
+            const uint32_t callCount = hasBin ? bin.calls : 0;
+            const uint32_t runCount = hasBin ? bin.runs : 0;
+            const uint32_t tailCount = hasBin ? bin.tails : 0;
+            frames++;
+            calls += callCount;
+            runs += runCount;
+            tails += tailCount;
+            callHist[callCount > 3 ? 3 : callCount]++;
+            runHist[runCount > 3 ? 3 : runCount]++;
+            tailHist[tailCount > 3 ? 3 : tailCount]++;
+            if (hasBin) {
+                for (int side = 0; side < 2; side++) {
+                    seenCalls[side] += bin.seenCalls[side];
+                    seenRuns[side] += bin.seenRuns[side];
+                    expectedRuns[side] += bin.expectedRuns[side];
+                    expectedSkips[side] += bin.expectedSkips[side];
+                }
+                for (int core = 0; core < 3; core++) {
+                    coreCalls[core] += bin.coreCalls[core];
+                    coreRuns[core] += bin.coreRuns[core];
+                    coreTails[core] += bin.coreTails[core];
+                }
+                lagSum += bin.lagSum;
+                lagCount += bin.lagCount;
+                if (bin.lagCount && bin.lagMin < lagMin) lagMin = bin.lagMin;
+                if (bin.lagMax > lagMax) lagMax = bin.lagMax;
+                gapSum += bin.gapSum;
+                gapCount += bin.gapCount;
+                if (bin.gapCount && bin.gapMin < gapMin) gapMin = bin.gapMin;
+                if (bin.gapMax > gapMax) gapMax = bin.gapMax;
+            }
+            if (runCount == 0) {
+                s_phys.zeroRunStreak++;
+                if (s_phys.zeroRunStreak > s_phys.zeroRunMax) s_phys.zeroRunMax = s_phys.zeroRunStreak;
+            }
+            else {
+                s_phys.zeroRunStreak = 0;
+            }
+        }
+        lateCalls = s_phys.lateCalls;
+        lateRuns = s_phys.lateRuns;
+        s_phys.finalizedFrame = upto;
+        if (frames > 0) {
+            s_phys.hasFinalized = true;
+            s_phys.lateCalls = s_phys.lateRuns = 0;
+        }
+        zeroRunMax = s_phys.zeroRunMax;
+    }
+
+    if (frames == 0)
+        return;
+    s_lastLine = now;
+    s_lines++;
+    const double seconds = std::chrono::duration<double>(now - s_start).count();
+    const int mode = s_phys.mode.load(std::memory_order_relaxed);
+    const char* modeName = mode == 1 ? "once" : mode == 0 ? "upstream" : "?";
+    const uint32_t lagAvg = lagCount ? (uint32_t)((lagSum + lagCount / 2) / lagCount) : 0;
+    const uint32_t gapAvg = gapCount ? (uint32_t)((gapSum + gapCount / 2) / gapCount) : 0;
+
+    // One bounded line (2 s, at most 1200) with everything the three candidates need: whether the gate is
+    // called every frame (b), which pass it sees (a, through seen/expected), and whether the updater reaches
+    // its tail when the gate lets it in (c, runs against tails).
+    Log::print<INFO>("[phys] t={:.1f} frames={} mode={} calls={} runs={} tails={} calls/f 0:{} 1:{} 2:{} 3+:{} runs/f 0:{} 1:{} 2:{} 3+:{} tails/f 0:{} 1:{} 2:{} 3+:{} "
+        "seen L r/s={}/{} R r/s={}/{} expR r/s={}/{} expL r/s={}/{} lag {}/{}/{} gap {}/{}/{} late {}/{} zero-run max {} "
+        "cores call 0:{} 1:{} 2:{} run 0:{} 1:{} 2:{} tail 0:{} 1:{} 2:{}",
+        seconds, frames, modeName, calls, runs, tails,
+        callHist[0], callHist[1], callHist[2], callHist[3],
+        runHist[0], runHist[1], runHist[2], runHist[3],
+        tailHist[0], tailHist[1], tailHist[2], tailHist[3],
+        seenRuns[0], seenCalls[0] - seenRuns[0], seenRuns[1], seenCalls[1] - seenRuns[1],
+        expectedRuns[1], expectedSkips[1], expectedRuns[0], expectedSkips[0],
+        lagCount ? lagMin : 0, lagAvg, lagMax,
+        gapCount ? gapMin : 0, gapAvg, gapMax, lateCalls, lateRuns, zeroRunMax,
+        coreCalls[0], coreCalls[1], coreCalls[2],
+        coreRuns[0], coreRuns[1], coreRuns[2],
+        coreTails[0], coreTails[1], coreTails[2]);
+}
+
 void CemuHooks::hook_PrepareRoomscaleRaycast(PPCInterpreter_t* hCPU) {
     hCPU->instructionPointer = hCPU->sprNew.LR;
     uint32_t scratchPtr = hCPU->gpr[3];
