+// What the last first-person frame put in Skl_Root. The view was built from the camera hook's pose, so a frame
+// whose actor, model or hand pose is skipped must still draw that root, not the game's stale anim pose.
+struct LatchedBodyRoot {
+    bool valid = false;
+    glm::vec3 position = glm::vec3(0.0f);
+    glm::fquat yaw = glm::identity<glm::fquat>();
+    glm::fquat viewYaw = glm::identity<glm::fquat>();
+    float bodyViewYawDelta = 0.0f;
+};
+static LatchedBodyRoot s_latchedBodyRoot;
+static std::chrono::steady_clock::time_point s_bodyRootLastDeltaLog{};
+static std::chrono::steady_clock::time_point s_bodyRootLastSkipLog{};
+static uint32_t s_bodyRootSkips = 0;
+static const char* s_bodyRootFirstSkip = nullptr;
+static const char* s_bodyRootLastSkip = nullptr;
+
+static float YawDeltaDegrees(const glm::fquat& bodyYaw, const glm::fquat& viewYaw) {
+    const glm::fquat delta = bodyYaw * glm::inverse(viewYaw);
+    float degrees = glm::degrees(2.0f * std::atan2(delta.y, delta.w));
+    while (degrees > 180.0f)
+        degrees -= 360.0f;
+    while (degrees < -180.0f)
+        degrees += 360.0f;
+    return degrees;
+}
+
+static void LogBodyRootSkip(const char* reason, bool wroteLast, float gameYawDelta, float latchedYawDelta) {
+    ++s_bodyRootSkips;
+    if (s_bodyRootFirstSkip == nullptr)
+        s_bodyRootFirstSkip = reason;
+    s_bodyRootLastSkip = reason;
+
+    const auto now = std::chrono::steady_clock::now();
+    if (now - s_bodyRootLastSkipLog < std::chrono::seconds(1))
+        return;
+    s_bodyRootLastSkipLog = now;
+
+    if (s_bodyRootFirstSkip == s_bodyRootLastSkip)
+        Log::print<INFO>("[pose] first-person body root {} ({} x {}); game body-view yaw delta {:.1f} deg (latched {:.1f} deg)",
+            wroteLast ? "kept the last good frame" : "not latched yet", s_bodyRootSkips, reason, gameYawDelta, latchedYawDelta);
+    else
+        Log::print<INFO>("[pose] first-person body root {} ({} x {}, {} to {}); game body-view yaw delta {:.1f} deg (latched {:.1f} deg)",
+            wroteLast ? "kept the last good frame" : "not latched yet", s_bodyRootSkips, s_bodyRootFirstSkip, s_bodyRootFirstSkip, s_bodyRootLastSkip,
+            gameYawDelta, latchedYawDelta);
+    s_bodyRootSkips = 0;
+    s_bodyRootFirstSkip = nullptr;
+}
+
+static void LogBodyRootDelta(float yawDelta) {
+    // a pending skip says more than the delta, and its line carries the last latched delta too
+    if (s_bodyRootSkips > 0)
+        return;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - s_bodyRootLastDeltaLog < std::chrono::seconds(1))
+        return;
+    s_bodyRootLastDeltaLog = now;
+    Log::print<INFO>("[pose] first-person body-view yaw delta {:.1f} deg", yawDelta);
+}
+
+static void WriteLatchedBodyRoot(const std::string& boneName, uint32_t matrixPtr, uint32_t scalePtr, const char* reason) {
+    if (boneName != "Skl_Root" || IsThirdPersonForPose(true))
+        return;
+    if (!s_latchedBodyRoot.valid) {
+        LogBodyRootSkip(reason, false, 0.0f, 0.0f);
+        return;
+    }
+
+    const BEMatrix34 gameRoot = Guest::Get<BEMatrix34>(matrixPtr);
+    const float gameYawDelta = YawDeltaDegrees(ExtractPlayerBodyYaw(glm::mat4(gameRoot.getLEMatrix())), s_latchedBodyRoot.viewYaw);
+    const glm::fvec3 scale = Guest::Get<BEVec3>(scalePtr).getLE();
