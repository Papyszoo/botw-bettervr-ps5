+static bool ApplyMagnesisAim(uint32_t action, uint32_t manager, const glm::vec3& playerPos, const glm::vec3& objectPos, const glm::vec3& objectOffset, const glm::vec3& targetOffset);
+
+// PS5: Eye Magnesis and Eye Rune Pick. RuneMgr's selected rune (+0x1D4) is 5 for the camera (upstream); these
+// follow the game's rune order of the two remote bombs, Magnesis, Stasis, Cryonis and the camera.
+static constexpr int32_t MagnesisRune = 2;
+static constexpr int32_t StasisRune = 3;
+static constexpr int32_t CryonisRune = 4;
+
+// a blink keeps the last gaze this long; a longer close is deliberate (PS5VR's eyes-only mode uses the same 0.6 s)
+static constexpr uint64_t EyeGazeHoldNs = 600'000'000;
+// the gaze goes through a low-pass whose cutoff rises with the gaze's speed: a fixation is steadied and a saccade is
+// caught up within a few samples. Hz, Hz for the speed itself, and Hz added per radian per second.
+static constexpr float EyeGazeMinCutoff = 2.0f;
+static constexpr float EyeGazeSpeedCutoff = 5.0f;
+static constexpr float EyeGazeCutoffPerSpeed = 1.0f;
+// the held object follows the eyes, but not their small wander while they rest on it, and the steering never points
+// steeper than this, where the circle of the game's distance would throw the object far up or down
+static const float EyeSteerDeadZone = glm::radians(2.5f);
+static const float EyeSteerMaxPitch = glm::radians(60.0f);
+// the right stick's full push or pull in meters per second, and the nearest a pull brings the object
+static constexpr float EyePushPullSpeed = 6.0f;
+static constexpr float EyeMinDistance = 1.5f;
+// a held body's update, the eyes' steering and the stick each count as current for this long
+static constexpr uint64_t EyeFreshNs = 150'000'000;
+// a hold whose steering paused longer than this starts on the object again
+static constexpr uint64_t EyeSteerRestartNs = 200'000'000;
+
+struct EyeGazeFilter {
+    glm::vec3 direction = glm::vec3(0.0f, 0.0f, -1.0f);
+    glm::vec3 lastSample = glm::vec3(0.0f);
+    float speed = 0.0f;
+    uint64_t lastSampleNs = 0;
+};
+
+static std::mutex s_eyeGazeMutex;
+static EyeGazeFilter s_eyeGaze;
+static std::atomic<uint64_t> s_lastHeldBodyNs = 0;
+static std::atomic<uint64_t> s_lastEyeSteerNs = 0;
+static std::atomic<float> s_pushPullStick = 0.0f;
+static std::atomic<uint64_t> s_pushPullStickNs = 0;
+static glm::vec3 s_eyeSteer = glm::vec3(0.0f, 0.0f, -1.0f);
+static float s_lastEyeDistance = 0.0f;
+static uint64_t s_lastEyeSteerLogNs = 0;
+
+static bool IsFresh(const std::atomic<uint64_t>& stampNs, uint64_t windowNs) {
+    const uint64_t at = stampNs.load();
+    return at != 0 && GetTimeStamp() - at <= windowNs;
+}
+
+static float LowPassShare(float cutoffHz, float dt) {
+    return dt / (dt + 1.0f / (glm::two_pi<float>() * cutoffHz));
+}
+
+static float AngleBetween(const glm::vec3& a, const glm::vec3& b) {
+    return std::acos(glm::clamp(glm::dot(a, b), -1.0f, 1.0f));
+}
+
+static float WrapRadians(float angle) {
+    while (angle > glm::pi<float>()) {
+        angle -= glm::two_pi<float>();
+    }
+    while (angle < -glm::pi<float>()) {
+        angle += glm::two_pi<float>();
+    }
+    return angle;
+}
+
+// the stage-space direction the eyes look along, smoothed, or empty when no valid sample came for EyeGazeHoldNs
+static std::optional<glm::vec3> SampleEyeGaze() {
+    std::scoped_lock lock(s_eyeGazeMutex);
+    const uint64_t now = GetTimeStamp();
+    const std::optional<glm::fvec3> sample = Tracking::EyeGaze();
+    const bool held = s_eyeGaze.lastSampleNs != 0 && now - s_eyeGaze.lastSampleNs <= EyeGazeHoldNs;
+    if (!sample.has_value() || !IsAllFinite(*sample) || glm::length2(*sample) < 0.25f) {
+        return held ? std::optional<glm::vec3>(s_eyeGaze.direction) : std::nullopt;
+    }
+
+    const glm::vec3 direction = glm::normalize(*sample);
+    if (!held) {
+        s_eyeGaze.direction = direction;
+        s_eyeGaze.speed = 0.0f;
+    }
+    else if (direction == s_eyeGaze.lastSample) {
+        // the same sample again (the stream gives about 51 a second)
+        return s_eyeGaze.direction;
+    }
+    else {
+        const float dt = glm::clamp((float)(now - s_eyeGaze.lastSampleNs) * 1.0e-9f, 0.001f, 0.1f);
+        s_eyeGaze.speed += (AngleBetween(s_eyeGaze.direction, direction) / dt - s_eyeGaze.speed) * LowPassShare(EyeGazeSpeedCutoff, dt);
+        const glm::vec3 smoothed = glm::mix(s_eyeGaze.direction, direction, LowPassShare(EyeGazeMinCutoff + EyeGazeCutoffPerSpeed * s_eyeGaze.speed, dt));
+        s_eyeGaze.direction = glm::length2(smoothed) > 0.000001f ? glm::normalize(smoothed) : direction;
+    }
+    s_eyeGaze.lastSample = direction;
+    s_eyeGaze.lastSampleNs = now;
+    return s_eyeGaze.direction;
+}
+
+std::optional<glm::fvec3> Magnesis::GetPickGaze() {
+    // the rune the game has out is what makes a bad pick index visible, so say it whether or not a row is on
+    const int32_t rune = GameState::GetActiveRune();
+    static int32_t s_loggedRune = -1;
+    if (rune != s_loggedRune) {
+        Log::print<INFO>("[magnesis] rune out: {} (Magnesis {}, Stasis {}, Cryonis {})", rune, MagnesisRune, StasisRune, CryonisRune);
+        if (rune == CryonisRune && GetSettings().eyeRunePick) {
+            Log::print<INFO>("[magnesis] Cryonis places its pillar from the camera's ray, not from the screen point this pick moves; Eye Rune Pick leaves Cryonis to the camera");
+        }
+        s_loggedRune = rune;
+    }
+
+    if (!GetSettings().eyeMagnesis && !GetSettings().eyeRunePick) {
+        return std::nullopt;
+    }
+
+    // a held object is steered, not picked; the pick is Stasis's, and Magnesis's while its row or Eye Rune Pick is on
+    const bool magnesis = rune == MagnesisRune && (GetSettings().eyeMagnesis || GetSettings().eyeRunePick) && !IsFresh(s_lastHeldBodyNs, EyeFreshNs);
+    const bool stasis = rune == StasisRune && GetSettings().eyeRunePick;
+    std::optional<glm::vec3> gaze;
+    if ((magnesis || stasis) && GameState::IsFirstPerson()) {
+        gaze = SampleEyeGaze();
+    }
+
+    static bool s_wasPicking = false;
+    if (gaze.has_value() != s_wasPicking) {
+        Log::print<INFO>("[magnesis] eye pick {} (rune {})", gaze.has_value() ? "on" : "off", rune);
+        s_wasPicking = gaze.has_value();
+    }
+    return gaze;
+}
+
+bool Magnesis::IsSteeringByGaze() {
+    return IsFresh(s_lastEyeSteerNs, EyeFreshNs);
+}
+
+void Magnesis::SetPushPullStick(float stickY) {
+    s_pushPullStick = std::isfinite(stickY) ? glm::clamp(stickY, -1.0f, 1.0f) : 0.0f;
+    s_pushPullStickNs = GetTimeStamp();
+}
+
+// With Eye Magnesis on and a gaze sample, the hold point is where the steering ray meets the circle of the game's own
+// distance around the player: the eyes set the direction and the height, the right stick's up/down the distance.
+// The steering starts on the object and follows the eyes beyond EyeSteerDeadZone; ApplyMagnesisAim keeps it inside
+// the game's release thresholds, so the object chases the point rather than jumping to it.
+static bool DriveMagnesisAimFromGaze(uint32_t action, uint32_t manager, float gameDistance, const glm::vec3& playerPos, const glm::vec3& objectPos, const glm::vec3& objectOffset) {
+    if (!GetSettings().eyeMagnesis || !GameState::IsFirstPerson() || !IsFresh(s_lastHeldBodyNs, EyeFreshNs)) {
+        return false;
+    }
+
+    const std::optional<glm::vec3> gaze = SampleEyeGaze();
+    glm::vec3 headPos = glm::vec3(0.0f);
+    glm::vec3 gazeDirection = glm::vec3(0.0f, 0.0f, -1.0f);
+    if (!gaze.has_value() || !HandAim::TryGetGazeWorldRay(gaze.value(), headPos, gazeDirection)) {
+        return false;
+    }
+
+    const uint64_t now = GetTimeStamp();
+    const uint64_t lastSteerNs = s_lastEyeSteerNs.load();
+    const bool restarted = lastSteerNs == 0 || now - lastSteerNs > EyeSteerRestartNs;
+    const float dt = restarted ? 0.0f : std::min((float)(now - lastSteerNs) * 1.0e-9f, 0.05f);
+    if (restarted) {
+        const glm::vec3 headToObject = objectPos - headPos;
+        s_eyeSteer = glm::length2(headToObject) > 0.0001f ? glm::normalize(headToObject) : gazeDirection;
+    }
+
+    const float offAngle = AngleBetween(s_eyeSteer, gazeDirection);
+    glm::vec3 steer = s_eyeSteer;
+    if (offAngle > EyeSteerDeadZone) {
+        const glm::vec3 axis = glm::cross(s_eyeSteer, gazeDirection);
+        steer = glm::length2(axis) > 1.0e-10f ? glm::normalize(glm::angleAxis(offAngle - EyeSteerDeadZone, glm::normalize(axis)) * s_eyeSteer) : gazeDirection;
+    }
+    const float horizontal = glm::length(glm::vec2(steer.x, steer.z));
+    if (horizontal < 0.0001f) {
+        steer = s_eyeSteer;
+    }
+    else if (std::abs(std::atan2(steer.y, horizontal)) > EyeSteerMaxPitch) {
+        const float pitch = std::copysign(EyeSteerMaxPitch, steer.y);
+        steer = glm::vec3(steer.x / horizontal * std::cos(pitch), std::sin(pitch), steer.z / horizontal * std::cos(pitch));
+    }
+    s_eyeSteer = steer;
+
+    // the stick pushes or pulls on the game's own distance, which the game keeps inside its magnesis range
+    const float stick = IsFresh(s_pushPullStickNs, EyeFreshNs) ? s_pushPullStick.load() : 0.0f;
+    const float pushPull = stick * std::abs(stick) * EyePushPullSpeed * dt;
+    const float distance = pushPull < 0.0f ? std::max(gameDistance + pushPull, std::min(gameDistance, EyeMinDistance)) : gameDistance + pushPull;
+
+    const glm::vec2 headOffset = glm::vec2(headPos.x - playerPos.x, headPos.z - playerPos.z);
+    const glm::vec2 steerFlat = glm::vec2(steer.x, steer.z);
+    const float a = glm::dot(steerFlat, steerFlat);
+    const float b = 2.0f * glm::dot(headOffset, steerFlat);
+    const float c = glm::dot(headOffset, headOffset) - distance * distance;
+    const float discriminant = b * b - 4.0f * a * c;
+    if (a < 0.0001f || discriminant < 0.0f) {
+        return false;
+    }
+    const float along = (-b + std::sqrt(discriminant)) / (2.0f * a);
+    if (!std::isfinite(along) || along <= 0.0f) {
+        return false;
+    }
+
+    const glm::vec3 targetOffset = headPos + steer * along - playerPos;
+    if (!ApplyMagnesisAim(action, manager, playerPos, objectPos, objectOffset, targetOffset)) {
+        return false;
+    }
+
+    if (restarted) {
+        Log::print<INFO>("[magnesis] eye steering on (distance {:.2f})", gameDistance);
+    }
+    if (now - s_lastEyeSteerLogNs >= 500'000'000) {
+        s_lastEyeSteerLogNs = now;
+        Log::print<INFO>("[magnesis] eye steer: gaze off {:.1f} deg, distance game {:.2f} (wrote {:.2f}) now {:.2f}, stick {:.2f}, height {:.2f}",
+            glm::degrees(offAngle), gameDistance, restarted ? gameDistance : s_lastEyeDistance, distance, stick, targetOffset.y);
+    }
+    s_lastEyeDistance = distance;
+    s_lastEyeSteerNs = now;
+    return true;
+}
+
 static bool DriveMagnesisAimFromController(uint32_t action) {
     const uint32_t manager = Guest::Get<BEType<uint32_t>>(MagneManagerInstanceAddress).getLE();
     if (!IsPlausiblePPCPointer(manager)) {
@@ -147,6 +363,13 @@ static bool DriveMagnesisAimFromController(uint32_t action) {
         return false;
     }
 
+    // PS5: Eye Magnesis aims by the eyes; without a gaze sample the hand aims as before, and a grip squeezed while
+    // the eyes steered starts the hand's aim afresh
+    if (DriveMagnesisAimFromGaze(action, manager, gameDistance, playerPos, objectPos, objectOffset)) {
+        s_aimGripHeld = false;
+        return true;
+    }
+
     const OpenXR::InputState inputs = Tracking::Hands();
     glm::vec3 handPos = glm::vec3(0.0f);
     glm::vec3 handForward = glm::vec3(0.0f, 0.0f, -1.0f);
@@ -175,7 +398,7 @@ static bool DriveMagnesisAimFromController(uint32_t action) {
         return false;
     }
 
