     if (GetSettings().GetHapticsGain(category) <= 0.0f)
-        return;
+        return false;
     RumbleParameters tagged = rumble;
     tagged.category = category;
     if (RumbleManager* manager = GetRumbleManager())
-        manager->enqueueInputsRumbleCommand(tagged);
+        return manager->enqueueInputsRumbleCommand(tagged);
+    return false;
 }
 
