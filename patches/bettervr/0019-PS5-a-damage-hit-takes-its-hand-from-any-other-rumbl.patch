-void Haptics::Play(const RumbleParameters& rumble, HapticCategory category) {
+bool Haptics::Play(const RumbleParameters& rumble, HapticCategory category) {
     // the strength and the on/off are read again for each frame of the envelope (RumbleManager::updateHaptics), so the
