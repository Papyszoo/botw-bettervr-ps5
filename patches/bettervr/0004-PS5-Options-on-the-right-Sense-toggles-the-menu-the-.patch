From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patryk Kowalczyk <papyszoo@gmail.com>
Date: Wed, 18 Nov 2026 10:54:38 +0100
Subject: [PATCH] PS5: Options held for 700 ms opens the menu, a short press is
 the game's pause

- ProcessOptionsButton takes Options (BetterVR_PS5_OptionsDown, the runtime's) or the pad's + on VPAD channel 0 (the
  DualSense) down, held and up edges: held for 700 ms it opens or closes the menu at that moment and the release then
  does nothing; a release that no game frame saw cross the threshold still counts as a hold from the measured time and
  toggles the menu. Released earlier it sends the game's + (the pause screen), one tap, always VPAD_BUTTON_PLUS, as a
  short press of the right stick click sends it, and clears state.mapOpen so the flag cannot steer a later tap to the
  minus. The pad's + is removed from the game's hold while the button is down, so no pause opens behind the menu, and
  ToggleModMenuOnLongStartPress no longer runs on the PS5. The tap is dropped only while the menu's overlay blocks the
  game: a tap within the game's own 400 ms input block still reaches it, as the physical + did. The Sense's Options
  and the pad's + keep their own state, so one cannot swallow the other's press. [menu] lines log each step. The
  Touch profile gives the Sense's button no action, and the left X (Square) long press stays.
- When no Sense controller is connected (the runtime's connection state, not whether a pose is active), the VPAD's
  left and right sticks are added to the mod menu's navigation, so a pad-only player can move the cursor (upstream
  issue #117).
- The first-run prompt is not drawn on the PS5.
- PlayPosition defaults to Seated on the PS5 (the tracker's origin is not known to be the floor), and the first in-game
  frame requests the calibration when the loading screen passed before the session existed.
---
 src/game/botw/input/controls.cpp | 86 +++++++++++++++++++++++++++++++-
 src/rendering/imgui_menus.cpp    |  6 +++
 src/rendering/openxr.cpp         | 11 ++++
 src/rendering/vulkan_imgui.cpp   | 14 ++++++
 src/utils/mod_settings.h         |  4 ++
 5 files changed, 120 insertions(+), 1 deletion(-)

diff --git a/src/game/botw/input/controls.cpp b/src/game/botw/input/controls.cpp
index 195735a..01766bb 100644
--- a/src/game/botw/input/controls.cpp
+++ b/src/game/botw/input/controls.cpp
@@ -8,6 +8,8 @@
 #include "game/botw/player/player.h"
 #include "game/botw/player/skeleton.h"
 #include "game/botw/player/weapon.h"
+#include "instance.h"
+#include "rendering/renderer.h"
 #include "rendering/haptics.h"
 #include "rendering/imgui_menus.h"
 #include "rendering/tracking.h"
@@ -964,6 +966,75 @@ static void ProcessInputPrevention(ControlState& state, std::chrono::steady_cloc
         state.preventGrabInputs = false;
 }
 
+#if defined(__PROSPERO__)
+// the runtime's: whether Options on the right Sense controller is down (port/bettervr/xr/runtime.cpp)
+extern "C" bool BetterVR_PS5_OptionsDown();
+
+// Options on the right Sense controller, or the + on the pad (VPAD channel 0, the DualSense): held for 700 ms it opens
+// or closes the menu at that moment, and its release then does nothing; released earlier it is the game's + (the pause
+// screen), sent as one tap, as a short press of the right stick click sends it. The Touch profile gives the Sense's
+// button no action, so that one is read from the runtime. The left X (Square) long press below still works.
+static void ToggleOptionsMenu(std::atomic_bool& isMenuOpen) {
+    RND_Renderer* renderer = VRManager::instance().XR->GetRenderer();
+    if (renderer == nullptr || !renderer->m_imguiOverlay) {
+        Log::print<INFO>("[menu] long press ignored, the menu's overlay is not ready");
+        return;
+    }
+    isMenuOpen = !isMenuOpen;
+    Log::print<INFO>("[menu] long press -> {}", isMenuOpen.load() ? "open" : "closed");
+}
+
+// one input's Options state: the Sense's and the pad's are independent, so one cannot swallow the other's press
+struct OptionsButtonState {
+    bool wasDown = false;
+    bool longPressDone = false;
+    std::chrono::steady_clock::time_point downAt;
+};
+
+static OptionsButtonState s_senseOptions;
+static OptionsButtonState s_padOptions;
+
+static void ProcessOptionsButton(std::atomic_bool& isMenuOpen, uint32_t& buttonHold, ControlState& state, bool down, OptionsButtonState& s) {
+    constexpr auto kLongPress = std::chrono::milliseconds(700);
+    const auto now = std::chrono::steady_clock::now();
+    if (down && !s.wasDown) {
+        s.wasDown = true;
+        s.longPressDone = false;
+        s.downAt = now;
+        Log::print<INFO>("[menu] Options down");
+        return;
+    }
+    if (down && !s.longPressDone && now - s.downAt >= kLongPress) {
+        s.longPressDone = true;
+        ToggleOptionsMenu(isMenuOpen);
+        return;
+    }
+    if (down || !s.wasDown)
+        return;
+    s.wasDown = false;
+    const auto heldMs = std::chrono::duration_cast<std::chrono::milliseconds>(now - s.downAt).count();
+    Log::print<INFO>("[menu] Options up after {} ms", (long long)heldMs);
+    if (s.longPressDone)
+        return;
+    // a stall can hide the threshold from every game frame: the release still decides, with the measured time
+    if (now - s.downAt >= kLongPress) {
+        Log::print<INFO>("[menu] release after the threshold -> hold");
+        ToggleOptionsMenu(isMenuOpen);
+        return;
+    }
+    // the menu's overlay holds the game's input: no pause behind it. A tap within the game menu's 400 ms input block
+    // still reaches the game, as the physical + did: that block follows the game's own menu state, not this button.
+    if (isMenuOpen || ImGuiMenus::BlocksGameInput()) {
+        Log::print<INFO>("[menu] short press ignored, game input is blocked");
+        return;
+    }
+    Log::print<INFO>("[menu] short press -> pause");
+    // always the game's +: state.mapOpen only steers the stick click in the menus, and it can be stale there
+    state.mapOpen = false;
+    buttonHold |= VPAD_BUTTON_PLUS;
+}
+#endif
+
 static void ProcessModMenuInput(std::atomic_bool& isMenuOpen, OpenXR::InputState& inputs, VPADStatus& vpadInputs, XrActionStateVector2f& leftStickSource, XrActionStateVector2f& rightStickSource)
 {
     if (s_modMenuButton.lastEvent == ButtonState::Event::LongPress) {
@@ -1203,7 +1274,8 @@ static void TraceControlChanges(const ControlState& state, uint32_t buttonHold)
     }
 }
 
-// for players without their VR controllers in reach
+#if !defined(__PROSPERO__)
+// for players without their VR controllers in reach; on the PS5 ProcessOptionsButton handles the pad's + too
 static void ToggleModMenuOnLongStartPress(uint32_t physicalHold) {
     static auto startBtnLastTime = std::chrono::steady_clock::now();
     static bool startBtnWasDown = false;
@@ -1224,6 +1296,7 @@ static void ToggleModMenuOnLongStartPress(uint32_t physicalHold) {
         startBtnWasDown = false;
     }
 }
+#endif
 
 static float ControllerWalkYaw(const glm::fquat& controllerQuat) {
     static float s_lastYaw = 0.0f;
@@ -1375,7 +1448,12 @@ static void hook_InjectXRInput(PPCInterpreter_t* hCPU) {
     if (physicalSampleCount > 0)
         Guest::Read(vpadStatusOffset, &vpadStatus);
 
+#if defined(__PROSPERO__)
+    // read before ProcessModMenuInput zeroes the pad's sample while the menu is open, so a held + can close it again
+    const uint32_t physicalHold = vpadStatus.hold.getLE();
+#else
     ToggleModMenuOnLongStartPress(vpadStatus.hold.getLE());
+#endif
 
     // take the hands and head once so the gestures below all use the same sample
     OpenXR::InputState inputs = Tracking::SampleHands(GameState::IsShowingMenu());
@@ -1414,6 +1492,12 @@ static void hook_InjectXRInput(PPCInterpreter_t* hCPU) {
 
     auto& isMenuOpen = ImGuiMenus::g_isOpen;
     ProcessModMenuInput(isMenuOpen, inputs, vpadStatus, leftStickSource, rightStickSource);
+#if defined(__PROSPERO__)
+    // the pad's + is the same Options press: the game never sees it while it is held, so no pause opens behind the menu
+    vpadStatus.hold = vpadStatus.hold.getLE() & ~static_cast<uint32_t>(VPAD_BUTTON_PLUS);
+    ProcessOptionsButton(isMenuOpen, newXRBtnHold, state, BetterVR_PS5_OptionsDown(), s_senseOptions);
+    ProcessOptionsButton(isMenuOpen, newXRBtnHold, state, (physicalHold & VPAD_BUTTON_PLUS) != 0, s_padOptions);
+#endif
     UpdateGuide(inputs, isMenuOpen);
     HandGestureState leftGesture = {};
     HandGestureState rightGesture = {};
diff --git a/src/rendering/imgui_menus.cpp b/src/rendering/imgui_menus.cpp
