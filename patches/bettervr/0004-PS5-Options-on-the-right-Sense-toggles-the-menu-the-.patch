From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patryk Kowalczyk <papyszoo@gmail.com>
Date: Wed, 18 Nov 2026 10:54:38 +0100
Subject: [PATCH] PS5: Options on the right Sense toggles the menu, the seated
 height is the default and is asked for in game

- ProcessModMenuInput takes Options (BetterVR_PS5_OptionsDown, the runtime's) down and up edges: a press released
  within a second opens or closes the menu, a hold does nothing; [menu] lines log each step. The Touch profile
  gives that button no action, and the left X (Square) long press stays.
- The menu's first-run prompt names Options on the PS5.
- PlayPosition defaults to Seated on the PS5 (the tracker's origin is not known to be the floor), and the first
  in-game frame requests the calibration when the loading screen passed before the session existed.
---
 src/game/botw/input/controls.cpp | 39 ++++++++++++++++++++++++++++++++
 src/rendering/imgui_menus.cpp    |  3 +++
 src/rendering/openxr.cpp         | 11 +++++++++
 src/utils/mod_settings.h         |  4 ++++
 4 files changed, 57 insertions(+)

diff --git a/src/game/botw/input/controls.cpp b/src/game/botw/input/controls.cpp
index 195735a..6b4ee33 100644
--- a/src/game/botw/input/controls.cpp
+++ b/src/game/botw/input/controls.cpp
@@ -8,6 +8,8 @@
 #include "game/botw/player/player.h"
 #include "game/botw/player/skeleton.h"
 #include "game/botw/player/weapon.h"
+#include "instance.h"
+#include "rendering/renderer.h"
 #include "rendering/haptics.h"
 #include "rendering/imgui_menus.h"
 #include "rendering/tracking.h"
@@ -964,11 +966,48 @@ static void ProcessInputPrevention(ControlState& state, std::chrono::steady_cloc
         state.preventGrabInputs = false;
 }
 
+#if defined(__PROSPERO__)
+// the runtime's: whether Options on the right Sense controller is down (port/bettervr/xr/runtime.cpp)
+extern "C" bool BetterVR_PS5_OptionsDown();
+
+// Options on the right Sense controller opens and closes the menu with one short press (released within a second;
+// a hold does nothing). The Touch profile gives that button no action, so it is read from the runtime. The left
+// X (Square) long press below still works.
+static void ToggleModMenuOnOptionsPress(std::atomic_bool& isMenuOpen) {
+    static bool s_wasDown = false;
+    static std::chrono::steady_clock::time_point s_downAt;
+    const bool down = BetterVR_PS5_OptionsDown();
+    if (down == s_wasDown)
+        return;
+    s_wasDown = down;
+    const auto now = std::chrono::steady_clock::now();
+    if (down) {
+        s_downAt = now;
+        Log::print<INFO>("[menu] Options down");
+        return;
+    }
+    const auto heldMs = std::chrono::duration_cast<std::chrono::milliseconds>(now - s_downAt).count();
+    Log::print<INFO>("[menu] Options up after {} ms", (long long)heldMs);
+    RND_Renderer* renderer = VRManager::instance().XR->GetRenderer();
+    if (heldMs >= 1000)
+        return;
+    if (renderer == nullptr || !renderer->m_imguiOverlay) {
+        Log::print<INFO>("[menu] toggle ignored, the menu's overlay is not ready");
+        return;
+    }
+    isMenuOpen = !isMenuOpen;
+    Log::print<INFO>("[menu] toggle -> {}", isMenuOpen.load() ? "open" : "closed");
+}
+#endif
+
 static void ProcessModMenuInput(std::atomic_bool& isMenuOpen, OpenXR::InputState& inputs, VPADStatus& vpadInputs, XrActionStateVector2f& leftStickSource, XrActionStateVector2f& rightStickSource)
 {
     if (s_modMenuButton.lastEvent == ButtonState::Event::LongPress) {
         isMenuOpen = !isMenuOpen;
     }
+#if defined(__PROSPERO__)
+    ToggleModMenuOnOptionsPress(isMenuOpen);
+#endif
 
     ImGuiMenus::ProcessInputs(inputs, vpadInputs);
 
diff --git a/src/rendering/imgui_menus.cpp b/src/rendering/imgui_menus.cpp
index 1b2a6c2..46eaab0 100644
--- a/src/rendering/imgui_menus.cpp
+++ b/src/rendering/imgui_menus.cpp
@@ -1488,6 +1488,9 @@ static const char* GetControllerModMenuPrompt() {
     auto& caps = VRManager::instance().XR->m_capabilities;
     switch (caps.activeControllerType) {
         case ControllerType::OculusTouch:
+#if defined(__PROSPERO__)
+            return "Press the Options button on your right controller to open the mod menu.\nHolding the Square button on your left controller for 1 second works too.";
+#endif
         case ControllerType::Pico4:
         case ControllerType::HPReverbG2:
         case ControllerType::ViveCosmos:
diff --git a/src/rendering/openxr.cpp b/src/rendering/openxr.cpp
index 433b28a..c5a8b4b 100644
--- a/src/rendering/openxr.cpp
+++ b/src/rendering/openxr.cpp
@@ -3,6 +3,7 @@
 #include "openxr.h"
 #include "instance.h"
 #include "game/game.h"
+#include "game/botw/game_state.h"
 #include "cemu/host_window.h"
 #include "cemu/vulkan_loader.h"
 
@@ -529,6 +530,16 @@ void OpenXR::UpdateSeatedHeightCalibration(XrTime predictedDisplayTime, const st
         }
     }
 
+#if defined(__PROSPERO__)
+    // The loading screen above must be up after this renderer exists. The PS5 starts the session after the boot
+    // load, so that screen can pass unseen; ask again on the first in-game frame. The request stays pending until
+    // a valid head pose arrives.
+    if (playMode == PlayMode::SEATED && !m_hasSeatedHeightCalibration && !m_seatedHeightCalibrationRequested.load(std::memory_order_acquire) && GameState::IsInGame()) {
+        Log::print<INFO>("Seated height calibration requested on the first in-game frame");
+        RequestSeatedHeightCalibration();
+    }
+#endif
+
     if (playMode != PlayMode::SEATED) {
         m_seatedHeightCalibrationRequested.store(false, std::memory_order_relaxed);
         if (m_stageFloorOffset != 0.0f) {
diff --git a/src/utils/mod_settings.h b/src/utils/mod_settings.h
index a0017ac..50684ec 100644
--- a/src/utils/mod_settings.h
+++ b/src/utils/mod_settings.h
@@ -565,7 +565,11 @@ struct ModSettings {
 
     EnumSetting<CameraMode> cameraMode{ "CameraMode", CameraMode::FIRST_PERSON };
     // not "PlayMode" so a Seated choice from older builds isn't read
+#if defined(__PROSPERO__) // the tracker's origin is not known to be the floor: calibrate Link's eye height to the head
+    EnumSetting<PlayMode> playMode{ "PlayPosition", PlayMode::SEATED };
+#else
     EnumSetting<PlayMode> playMode{ "PlayPosition", PlayMode::STANDING };
+#endif
     FloatSetting thirdPlayerDistance{ "ThirdPlayerDistance", 0.5f, 0.0f };
     BoolSetting thirdPersonBowCameraAim{ "ThirdPersonBowCameraAim", true };
     EnumSetting<EventMode> cutsceneCameraMode{ "CutsceneCameraMode", EventMode::FOLLOW_DEFAULT_EVENT_SETTINGS };
