--- a/src/rendering/imgui_menus.cpp
+++ b/src/rendering/imgui_menus.cpp
@@ -1551,6 +1551,11 @@ static bool FooterItem(const std::string& label, bool clickable) {
 }
 
 static void DrawTutorialPromptAndControllerVerification(bool isMenuOpen) {
+#if defined(__PROSPERO__)
+    // no popup over the game at start on the PS5: the game's page in the app says how the menu opens
+    (void)isMenuOpen;
+    return;
+#else
     auto& settings = GetSettings();
 
     float alphaForNotify = settings.tutorialPromptShown ? 0.9f : 0.98f;
@@ -1586,6 +1591,7 @@ static void DrawTutorialPromptAndControllerVerification(bool isMenuOpen) {
         }
     }
     ImGui::End();
+#endif
 }
 
 static void DrawUpdateBanner(bool isMenuOpen) {
diff --git a/src/rendering/openxr.cpp b/src/rendering/openxr.cpp
index 433b28a..c5a8b4b 100644
--- a/src/rendering/openxr.cpp
+++ b/src/rendering/openxr.cpp
@@ -3,6 +3,7 @@
 #include "openxr.h"
 #include "instance.h"
 #include "game/game.h"
+#include "game/botw/game_state.h"
 #include "cemu/host_window.h"
 #include "cemu/vulkan_loader.h"
 
@@ -529,6 +530,16 @@ void OpenXR::UpdateSeatedHeightCalibration(XrTime predictedDisplayTime, const st
         }
     }
 
+#if defined(__PROSPERO__)
+    // The loading screen above must be up after this renderer exists. The PS5 starts the session after the boot
+    // load, so that screen can pass unseen; ask again on the first in-game frame. The request stays pending until
+    // a valid head pose arrives.
+    if (playMode == PlayMode::SEATED && !m_hasSeatedHeightCalibration && !m_seatedHeightCalibrationRequested.load(std::memory_order_acquire) && GameState::IsInGame()) {
+        Log::print<INFO>("Seated height calibration requested on the first in-game frame");
+        RequestSeatedHeightCalibration();
+    }
+#endif
+
     if (playMode != PlayMode::SEATED) {
         m_seatedHeightCalibrationRequested.store(false, std::memory_order_relaxed);
         if (m_stageFloorOffset != 0.0f) {
diff --git a/src/rendering/vulkan_imgui.cpp b/src/rendering/vulkan_imgui.cpp
index 6908e66..49eca4b 100644
--- a/src/rendering/vulkan_imgui.cpp
+++ b/src/rendering/vulkan_imgui.cpp
@@ -611,6 +611,20 @@ void RND_Renderer::ImGuiOverlay::ProcessInputs(OpenXR::InputState& inputs, const
         pageRight = inputs.inMenu.rightTrigger.currentState && inputs.inMenu.rightTrigger.changedSinceLastSync;
     }
 
+    // no Sense controller connected: the pad's own left or right stick moves the menu cursor too (upstream #117).
+    // The PS5 asks the runtime whether a hand is connected, not whether it has a pose: a hand without a pose still
+    // feeds navigate and move, so the pad must not join it.
+#if defined(__PROSPERO__)
+    extern "C" bool BetterVR_PS5_SenseConnected();
+    const bool senseConnected = BetterVR_PS5_SenseConnected();
+#else
+    const bool senseConnected = inputs.shared.pose[0].isActive || inputs.shared.pose[1].isActive;
+#endif
+    if (!senseConnected) {
+        stick.currentState.x = std::clamp(stick.currentState.x + vpadStatus.leftStick.x.getLE() + vpadStatus.rightStick.x.getLE(), -1.0f, 1.0f);
+        stick.currentState.y = std::clamp(stick.currentState.y + vpadStatus.leftStick.y.getLE() + vpadStatus.rightStick.y.getLE(), -1.0f, 1.0f);
+    }
+
     uint32_t hold = vpadStatus.hold.getLE();
     backDown |= (hold & VPAD_BUTTON_B) != 0;
     confirmDown |= (hold & VPAD_BUTTON_A) != 0;
