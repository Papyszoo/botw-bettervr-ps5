+                    const int sourceEye = monoPresentation ? 0 : (forcedEye == 1 ? 1 : (forcedEye == 2 ? 0 : eye));
                     if (hasDepth) {
                         auto& di = depthInfos[eye];
                         di.type = XR_TYPE_COMPOSITION_LAYER_DEPTH_INFO_KHR;
@@ -2081,6 +2160,15 @@ void RND_Renderer::EndFrame() {
             s_lastBlackBars = blackBars;
