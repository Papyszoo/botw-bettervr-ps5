+// the presets the pack offers on this headset; the game's resolution preset names carry the
+// multiplier in their " (1x, ...)" part, as the Recording Mode ones do
+static constexpr const char* kVRResolutionLabels[] = { "0.5x", "0.75x", "1x", "1.25x", "1.5x" };
+
+static void DrawVRResolutionSetting() {
+    const std::vector<std::string> presets = CemuHost::GetGraphicsPresets(kResolutionMultiplierCategory);
+    if (presets.empty()) {
+        return;
+    }
+    const std::string current = CemuHost::GetGraphicsPreset(kResolutionMultiplierCategory);
+    int selected = 2; // 1x, the pack's default, when the saved preset is not one of these
+    for (int i = 0; i < (int)std::size(kVRResolutionLabels); i++) {
+        if (current.find(fmt::format(" ({},", kVRResolutionLabels[i])) != std::string::npos) {
+            selected = i;
+            break;
+        }
+    }
+    DrawSetting(ICON_MS_DESKTOP_WINDOWS, "VR Resolution", "Lower runs faster; higher is sharper. Cemu applies it at its next start.", [&]() {
+        if (!Segmented("##vrResolution", kVRResolutionLabels, &selected)) {
+            return;
+        }
+        const std::string suffix = fmt::format(" ({},", kVRResolutionLabels[selected]);
+        for (const std::string& candidate : presets) {
+            if (candidate.find(suffix) == std::string::npos) {
+                continue;
+            }
+            CemuHost::SetGraphicsPreset(kResolutionMultiplierCategory, candidate);
+            Log::print<INFO>("VR resolution preset: {}", candidate);
+            static std::string s_title;
+            s_title = fmt::format("Restart Cemu to switch to {}", kVRResolutionLabels[selected]);
+            // the pack has texture rules, so Cemu's GraphicPack2::RequiresRestart is true for a preset
+            // change: it is saved now and applies at the next start (the same notice as Recording View)
+            RequestRestartNotice(s_title.c_str(), "It's saved and applies the next time you start Cemu.");
+            return;
+        }
+        Log::print<WARNING>("VR resolution: no preset for {} in {}", kVRResolutionLabels[selected], kResolutionMultiplierCategory);
+    });
+}
