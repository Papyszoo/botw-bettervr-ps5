+#if defined(__PROSPERO__)
+// port/app/emulator.cpp, after Cemu has loaded the packs this module registered: one line saying what
+// the game will run with, including the resolution and whether AA is on (the preset names carry both)
+extern "C" void BetterVR_PS5_LogPresets() {
+    std::string presets;
+    for (const char* category : {"VR Resolution Multiplier", "Quality Preset / Performance Hacks", "Anti-Aliasing", "Recording Mode", "Shadows"}) {
+        if (CemuHost::GetGraphicsPresets(category).empty()) {
+            continue;
+        }
+        if (!presets.empty()) {
+            presets += ", ";
+        }
+        presets += fmt::format("{} \"{}\"", category, CemuHost::GetGraphicsPreset(category));
+    }
+    Log::print<INFO>("Graphics pack presets: {}", presets);
+}
+#endif
+
 void CemuHost::OpenGraphicPacksWindow() {
     HostModule::OpenGraphicPacksWindow();
 }
