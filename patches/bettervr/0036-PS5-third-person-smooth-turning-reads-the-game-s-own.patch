     }
 }
 
+enum class TurningMode : uint8_t {
+    FIRST_PERSON_SMOOTH,
+    FIRST_PERSON_SNAP,
+    THIRD_PERSON_SMOOTH,
+    THIRD_PERSON_SNAP,
+};
+
+// One line when the effective turn mode changes, so a console log says which mode a stick test ran in.
+static void LogTurningModeChange(bool inGame) {
+    static int s_loggedMode = -1;
+    if (!inGame) {
+        s_loggedMode = -1;
+        return;
+    }
+
+    const int32_t snapAngle = GetSettings().GetSnapTurnAngle();
+    TurningMode mode = TurningMode::FIRST_PERSON_SMOOTH;
+    if (GameState::IsThirdPerson()) {
+        mode = GetSettings().ShouldSnapTurnInThirdPerson() && snapAngle > 0 ? TurningMode::THIRD_PERSON_SNAP : TurningMode::THIRD_PERSON_SMOOTH;
+    }
+    else if (snapAngle > 0) {
+        mode = TurningMode::FIRST_PERSON_SNAP;
+    }
+    if ((int)mode == s_loggedMode) {
+        return;
+    }
+    s_loggedMode = (int)mode;
+
+    switch (mode) {
+        case TurningMode::FIRST_PERSON_SNAP:
+            Log::print<INFO>("[turn] mode: first person snap, {} degrees", snapAngle);
+            break;
+        case TurningMode::THIRD_PERSON_SNAP:
+            Log::print<INFO>("[turn] mode: third person snap, {} degrees", snapAngle);
+            break;
+        case TurningMode::THIRD_PERSON_SMOOTH:
+            Log::print<INFO>("[turn] mode: third person smooth, the game's right stick");
+            break;
+        default:
+            Log::print<INFO>("[turn] mode: first person smooth, {:.0f} deg/s", GetSettings().GetSmoothTurnSpeed());
+            break;
+    }
+}
+
 static void UpdateTurning(const XrActionStateVector2f& rightStickSource, float physicalStickX, bool inGame) {
     static bool s_firstPersonSnapTurnStickLatched = false;
     static bool s_thirdPersonSnapTurnStickLatched = false;
     const float stickX = rightStickSource.currentState.x;
 
+    LogTurningModeChange(inGame);
+    Camera::SetTurnStickInput(inGame ? std::clamp(stickX + physicalStickX, -1.0f, 1.0f) : 0.0f);
+
     if (ShouldSnapTurnThirdPerson(inGame) && !ImGuiMenus::g_isOpen) {
         s_firstPersonSnapTurnStickLatched = false;
         Camera::SetSmoothTurnInput(0.0f);
