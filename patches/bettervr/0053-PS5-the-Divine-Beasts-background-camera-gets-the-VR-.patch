@@ -183,6 +183,24 @@ lis r12, halfEyeOffset@ha
 lfs f1, halfEyeOffset@l(r12)             ; f1 = halfEyeOffset
 fneg f1, f1                              ; f1 = -halfEyeOffset
 bl hook_recalcGpuView
