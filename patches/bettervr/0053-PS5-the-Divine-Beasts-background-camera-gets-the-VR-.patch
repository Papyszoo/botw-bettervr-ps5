diff --git a/src/game/botw/camera/stereo_view.cpp b/src/game/botw/camera/stereo_view.cpp
index ff781cc..a314f47 100644
--- a/src/game/botw/camera/stereo_view.cpp
+++ b/src/game/botw/camera/stereo_view.cpp
@@ -17,6 +17,87 @@ static std::atomic<float> s_flatCameraFovYRadians = glm::radians(90.0f);
 static std::mutex s_gameCameraMutex;
 static std::optional<glm::mat4> s_gameCameraWorld;
 
+// the Divine Beasts' background camera: the record-side hook leaves the camera and projection here, and the
+// replay swaps the eye's shared matrices for theirs around the view upload, then puts the eye's own back
+static std::atomic_uint32_t s_backgroundCameraPtr = 0;
+static std::atomic_uint32_t s_backgroundProjectionPtr = 0;
+
+static uint32_t ReadGuestU32(uint32_t address) {
+    BEType<uint32_t> value;
+    Guest::Read(address, &value);
+    return value.getLE();
+}
+
+static float ReadGuestFloat(uint32_t address) {
+    BEType<float> value;
+    Guest::Read(address, &value);
+    return value.getLE();
+}
+
+static void WriteGuestU32(uint32_t address, uint32_t value) {
+    BEType<uint32_t> beValue(value);
+    Guest::Write(address, &beValue);
+}
+
+struct BackgroundGpuViewState {
+    bool prepared = false;
+    bool left = false;
+    uint32_t sharedMemAddress = 0;
+    uint32_t shaderCtx = 0;
+    uint32_t shaderCtxField4 = 0;
+    BEMatrix34 mainView;
+    BEMatrix44 mainProj;
+    float mainNear = 0.0f;
+    float mainFar = 0.0f;
+    float mainFovy = 0.0f;
+    float mainAspect = 0.0f;
+    float mainStuff5 = 0.0f;
+};
+
+static BackgroundGpuViewState s_backgroundGpuViewState;
+
+static void GetEyeShared(VRSharedMemory& sharedMem, bool left, BEMatrix34& view, BEMatrix44& proj, float& nearZ, float& farZ, float& fovy, float& aspect, float& stuff5) {
+    if (left) {
+        view = sharedMem.leftView;
+        proj = sharedMem.leftProj;
+        nearZ = sharedMem.leftNear.getLE();
+        farZ = sharedMem.leftFar.getLE();
+        fovy = sharedMem.leftFovy.getLE();
+        aspect = sharedMem.leftAspect.getLE();
+        stuff5 = sharedMem.leftStuff5.getLE();
+    }
+    else {
+        view = sharedMem.rightView;
+        proj = sharedMem.rightProj;
+        nearZ = sharedMem.rightNear.getLE();
+        farZ = sharedMem.rightFar.getLE();
+        fovy = sharedMem.rightFovy.getLE();
+        aspect = sharedMem.rightAspect.getLE();
+        stuff5 = sharedMem.rightStuff5.getLE();
+    }
+}
+
+static void SetEyeShared(VRSharedMemory& sharedMem, bool left, const BEMatrix34& view, const BEMatrix44& proj, float nearZ, float farZ, float fovy, float aspect, float stuff5) {
+    if (left) {
+        sharedMem.leftView = view;
+        sharedMem.leftProj = proj;
+        sharedMem.leftNear = nearZ;
+        sharedMem.leftFar = farZ;
+        sharedMem.leftFovy = fovy;
+        sharedMem.leftAspect = aspect;
+        sharedMem.leftStuff5 = stuff5;
+    }
+    else {
+        sharedMem.rightView = view;
+        sharedMem.rightProj = proj;
+        sharedMem.rightNear = nearZ;
+        sharedMem.rightFar = farZ;
+        sharedMem.rightFovy = fovy;
+        sharedMem.rightAspect = aspect;
+        sharedMem.rightStuff5 = stuff5;
+    }
+}
+
 std::optional<glm::mat4> StereoView::GetGameCameraWorld() {
     std::scoped_lock lock(s_gameCameraMutex);
     return s_gameCameraWorld;
@@ -211,6 +292,200 @@ static void hook_GetRenderCamera(PPCInterpreter_t* hCPU) {
     Camera::UpdateDebugEyeViews(views, gameplayPos, gameplayRot);
 }
 
+// the Divine Beasts draw the outside world with a background camera of their own; the game hands it to the
+// layer as the layer's special camera and projection. It keeps that camera's position (the outside world is a
+// different, scaled world), takes the head's rotation on top of the gameplay yaw, and is drawn once per eye
+// with that eye's projection but the background projection's near and far. The replay picks the per-eye
+// projection up from the camera/projection pair the wrapper leaves behind (see hook_recalcGpuView).
+static void hook_ModifyProjectionUsingCamera(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+
+    if (GameState::UseBlackBarsDuringEvents() || GameState::UseFlatCameraPresentation() || GameState::UseMonoFrameBufferTemporarilyDuringMenusOrPictures()) {
+        return;
+    }
+
+    const uint32_t cameraPtr = hCPU->gpr[7];
+    const uint32_t projectionPtr = hCPU->gpr[4];
+    if (cameraPtr == 0 || projectionPtr == 0) {
+        return;
+    }
+
+    const std::optional<Tracking::HeadViews> views = Tracking::Views();
+    if (!views.has_value()) {
+        return;
+    }
+
+    s_backgroundCameraPtr.store(cameraPtr);
+    s_backgroundProjectionPtr.store(projectionPtr);
+
+    BESeadLookAtCamera camera = {};
+    Guest::Read(cameraPtr, &camera);
+
+    const glm::mat4 worldGame = glm::inverse(glm::mat4(camera.mtx.getLEMatrix()));
+    const glm::fvec3 basePos = glm::vec3(worldGame[3]);
+    auto [gameplayPos, gameplayRot] = Camera::ResolveGameplayBasePose(camera);
+    (void)gameplayPos;
+
+    // only the rotation is taken from the head; BuildMiddlePose's position is the gameplay anchor and is not used
+    auto [middlePos, middleRot] = Camera::BuildMiddlePose(views, basePos, gameplayRot);
+    (void)middlePos;
+    SetCameraWorld(camera, glm::translate(glm::identity<glm::fmat4>(), basePos) * glm::mat4_cast(middleRot));
+    Guest::Write(cameraPtr, &camera);
+
+    BESeadPerspectiveProjection perspectiveProjection = {};
+    Guest::Read(projectionPtr, &perspectiveProjection);
+    const std::optional<XrFovf> combinedFov = TryGetCombinedFOV(views);
+    if (combinedFov.has_value()) {
+        // the record pass is culled and drawn with one projection; the combined eye FOV covers both eyes
+        ApplyProjectionFov(perspectiveProjection, combinedFov.value());
+        Guest::Write(projectionPtr, &perspectiveProjection);
+    }
+
+    static uint32_t s_loggedCameraPtr = 0;
+    if (s_loggedCameraPtr != cameraPtr) {
+        s_loggedCameraPtr = cameraPtr;
+        Log::print<INFO>("[bgcam] divine beast background camera: VR pose applied");
+    }
+}
+
+// left and right eye each swap the shared eye matrices for the background camera's around their own view
+// upload; the VFC entry that holds the background camera's view names the per-view UBO the pass reads
+static void hook_PrepareBackgroundGpuView(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    s_backgroundGpuViewState.prepared = false;
+
+    if (!Tracking::IsSessionRunning()) {
+        return;
+    }
+
+    const uint32_t ctx = hCPU->gpr[3];
+    const float eyeOffset = hCPU->fpr[1].fp0;
+    const uint32_t cameraPtr = s_backgroundCameraPtr.load();
+    const uint32_t projectionPtr = s_backgroundProjectionPtr.load();
+    if (ctx == 0 || cameraPtr == 0 || projectionPtr == 0) {
+        return;
+    }
+
+    const uint32_t layer = ReadGuestU32(ctx + 0x208);
+    if (layer == 0) {
+        return;
+    }
+    const uint32_t special = ReadGuestU32(layer + 0x19C);
+    if (special == 0) {
+        return;
+    }
+    const uint32_t specialCamera = special + 4;
+    const uint32_t specialProjection = ReadGuestU32(special + 0xEC);
+    if (specialCamera != cameraPtr && specialProjection != projectionPtr) {
+        return;
+    }
+
+    const uint32_t shaderCtx = ReadGuestU32(ctx + 0x1A8);
+    if (shaderCtx == 0) {
+        return;
+    }
+    const uint32_t sharedAddress = StereoView::GetSharedMemoryAddress();
+    if (sharedAddress == 0) {
+        return;
+    }
+    const uint32_t sharedMemAddress = sharedAddress + offsetof(VRSharedMemoryRoot, shared);
+    VRSharedMemory sharedMem = {};
+    Guest::Read(sharedMemAddress, &sharedMem);
+
+    const bool left = eyeOffset < 0.0f;
+    BEMatrix34 mainView;
+    BEMatrix44 mainProj;
+    float mainNear = 0.0f;
+    float mainFar = 0.0f;
+    float mainFovy = 0.0f;
+    float mainAspect = 0.0f;
+    float mainStuff5 = 0.0f;
+    GetEyeShared(sharedMem, left, mainView, mainProj, mainNear, mainFar, mainFovy, mainAspect, mainStuff5);
+
+    BESeadLookAtCamera backgroundCamera = {};
+    Guest::Read(cameraPtr, &backgroundCamera);
+    BESeadPerspectiveProjection backgroundProjection = {};
+    Guest::Read(projectionPtr, &backgroundProjection);
+
+    // the eye's own horizontal and vertical projection, the background projection's depth range
+    BEMatrix44 backgroundProj = mainProj;
+    backgroundProj.a22 = backgroundProjection.matrix.a22;
+    backgroundProj.a23 = backgroundProjection.matrix.a23;
+    backgroundProj.a32 = backgroundProjection.matrix.a32;
+    backgroundProj.a33 = backgroundProjection.matrix.a33;
+
+    const float nearZ = backgroundProjection.zNear.getLE();
+    const float farZ = backgroundProjection.zFar.getLE();
+    const float proj11 = backgroundProj.a11.getLE();
+    const float proj00 = backgroundProj.a00.getLE();
+    const float stuff5 = proj11 != 0.0f ? 1.0f / proj11 : mainStuff5;
+    const float aspect = proj00 != 0.0f && proj11 != 0.0f ? proj11 / proj00 : mainAspect;
+
+    const uint32_t shaderCtxField4 = ReadGuestU32(shaderCtx + 4);
+    const float viewFloats[12] = {
+        backgroundCamera.mtx.x_x.getLE(), backgroundCamera.mtx.y_x.getLE(), backgroundCamera.mtx.z_x.getLE(), backgroundCamera.mtx.pos_x.getLE(),
+        backgroundCamera.mtx.x_y.getLE(), backgroundCamera.mtx.y_y.getLE(), backgroundCamera.mtx.z_y.getLE(), backgroundCamera.mtx.pos_y.getLE(),
+        backgroundCamera.mtx.x_z.getLE(), backgroundCamera.mtx.y_z.getLE(), backgroundCamera.mtx.z_z.getLE(), backgroundCamera.mtx.pos_z.getLE(),
+    };
+
+    uint32_t backgroundIndex = 0;
+    const uint32_t vfcArray = ReadGuestU32(ctx + 0x0C);
+    const uint32_t vfcCount = ReadGuestU32(ctx + 0x08);
+    for (uint32_t i = 0; i < vfcCount && i < 16; i++) {
+        for (uint32_t row = 0; row < 2; row++) {
+            bool matches = true;
+            for (uint32_t k = 0; k < 12; k++) {
+                float difference = ReadGuestFloat(vfcArray + i * 0x31C + row * 0x60 + k * 4) - viewFloats[k];
+                if (difference < 0.0f) difference = -difference;
+                if (difference > 0.001f) {
+                    matches = false;
+                    break;
+                }
+            }
+            if (matches) {
+                backgroundIndex = i;
+                i = vfcCount;
+                break;
+            }
+        }
+    }
+
+    s_backgroundGpuViewState.prepared = true;
+    s_backgroundGpuViewState.left = left;
+    s_backgroundGpuViewState.sharedMemAddress = sharedMemAddress;
+    s_backgroundGpuViewState.shaderCtx = shaderCtx;
+    s_backgroundGpuViewState.shaderCtxField4 = shaderCtxField4;
+    s_backgroundGpuViewState.mainView = mainView;
+    s_backgroundGpuViewState.mainProj = mainProj;
+    s_backgroundGpuViewState.mainNear = mainNear;
+    s_backgroundGpuViewState.mainFar = mainFar;
+    s_backgroundGpuViewState.mainFovy = mainFovy;
+    s_backgroundGpuViewState.mainAspect = mainAspect;
+    s_backgroundGpuViewState.mainStuff5 = mainStuff5;
+
+    SetEyeShared(sharedMem, left, backgroundCamera.mtx, backgroundProj, nearZ, farZ, mainFovy, aspect, stuff5);
+    Guest::Write(sharedMemAddress, &sharedMem);
+    if (backgroundIndex != 0) {
+        WriteGuestU32(shaderCtx + 4, shaderCtxField4 + backgroundIndex * 48);
+    }
+}
+
+static void hook_RestoreBackgroundGpuView(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    if (!s_backgroundGpuViewState.prepared) {
+        return;
+    }
+
+    VRSharedMemory sharedMem = {};
+    Guest::Read(s_backgroundGpuViewState.sharedMemAddress, &sharedMem);
+    SetEyeShared(sharedMem, s_backgroundGpuViewState.left, s_backgroundGpuViewState.mainView, s_backgroundGpuViewState.mainProj,
+        s_backgroundGpuViewState.mainNear, s_backgroundGpuViewState.mainFar, s_backgroundGpuViewState.mainFovy,
+        s_backgroundGpuViewState.mainAspect, s_backgroundGpuViewState.mainStuff5);
+    Guest::Write(s_backgroundGpuViewState.sharedMemAddress, &sharedMem);
+    WriteGuestU32(s_backgroundGpuViewState.shaderCtx + 4, s_backgroundGpuViewState.shaderCtxField4);
+    s_backgroundGpuViewState.prepared = false;
+}
+
 static void hook_GetRenderProjection(PPCInterpreter_t* hCPU) {
     hCPU->instructionPointer = hCPU->sprNew.LR;
 
@@ -392,6 +667,9 @@ static void hook_FixCameraSaveFilesAndInventory(PPCInterpreter_t* hCPU) {
 void StereoView::RegisterHooks() {
     CemuHost::RegisterHook("hook_RegisterVRSharedMemory", &hook_RegisterVRSharedMemory);
     CemuHost::RegisterHook("hook_GetRenderCamera", &hook_GetRenderCamera);
+    CemuHost::RegisterHook("hook_ModifyProjectionUsingCamera", &hook_ModifyProjectionUsingCamera);
+    CemuHost::RegisterHook("hook_PrepareBackgroundGpuView", &hook_PrepareBackgroundGpuView);
+    CemuHost::RegisterHook("hook_RestoreBackgroundGpuView", &hook_RestoreBackgroundGpuView);
     CemuHost::RegisterHook("hook_GetRenderProjection", &hook_GetRenderProjection);
     CemuHost::RegisterHook("hook_CheckIfCameraCanSeePos", &hook_CheckIfCameraCanSeePos);
     CemuHost::RegisterHook("hook_ModifyPixelUniformBlockData", &hook_ModifyPixelUniformBlockData);
