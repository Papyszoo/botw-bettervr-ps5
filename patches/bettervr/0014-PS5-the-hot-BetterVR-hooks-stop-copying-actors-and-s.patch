+
+// PS5 performance: what the hooks themselves cost on the host. One atomic counter per call and one
+// steady-clock pair every 64th call; the [diag] line sums the samples back up to all calls and prints
+// ms per second plus calls per game frame. Sampled, so the measurement stays far below what it measures.
+class BetterVRHookTiming {
+public:
+    enum class Hook : uint8_t {
+        RouteActorJob,
+        ModifyBoneMatrix,
+        CameraVisibility,
+        ProfileSection,
+        VpadRead,
+        Count
+    };
+
+    static constexpr size_t kHookCount = (size_t)Hook::Count;
+    static constexpr uint32_t kSampleMask = 63;
+
+private:
+    struct Slot {
+        Slot() : calls(0), samples(0), sampledNs(0) {}
+        std::atomic<uint32_t> calls;
+        std::atomic<uint32_t> samples;
+        std::atomic<uint64_t> sampledNs;
+    };
+
+    static uint64_t NowNs() {
+        return (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    inline static std::array<Slot, kHookCount> s_slots;
+
+public:
+    struct Reading {
+        uint32_t calls = 0;
+        double msPerSecond = 0.0;
+    };
+
+    class Scope {
+    public:
+        explicit Scope(Hook hook) : m_hook(hook) {
+            Slot& slot = s_slots[(size_t)hook];
+            const uint32_t call = slot.calls.fetch_add(1, std::memory_order_relaxed);
+            if ((call & kSampleMask) == 0) {
+                m_startNs = NowNs();
+                m_active = true;
+            }
+        }
+        Scope(const Scope&) = delete;
+        Scope& operator=(const Scope&) = delete;
+
+        ~Scope() {
+            if (!m_active) {
+                return;
+            }
+
+            Slot& slot = s_slots[(size_t)m_hook];
+            slot.sampledNs.fetch_add(NowNs() - m_startNs, std::memory_order_relaxed);
+            slot.samples.fetch_add(1, std::memory_order_relaxed);
+        }
+
+    private:
+        Hook m_hook;
+        uint64_t m_startNs = 0;
+        bool m_active = false;
+    };
+
+    // Resets the slot and returns its calls and their host time as ms per second of `seconds`.
+    static Reading TakeReading(Hook hook, double seconds) {
+        Slot& slot = s_slots[(size_t)hook];
+        Reading reading;
+        reading.calls = slot.calls.exchange(0, std::memory_order_relaxed);
+        const uint32_t samples = slot.samples.exchange(0, std::memory_order_relaxed);
+        const uint64_t sampledNs = slot.sampledNs.exchange(0, std::memory_order_relaxed);
+        if (samples == 0 || reading.calls == 0 || seconds <= 0.0) {
+            return reading;
+        }
+
+        const double averageNs = (double)sampledNs / (double)samples;
+        reading.msPerSecond = averageNs * (double)reading.calls / (seconds * 1000000.0);
+        return reading;
+    }
+};
