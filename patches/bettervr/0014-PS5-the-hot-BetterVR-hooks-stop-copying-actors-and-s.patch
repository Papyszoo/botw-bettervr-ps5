 src/utils/profiler.h              | 83 +++++++++++++++++++++++++++++
 9 files changed, 244 insertions(+), 115 deletions(-)

diff --git a/include/game_structs.h b/include/game_structs.h
index 6372db1..673c722 100644
--- a/include/game_structs.h
+++ b/include/game_structs.h
@@ -1,5 +1,8 @@
 #pragma once
 
+#include <cstring>
+#include <string_view>
+
 #pragma pack(push, 1)
 namespace sead {
     struct SafeString {
@@ -37,6 +40,17 @@ namespace sead {
     };
     static_assert(sizeof(FixedSafeString100) == 0x10C, "FixedSafeString100 size mismatch");
 
+    // The same string getLE() returns, compared without the heap allocation: a null c_str reads as
+    // empty, otherwise the inline buffer up to its terminator is the string.
+    template <typename T>
+    inline bool SeadStringEquals(const T& str, std::string_view text) {
+        if (str.c_str.getLE() == 0) {
+            return text.empty();
+        }
+        const size_t length = strnlen(str.data, sizeof(str.data));
+        return text.size() == length && std::memcmp(str.data, text.data(), length) == 0;
+    }
+
     struct PtrArrayImpl {
         BEType<uint32_t> size;
         BEType<uint32_t> capacity;
