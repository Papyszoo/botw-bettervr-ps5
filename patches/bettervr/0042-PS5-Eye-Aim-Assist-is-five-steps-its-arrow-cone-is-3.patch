+// the right stick's push (up) or pull (down) on a distance: full deflection is squared so the middle is fine
+// control, and a pull stops at EyeMinDistance unless the distance is already closer
+static float PushPullDistance(float distance, float dt) {
+    const float stick = IsFresh(s_pushPullStickNs, EyeFreshNs) ? s_pushPullStick.load() : 0.0f;
+    const float pushPull = stick * std::abs(stick) * EyePushPullSpeed * dt;
+    return pushPull < 0.0f ? std::max(distance + pushPull, std::min(distance, EyeMinDistance)) : distance + pushPull;
+}
+
+// turns the vector a grip started from by the hand's yaw and pitch since that grip: a yaw about the world's up,
+// then a pitch about the horizontal axis that yaw leaves the vector over. Unlike a spherical pitch with a clamp,
+// this has no angle where the hand's tilt stops or reverses, so an object above the hand keeps following it.
+static glm::vec3 TurnLeverByHand(const glm::vec3& gripLever, float gripYaw, float yawDelta, float pitchDelta) {
+    const float yaw = gripYaw + yawDelta;
+    const glm::vec3 right(std::cos(yaw), 0.0f, -std::sin(yaw)); // cross(up, the yaw's horizontal direction)
+    return glm::angleAxis(-pitchDelta, right) * (glm::angleAxis(yawDelta, glm::vec3(0.0f, 1.0f, 0.0f)) * gripLever);
+}
