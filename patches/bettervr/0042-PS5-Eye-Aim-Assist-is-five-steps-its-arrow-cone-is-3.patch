+    // PS5: the right stick's up/down pushes and pulls the hand's distance the same way it does the eyes' (the eye
+    // path's own helper); the hand still sets the direction, the height and the arm's reach
     const uint64_t now = GetTimeStamp();
+    const glm::vec3 handAim = FlattenHorizontally(targetOffset);
+    const float handDistance = glm::length(handAim);
+    if (handDistance > 0.001f) {
+        if (s_handWroteDistance > 0.0f && std::abs(gameDistance - s_handWroteDistance) > 0.5f) {
