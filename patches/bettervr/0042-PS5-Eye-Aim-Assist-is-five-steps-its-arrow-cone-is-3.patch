+// a strength from off to full, in the row's five steps; the Eye Aim Assist row was an on/off switch, and its old
+// "true" is 25 %
 class EyeAimAssistSetting : public FloatSetting {
 public:
     using FloatSetting::operator=;
 
     EyeAimAssistSetting(): FloatSetting("EyeAimAssist", 0.0f, 0.0f, 1.0f) {}
 
+    // Off, 25 %, 50 %, 75 % or Full: a value saved by a build whose row was a slider takes the nearest step
+    float NormalizeValue(float value) const override {
+        return std::round(std::clamp(value, 0.0f, 1.0f) * 4.0f) * 0.25f;
+    }
+
     void Deserialize(std::string_view valueString) override {
         if (IEquals(valueString, "true") || IEquals(valueString, "on")) {
             *this = 0.25f;
