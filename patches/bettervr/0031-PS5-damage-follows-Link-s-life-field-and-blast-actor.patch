+        RumbleParameters otherHand = boom;
+        otherHand.hand = 1;
+        Haptics::Play(otherHand, HapticCategory::Explosion);
+        if (queued) {
+            result = fmt::format("hands {:.2f}, Explosions {}% [{}]", strength * gain,
+                                 (unsigned)settings.HapticsStrength(HapticCategory::Explosion).load(),
