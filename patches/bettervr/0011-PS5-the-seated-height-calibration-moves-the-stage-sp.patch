     BoolSetting thirdPersonBowCameraAim{ "ThirdPersonBowCameraAim", true };
     EnumSetting<EventMode> cutsceneCameraMode{ "CutsceneCameraMode", EventMode::FOLLOW_DEFAULT_EVENT_SETTINGS };
