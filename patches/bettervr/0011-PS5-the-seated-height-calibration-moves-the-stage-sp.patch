+    // first loading screen) to Link's, as the Linux backend always did; "PlayPosition=STANDING" in
+    // bettervr_settings.ini takes the real height above the tracker's origin
+    EnumSetting<PlayMode> playMode{ "PlayPosition", PlayMode::SEATED };
+#else
     EnumSetting<PlayMode> playMode{ "PlayPosition", PlayMode::STANDING };
+#endif
