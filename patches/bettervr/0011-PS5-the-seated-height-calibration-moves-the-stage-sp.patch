     void RequestSeatedHeightCalibration(XrTime notBeforeTime = 0);
+    bool HasSeatedHeightCalibration() const { return m_hasSeatedHeightCalibration.load(std::memory_order_acquire); }
     std::optional<float> GetCalibratedSeatedEyeHeight() const;
 
     void ProcessEvents();
@@ -232,6 +233,8 @@ public:
     RumbleManager* GetRumbleManager() const { return m_rumbleManager.get(); }
     XrInstance GetInstance() const { return m_instance; }
     XrSystemId GetSystemId() const { return m_systemId; }
+    // the stage space as it is now: the seated height calibration replaces it
+    XrSpace GetStageSpace() const { return m_stageSpace; }
 
 #ifndef _WIN32
     // Current OpenXR session state (updated by ProcessEvents on Linux). The submit
@@ -247,6 +250,7 @@ private:
         return path;
     };
     void ReplaceStageSpace(float floorOffset);
+    void LogSeatedHeightCalibrationSkip(const char* reason);
 
     XrInstance m_instance = XR_NULL_HANDLE;
     XrSystemId m_systemId = XR_NULL_SYSTEM_ID;
@@ -257,7 +261,9 @@ private:
     float m_stageFloorOffset = 0.0f;
     std::atomic_bool m_seatedHeightCalibrationRequested = false;
     std::atomic<XrTime> m_seatedHeightCalibrationNotBeforeTime = 0;
-    bool m_hasSeatedHeightCalibration = false;
+    std::atomic_bool m_hasSeatedHeightCalibration = false;
+    // the last skip reason logged: UpdateSeatedHeightCalibration runs every frame and writes one line per reason
+    const char* m_seatedHeightCalibrationSkipReason = nullptr;
     bool m_seenFirstLoadingScreen = false;
     std::optional<PlayMode> m_lastSeenPlayMode;
     std::array<XrSpace, 2> m_inGameHandSpaces = { XR_NULL_HANDLE, XR_NULL_HANDLE };
diff --git a/src/rendering/renderer_vulkan.cpp b/src/rendering/renderer_vulkan.cpp
index fdf0fde..0ec1cca 100644
--- a/src/rendering/renderer_vulkan.cpp
+++ b/src/rendering/renderer_vulkan.cpp
@@ -716,7 +716,7 @@ static void PoseTrackingThreadMain(XrSession session, XrSpace stageSpace) {
         XrViewLocateInfo locateInfo = { XR_TYPE_VIEW_LOCATE_INFO };
         locateInfo.viewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
         locateInfo.displayTime = target;
-        locateInfo.space = stageSpace;
+        locateInfo.space = VRManager::instance().XR->GetStageSpace();
 
         XrViewState viewState = { XR_TYPE_VIEW_STATE };
         uint32_t viewCount = 2;
@@ -829,12 +829,15 @@ static void SubmitThreadMain(XrSession session, XrSpace stageSpace) {
         }
 
         if (currentFrameState.predictedDisplayTime != 0) {
-            VRManager::instance().XR->UpdateSpaces(currentFrameState.predictedDisplayTime);
+            // as renderer.cpp's StartFrame: the head in the stage, for the seated height calibration, which
+            // moves the stage space (the spaces above are read from it each time for that)
+            const std::optional<XrSpaceLocation> headLocation = VRManager::instance().XR->UpdateSpaces(currentFrameState.predictedDisplayTime);
+            VRManager::instance().XR->UpdateSeatedHeightCalibration(currentFrameState.predictedDisplayTime, headLocation);
 
             XrViewLocateInfo locateInfo = { XR_TYPE_VIEW_LOCATE_INFO };
             locateInfo.viewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
             locateInfo.displayTime = currentFrameState.predictedDisplayTime;
-            locateInfo.space = stageSpace;
+            locateInfo.space = VRManager::instance().XR->GetStageSpace();
             XrViewState viewState = { XR_TYPE_VIEW_STATE };
             uint32_t viewCount = 2;
             std::array<XrView, 2> views = { XrView{XR_TYPE_VIEW}, XrView{XR_TYPE_VIEW} };
@@ -1135,7 +1138,7 @@ static void SubmitThreadMain(XrSession session, XrSpace stageSpace) {
                 XrViewLocateInfo lateLocateInfo = { XR_TYPE_VIEW_LOCATE_INFO };
                 lateLocateInfo.viewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
                 lateLocateInfo.displayTime = currentFrameState.predictedDisplayTime;
-                lateLocateInfo.space = stageSpace;
+                lateLocateInfo.space = VRManager::instance().XR->GetStageSpace();
                 XrViewState lateViewState = { XR_TYPE_VIEW_STATE };
                 uint32_t lateViewCount = 2;
                 auto lateLocateStart = std::chrono::high_resolution_clock::now();
@@ -1253,7 +1256,7 @@ static void SubmitThreadMain(XrSession session, XrSpace stageSpace) {
                             glm::degrees(rv.fov.angleUp), glm::degrees(rv.fov.angleDown));
                     }
                 }
-                projectionLayer.space = stageSpace;
+                projectionLayer.space = VRManager::instance().XR->GetStageSpace();
                 projectionLayer.viewCount = 2;
                 projectionLayer.views = projectionViews.data();
                 projectionLayerReady = true;
@@ -1280,7 +1283,7 @@ static void SubmitThreadMain(XrSession session, XrSpace stageSpace) {
                 glm::quat hudOri = glm::quatLookAt(forward, up);
                 constexpr float aspectRatio = 16.0f / 9.0f;
                 hudLayer.layerFlags = has3D ? XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT : 0;
-                hudLayer.space = stageSpace;
+                hudLayer.space = VRManager::instance().XR->GetStageSpace();
                 hudLayer.eyeVisibility = XR_EYE_VISIBILITY_BOTH;
                 hudLayer.subImage.swapchain = s_linux->hudSwapchain.handle;
                 hudLayer.subImage.imageRect.offset = { 0, 0 };
@@ -2161,15 +2164,19 @@ void RND_Renderer::LatchPendingIfNeeded() const {
                                      std::memory_order_release);
     }
 
-    // Apply seated height offset and publish to m_currViews. This is the pose
+    // Publish to m_currViews (the seated height is the stage space's, OpenXR::UpdateSeatedHeightCalibration). This is the pose
     // used by the game camera and therefore the pose to attach to captured 3D
-    // content for projection-layer reprojection.
+    // content for projection-layer reprojection. Until the stage's calibration has run (the PS5's
+    // tracker origin is not the floor, and the first loading screen can pass before this renderer
+    // exists), the old 1.65 m lift keeps the view height the earlier builds had.
     {
         std::unique_lock viewsLock(m_viewsMutex);
-        constexpr float kTargetHeadHeight = 1.65f;
-        float currentHeight = (views[0].pose.position.y + views[1].pose.position.y) * 0.5f;
-        float heightOffset = kTargetHeadHeight - currentHeight;
-        for (auto& v : views) v.pose.position.y += heightOffset;
+        if (!VRManager::instance().XR->HasSeatedHeightCalibration() && GetSettings().GetPlayMode() == PlayMode::SEATED) {
+            constexpr float kFallbackHeadHeight = 1.65f;
+            const float currentHeight = (views[0].pose.position.y + views[1].pose.position.y) * 0.5f;
+            const float heightOffset = kFallbackHeadHeight - currentHeight;
+            for (auto& view : views) view.pose.position.y += heightOffset;
+        }
         m_currViews = views;
         m_linuxCurrViewsDisplayTime = viewsDisplayTime;
     }
diff --git a/src/utils/mod_settings.h b/src/utils/mod_settings.h
index 82e210e..d1a8c24 100644
--- a/src/utils/mod_settings.h
+++ b/src/utils/mod_settings.h
@@ -569,7 +569,14 @@ struct ModSettings {
     // playing mode settings
     EnumSetting<CameraMode> cameraMode{ "CameraMode", CameraMode::FIRST_PERSON };
     // not keyed "PlayMode": that key is retired in settings.cpp, so a Seated choice saved by an older build stays unread
+#ifdef __PROSPERO__
