From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Thu, 5 Nov 2026 18:15:26 +0100
Subject: [PATCH] PS5: the seated height calibration moves the stage space, not
 only the head's views

The Linux backend pinned the head to 1.65 m by shifting the views and left the hands where the runtime located them, so with the head at 1 m the hands were 0.65 m too low against it, and crouching and leaning were flattened. The submit thread now runs UpdateSeatedHeightCalibration as renderer.cpp's StartFrame does, and every thread locates in the stage space as it is then (OpenXR::GetStageSpace). On the PS5 the default play position is Seated (calibrates to Link's eye height; the tracker's origin is not known to be the floor). If the first LoadingWeapon_00 screen passes before the renderer exists, as it does when the PS5 starts the session after the boot load, the first in-game frame with a valid head pose requests the calibration too; one line says when it runs, or why it is skipped. Until it has run, the views keep the old 1.65 m lift, so the start height is the one earlier builds had.
---
 src/rendering/openxr.cpp          | 35 ++++++++++++++++++++++++++-----
 src/rendering/openxr.h            |  8 ++++++-
 src/rendering/renderer_vulkan.cpp | 31 ++++++++++++++++-----------
 src/utils/mod_settings.h          |  7 +++++++
 4 files changed, 63 insertions(+), 18 deletions(-)

diff --git a/src/rendering/openxr.cpp b/src/rendering/openxr.cpp
index 4ec7823..148ab2d 100644
--- a/src/rendering/openxr.cpp
+++ b/src/rendering/openxr.cpp
@@ -286,7 +286,8 @@ void OpenXR::CreateSession(const void* graphicsBinding, const char* failureMessa
     checkXRResult(xrCreateSession(m_instance, &sessionCreateInfo, &m_session), failureMessage);
 
     Log::print<INFO>("Creating the OpenXR spaces...");
-    m_hasSeatedHeightCalibration = false;
+    m_hasSeatedHeightCalibration.store(false, std::memory_order_release);
+    m_seatedHeightCalibrationSkipReason = nullptr;
     m_seenFirstLoadingScreen = false;
     m_lastSeenPlayMode.reset();
     ReplaceStageSpace(0.0f);
@@ -324,12 +325,21 @@ void OpenXR::RequestSeatedHeightCalibration(XrTime notBeforeTime) {
 }
 
 std::optional<float> OpenXR::GetCalibratedSeatedEyeHeight() const {
-    if (!m_hasSeatedHeightCalibration) {
+    if (!m_hasSeatedHeightCalibration.load(std::memory_order_acquire)) {
         return std::nullopt;
     }
     return kLinkEyeHeight + m_stageFloorOffset;
 }
 
+void OpenXR::LogSeatedHeightCalibrationSkip(const char* reason) {
+    // the same literal while the reason does not change, so a per-frame call writes one line per reason
+    if (m_seatedHeightCalibrationSkipReason == reason) {
+        return;
+    }
+    m_seatedHeightCalibrationSkipReason = reason;
+    Log::print<INFO>("Seated height calibration skipped: {}", reason);
+}
+
 void OpenXR::UpdateSeatedHeightCalibration(XrTime predictedDisplayTime, const std::optional<XrSpaceLocation>& headLocation) {
     const PlayMode playMode = GetSettings().GetPlayMode();
     if (m_lastSeenPlayMode.has_value() && playMode != m_lastSeenPlayMode.value() && playMode == PlayMode::SEATED) {
@@ -344,31 +354,46 @@ void OpenXR::UpdateSeatedHeightCalibration(XrTime predictedDisplayTime, const st
         }
     }
 
+    // The loading screen above must be up after this renderer exists. The PS5 starts the session after the
+    // boot load, so that screen can pass unseen; ask again on the first in-game frame, where the head pose is
+    // the seated play pose. The request stays pending until a valid head pose arrives.
+    if (playMode == PlayMode::SEATED && !m_hasSeatedHeightCalibration.load(std::memory_order_acquire)
+        && !m_seatedHeightCalibrationRequested.load(std::memory_order_acquire) && CemuHooks::IsInGame()) {
+        RequestSeatedHeightCalibration();
+    }
+
     if (playMode != PlayMode::SEATED) {
         m_seatedHeightCalibrationRequested.store(false, std::memory_order_relaxed);
         if (m_stageFloorOffset != 0.0f) {
             ReplaceStageSpace(0.0f);
             Log::print<INFO>("Seated height calibration cleared, using the real height above the floor again");
         }
-        m_hasSeatedHeightCalibration = false;
+        m_hasSeatedHeightCalibration.store(false, std::memory_order_release);
+        LogSeatedHeightCalibrationSkip("PlayPosition is Standing, so the real height above the tracker origin is used");
         return;
     }
 
     if (!m_seatedHeightCalibrationRequested.load(std::memory_order_acquire)) {
+        if (!m_hasSeatedHeightCalibration.load(std::memory_order_acquire)) {
+            LogSeatedHeightCalibrationSkip("waiting for the first loading screen or in-game frame");
+        }
         return;
     }
     if (predictedDisplayTime < m_seatedHeightCalibrationNotBeforeTime.load(std::memory_order_relaxed)) {
+        LogSeatedHeightCalibrationSkip("waiting for the runtime's recentre time");
         return;
     }
     if (!headLocation.has_value() || !std::isfinite(headLocation->pose.position.y)) {
+        LogSeatedHeightCalibrationSkip("no valid head pose yet");
         return;
     }
 
     const float realEyeHeight = headLocation->pose.position.y + m_stageFloorOffset;
     m_seatedHeightCalibrationRequested.store(false, std::memory_order_relaxed);
     ReplaceStageSpace(realEyeHeight - kLinkEyeHeight);
-    m_hasSeatedHeightCalibration = true;
-    Log::print<INFO>("Seated height calibrated: eyes are {:.2f}m above the floor, stage origin moved by {:.2f}m", realEyeHeight, m_stageFloorOffset);
+    m_hasSeatedHeightCalibration.store(true, std::memory_order_release);
+    m_seatedHeightCalibrationSkipReason = nullptr;
+    Log::print<INFO>("Seated height calibrated: head at {:.2f}m above the tracker origin, stage origin moved by {:.2f}m; views and hands share it", realEyeHeight, m_stageFloorOffset);
 }
 
 void OpenXR::CreateActions() {
