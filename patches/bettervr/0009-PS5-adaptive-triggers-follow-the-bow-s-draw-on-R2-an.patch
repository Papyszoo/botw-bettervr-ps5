+#endif
+
 static ButtonState s_inventoryMapButton;
 static ButtonState s_modMenuButton;
 static ButtonState s_crouchScopeButton;
@@ -1452,8 +1458,12 @@ static void hook_InjectXRInput(PPCInterpreter_t* hCPU) {
 
     // take the hands and head once so the gestures below all use the same sample
     OpenXR::InputState inputs = Tracking::SampleHands(GameState::IsShowingMenu());
-    if (inputs.shared.inputTime <= 0)
+    if (inputs.shared.inputTime <= 0) {
+#if defined(__PROSPERO__)
+        BetterVR_PS5_AdaptiveTriggers(0.0f, 0, 0, GetSettings().adaptiveTriggers ? 1 : 0, GetSettings().adaptiveTriggerStrength);
+#endif
         return;
+    }
     const std::optional<glm::fmat4> headsetPose = Tracking::HeadPose();
     UpdateControlButtons(inputs, ImGuiMenus::g_isOpen.load());
 
@@ -1514,6 +1524,14 @@ static void hook_InjectXRInput(PPCInterpreter_t* hCPU) {
 
     Haptics::Update();
 
+#if defined(__PROSPERO__)
+    // The adaptive triggers: the bow's live draw on R2, the shield's guard on L2. Off in a menu, on the pause and
+    // inventory screens and outside the game; BetterVR_PS5_AdaptiveTriggers sends the first off and every change.
+    BetterVR_PS5_AdaptiveTriggers(Bow::GetDrawAmount(), state.isShieldGuarding ? 1 : 0,
+        state.inGame && !isMenuOpen && !GameState::IsShowingMenu() ? 1 : 0,
+        GetSettings().adaptiveTriggers ? 1 : 0, GetSettings().adaptiveTriggerStrength);
+#endif
+
     const bool disableRightStickHorizontalRotation = ShouldOverrideFirstPersonTurning(state.inGame) && !ImGuiMenus::g_isOpen && Camera::AppliesFirstPersonTurning();
     VPADButtons newXRStickHold = VPAD_BUTTON_NONE;
     ProcessJoystickInput(state.previousStickHold, newXRStickHold, vpadStatus, leftStickSource, rightStickSource, disableRightStickHorizontalRotation);
diff --git a/src/game/botw/player/bow.cpp b/src/game/botw/player/bow.cpp
index f71ea19..ec690b5 100644
--- a/src/game/botw/player/bow.cpp
+++ b/src/game/botw/player/bow.cpp
@@ -385,6 +385,18 @@ static uint32_t GetHeldLeftBowWeaponPtr() {
     return weapon.type.getLE() == WeaponType::Bow ? weaponPtr : 0;
 }
 
+// The live draw is the game's own field (the one TryReadLiveBowState reads), so the PS5's adaptive trigger follows
+// the bowstring rather than the input: 0.94C on the held weapon, clamped as the game's power shot does (1.5).
+float Bow::GetDrawAmount() {
+    const uint32_t weaponPtr = GetHeldLeftBowWeaponPtr();
+    if (weaponPtr == 0) {
+        return 0.0f;
+    }
+    float drawAmount = 0.0f;
+    Guest::ReadBE(weaponPtr + kWeaponDrawAmountOffset, &drawAmount);
+    return std::isfinite(drawAmount) ? glm::clamp(drawAmount, 0.0f, 1.5f) : 0.0f;
+}
+
