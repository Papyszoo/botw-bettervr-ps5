     const bool disableRightStickHorizontalRotation = ShouldOverrideFirstPersonTurning(state.inGame) && !ImGuiMenus::g_isOpen && Camera::AppliesFirstPersonTurning();
     VPADButtons newXRStickHold = VPAD_BUTTON_NONE;
     ProcessJoystickInput(state.previousStickHold, newXRStickHold, vpadStatus, leftStickSource, rightStickSource, disableRightStickHorizontalRotation);
diff --git a/src/game/botw/player/bow.cpp b/src/game/botw/player/bow.cpp
index f71ea19..ec690b5 100644
--- a/src/game/botw/player/bow.cpp
+++ b/src/game/botw/player/bow.cpp
@@ -385,6 +385,18 @@ static uint32_t GetHeldLeftBowWeaponPtr() {
     return weapon.type.getLE() == WeaponType::Bow ? weaponPtr : 0;
 }
 
+// The live draw is the game's own field (the one TryReadLiveBowState reads), so the PS5's adaptive trigger follows
+// the bowstring rather than the input: 0.94C on the held weapon, clamped as the game's power shot does (1.5).
+float Bow::GetDrawAmount() {
+    const uint32_t weaponPtr = GetHeldLeftBowWeaponPtr();
+    if (weaponPtr == 0) {
+        return 0.0f;
+    }
+    float drawAmount = 0.0f;
+    Guest::ReadBE(weaponPtr + kWeaponDrawAmountOffset, &drawAmount);
+    return std::isfinite(drawAmount) ? glm::clamp(drawAmount, 0.0f, 1.5f) : 0.0f;
+}
+
