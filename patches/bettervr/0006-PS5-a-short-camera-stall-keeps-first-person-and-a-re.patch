From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patryk Kowalczyk <papyszoo@gmail.com>
Date: Wed, 18 Nov 2026 16:19:52 +0100
Subject: [PATCH] PS5: a short camera stall keeps first person, and a
 rebuilding actor list keeps Link's head hidden

- IsThirdPersonForPose tolerates a gameplay camera stall shorter than 250 ms (IsInGame() is false for five presented
  frames) and keeps the first-person pose; the pause menu, a cutscene's event setting and the third-person camera
  setting still switch at once. A rate-limited [pose] line counts the frames kept since the run started.
- While the actor list misses the player, the hook still hides the head by that decision, and the root bone starts
  the frame's head-material list so it keeps or drops the last one. The list is kept for the 250 ms stall window only,
  and only while the actor at the remembered address still names itself GameROMPlayer, still holds the model the units
  were collected from, and the game is still animating that model; otherwise it is dropped, so a load, a teleport or
  the player's death cannot hand a freed model unit to setMaterialVisible.
---
 src/game/botw/player/head_visibility.cpp | 51 ++++++++++++++++++--
 src/game/botw/player/head_visibility.h   |  2 +-
 src/game/botw/player/skeleton.cpp        | 60 ++++++++++++++++++++++--
 3 files changed, 105 insertions(+), 8 deletions(-)

diff --git a/src/game/botw/player/head_visibility.cpp b/src/game/botw/player/head_visibility.cpp
index 5d713cf..85d543c 100644
--- a/src/game/botw/player/head_visibility.cpp
+++ b/src/game/botw/player/head_visibility.cpp
@@ -48,6 +48,16 @@ static uint32_t s_playerHeadMaterialCount = 0;
 static uint32_t s_playerHeadMaterialCursor = 0;
 static bool s_playerHeadMaterialsRefreshedThisFrame = false;
 
+// The player can be missing from the actor list for a frame while it rebuilds (the short camera stall the pose
+// tolerates, skeleton.cpp). The list is kept for that window only, and only while the actor it came from still names
+// itself the player and still holds the model the units were collected from: after a load, a teleport or the player's
+// death the units are freed, and their memory can still look intact to the checks below.
+static constexpr auto kMissingPlayerTolerance = std::chrono::milliseconds(250);
+static uint32_t s_playerHeadMaterialActor = 0;
+static uint32_t s_playerHeadMaterialModel = 0;
+static bool s_playerHeadMaterialActorMissing = false;
+static std::chrono::steady_clock::time_point s_playerHeadMaterialMissingSince{};
+
 void HeadVisibility::OnSkeletonRoot() {
     s_playerHeadMaterialsRefreshedThisFrame = false;
 }
@@ -103,13 +113,46 @@ static uint32_t ResolveBaseProcLinkActor(uint32_t baseProcLinkAddress) {
     return linkData.actor.getLE();
 }
 
-static void RefreshPlayerHeadMaterials() {
+static void DropHeadMaterialList() {
     s_playerHeadMaterialCount = 0;
+    s_playerHeadMaterialActorMissing = false;
+}
 
+// the kept units still belong to the model the game is animating, and that model is still the live player's
+static bool IsSamePlayerActor(uint32_t gsysModelPtr) {
+    if (s_playerHeadMaterialActor == 0 || s_playerHeadMaterialModel != gsysModelPtr)
+        return false;
+    const auto name = Guest::Get<sead::FixedSafeString40>(s_playerHeadMaterialActor + offsetof(ActorWiiU, name));
+    if (name.getLE() != "GameROMPlayer")
+        return false;
+    return Guest::Get<uint32_t>(s_playerHeadMaterialActor + ActorGsysModelOffset).getLE() == s_playerHeadMaterialModel;
+}
+
+static void RefreshPlayerHeadMaterials(uint32_t gsysModelPtr) {
     const uint32_t playerActorPtr = Player::GetAddress();
-    if (playerActorPtr == 0) return;
+    if (playerActorPtr == 0) {
+        // a missing actor for a frame (the list rebuilds) keeps the last materials for the stall window only, and
+        // only while they still belong to the live player and its model; a rebuilt player gets a new list below
+        if (s_playerHeadMaterialCount == 0) {
+            s_playerHeadMaterialActorMissing = false;
+            return;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (!s_playerHeadMaterialActorMissing) {
+            s_playerHeadMaterialActorMissing = true;
+            s_playerHeadMaterialMissingSince = now;
+        }
+        if (now - s_playerHeadMaterialMissingSince >= kMissingPlayerTolerance || !IsSamePlayerActor(gsysModelPtr))
+            DropHeadMaterialList();
+        return;
+    }
+
+    s_playerHeadMaterialActorMissing = false;
+    s_playerHeadMaterialCount = 0;
+    s_playerHeadMaterialActor = playerActorPtr;
 
     const uint32_t playerModel = Guest::Get<uint32_t>(playerActorPtr + ActorGsysModelOffset).getLE();
+    s_playerHeadMaterialModel = playerModel;
     if (playerModel != 0)
         CollectHeadMaterialsFromModel(playerModel, false);
 
@@ -125,9 +168,9 @@ static bool IsLiveModelUnit(uint32_t unitPtr) {
     return vtablePtr == ModelUnitVtableAddress;
 }
 
-void HeadVisibility::SubmitNextMaterial(PPCInterpreter_t* hCPU, bool hideHead) {
+void HeadVisibility::SubmitNextMaterial(PPCInterpreter_t* hCPU, bool hideHead, uint32_t gsysModelPtr) {
     if (!s_playerHeadMaterialsRefreshedThisFrame) {
-        RefreshPlayerHeadMaterials();
+        RefreshPlayerHeadMaterials(gsysModelPtr);
         s_playerHeadMaterialsRefreshedThisFrame = true;
     }
     if (s_playerHeadMaterialCount == 0) return;
