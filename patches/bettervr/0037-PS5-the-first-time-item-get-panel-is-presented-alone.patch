From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Fri, 20 Nov 2026 17:42:50 +0100
Subject: [PATCH] PS5: the first-time item-get panel is presented alone in
 third person only; built, untested on console

Demo002_0's 3D picture is steady in first person and its camera cues step a frame at a time in third
person, so patch 0037's 2D-only presentation now follows the camera mode, the condition upstream's
black-bars path uses. Demo003_0 is unchanged.
---
 src/game/botw/game_state.cpp | 52 +++++++++++++++++++++++++-----------
 1 file changed, 37 insertions(+), 15 deletions(-)

diff --git a/src/game/botw/game_state.cpp b/src/game/botw/game_state.cpp
index 91b492c..31259fd 100644
--- a/src/game/botw/game_state.cpp
+++ b/src/game/botw/game_state.cpp
@@ -9,10 +9,17 @@
 #include "instance.h"
 
 static std::atomic_bool s_eventActive = false;
-// Demo003_0 is the Sheikah Slate download panel: a 2D picture the game keeps drawing a 3D scene behind, so
-// its frames stay fresh stereo pairs and the runtime's mono switch only fires near the end. Present the 2D
-// layer alone for the whole event, the way a black-bars cutscene is presented.
-static std::atomic_bool s_2DOnlyPresentation = false;
+// Demo002_0 (the first-time pick-up panel) and Demo003_0 (the Sheikah Slate download panel) are 2D pictures the
+// game keeps drawing a 3D scene behind, so their frames stay fresh stereo pairs and the runtime's mono switch
+// only fires near the end. Present the 2D layer alone for the whole event, the way a black-bars cutscene is
+// presented. Demo002_0's 3D picture is steady in first person and its camera cues step a frame at a time in third
+// person, so its panel is alone in third person only, the condition upstream's black-bars path uses.
+enum class TwoDOnly {
+    OFF,
+    ALWAYS,
+    THIRD_PERSON,
+};
+static std::atomic<TwoDOnly> s_2DOnlyPresentation = TwoDOnly::OFF;
 // the camera picked with the cutscene button, kept across events the game chains together
 static std::atomic<EventMode> s_eventModeOverride = EventMode::NO_EVENT;
 static std::atomic_uint32_t s_cameraToggles = 0;
@@ -156,7 +163,7 @@ static void hook_GetEventName(PPCInterpreter_t* hCPU) {
     const bool isEventActive = hCPU->gpr[3] != 0;
     if (!isEventActive) {
         if (!s_currentEvent.empty()) {
-            if (s_2DOnlyPresentation.exchange(false)) {
+            if (s_2DOnlyPresentation.exchange(TwoDOnly::OFF) != TwoDOnly::OFF) {
                 Log::print<INFO>("2D-only presentation ends for '{}'", s_currentEvent);
             }
             Log::print<INFO>("Event '{}' has now ended", s_currentEvent);
@@ -174,15 +181,7 @@ static void hook_GetEventName(PPCInterpreter_t* hCPU) {
     if (s_currentEvent == eventName && s_currentEntryPoint == entryPointName) {
         return;
     }
-    const bool twoDOnly = eventName == "Demo003_0";
-    if (s_2DOnlyPresentation.exchange(twoDOnly) != twoDOnly) {
-        if (twoDOnly) {
-            Log::print<INFO>("2D-only presentation starts for '{}' (the 2D layer alone, black around it)", eventName);
-        }
-        else {
-            Log::print<INFO>("2D-only presentation ends for '{}'", s_currentEvent);
-        }
-    }
+    const std::string previousEvent = s_currentEvent;
     s_currentEvent = eventName;
     s_currentEntryPoint = entryPointName;
     Events::Settings settings = defaultFirstPersonSettings;
@@ -198,6 +197,28 @@ static void hook_GetEventName(PPCInterpreter_t* hCPU) {
         Log::print<INFO>("Cleared the camera picked in the previous cutscene");
     }
     s_eventActive = true;
+    // Demo003_0's panel is alone in either camera mode; Demo002_0's 3D picture is steady in first person and its
+    // camera cues step a frame at a time in third person, so its panel follows the mode, the condition upstream's
+    // black-bars path uses.
+    const TwoDOnly twoDOnly = eventName == "Demo003_0" ? TwoDOnly::ALWAYS
+        : eventName == "Demo002_0" ? TwoDOnly::THIRD_PERSON
+        : TwoDOnly::OFF;
+    if (twoDOnly == TwoDOnly::THIRD_PERSON) {
+        if (GameState::IsThirdPerson()) {
+            Log::print<INFO>("2D-only presentation for 'Demo002_0' is on (this event is third person, the 2D layer alone, black around it)");
+        }
+        else {
+            Log::print<INFO>("2D-only presentation for 'Demo002_0' is off (this event is first person, its 3D picture stays)");
+        }
+    }
+    if (s_2DOnlyPresentation.exchange(twoDOnly) != twoDOnly) {
+        if (twoDOnly == TwoDOnly::OFF) {
+            Log::print<INFO>("2D-only presentation ends for '{}'", previousEvent);
+        }
+        else if (twoDOnly == TwoDOnly::ALWAYS) {
+            Log::print<INFO>("2D-only presentation starts for '{}' (the 2D layer alone, black around it)", eventName);
+        }
+    }
     PublishPresentation();
 }
 
@@ -222,7 +243,8 @@ bool GameState::IsThirdPerson() {
 }
 
 bool GameState::UseBlackBarsDuringEvents() {
-    if (Events::IsActive() && s_2DOnlyPresentation.load(std::memory_order_relaxed)) {
+    const TwoDOnly twoDOnly = s_2DOnlyPresentation.load(std::memory_order_relaxed);
+    if (Events::IsActive() && (twoDOnly == TwoDOnly::ALWAYS || (twoDOnly == TwoDOnly::THIRD_PERSON && IsThirdPerson()))) {
         return true;
     }
 
