From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Thu, 19 Nov 2026 05:24:35 +0100
Subject: [PATCH] PS5: 1x renders at the headset's 1984x2048 eye size, not a
 rules-compatible 2000x2040; built, untested on console

---
 src/utils/eye_resolution.h | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/utils/eye_resolution.h b/src/utils/eye_resolution.h
index 4db876c..fe05ac7 100644
--- a/src/utils/eye_resolution.h
+++ b/src/utils/eye_resolution.h
@@ -142,7 +142,13 @@ namespace EyeResolution {
             for (const bool wide : { false, true }) {
                 const double height = double(eyeHeight) * preset.multiplier;
                 const double width = wide ? std::max(double(eyeWidth) * preset.multiplier, height * 16.0 / 9.0) : double(eyeWidth) * preset.multiplier;
-                const auto [roundedWidth, roundedHeight] = GetNearestRulesCompatible(width, height, minimumWidth);
+                // 1x is the panel's own size, which the compositor samples 1:1. The texture-rule search
+                // preferred 2000x2040 here, and that non-integer scale to 1984x2048 is what shimmered.
+                const std::pair<uint32_t, uint32_t> size = (!wide && preset.multiplier == 1.0)
+                    ? std::pair<uint32_t, uint32_t>{ eyeWidth, eyeHeight }
+                    : GetNearestRulesCompatible(width, height, minimumWidth);
+                const uint32_t roundedWidth = size.first;
+                const uint32_t roundedHeight = size.second;
                 const std::string widthText = std::to_string(roundedWidth);
                 const std::string heightText = std::to_string(roundedHeight);
                 const std::string label = widthText + "x" + heightText;
