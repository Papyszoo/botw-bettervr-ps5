From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 16:39:53 +0100
Subject: [PATCH] PS5: the XR input reaches the game without the ImGui overlay,
 which only Windows makes

hook_InjectXRInput returned at once when the renderer's ImGui overlay was missing. framebuffer.cpp
makes that overlay under _WIN32 only, so on this port it never exists and the function never got
past its first lines: no Sense stick or button, no hand gesture, no game state, no haptics reached
the game; only the DualSense's own VPAD did (the boot log of the 2026-11-05 evening had no [diag]
line from the code after it). The overlay is now optional: the mod menu is skipped without it and
cannot be opened, so it cannot take the game's input. A [diag] line every 5 s says how often the
hook runs. A hand xrLocateSpace could not place is left out of the body-slot gestures, so a grip
press cannot fire one from the tracker's origin.
---
 src/hooking/controls.cpp | 42 ++++++++++++++++++++++++++++++++++------
 1 file changed, 36 insertions(+), 6 deletions(-)

diff --git a/src/hooking/controls.cpp b/src/hooking/controls.cpp
index 09d26e3..95ddc25 100644
--- a/src/hooking/controls.cpp
+++ b/src/hooking/controls.cpp
@@ -909,6 +909,12 @@ void processModMenuInput(std::atomic_bool& isMenuOpen, OpenXR::InputState& input
         inputs.shared.modMenuState.longFired_actedUpon = false;
     }
 
+    // without an overlay (the PS5 port) there is no menu to open: it would only take the game's input
+    if (!imguiOverlay) {
+        isMenuOpen = false;
+        return;
+    }
+
     // allow the gamepad inputs to control the imgui overlay
     imguiOverlay->ProcessInputs(inputs, vpadInputs);
 
@@ -927,11 +933,21 @@ void processHandGesture(RND_Renderer* renderer, OpenXR::InputState& inputs, Hand
         const auto headsetMtx = headsetPose.value();
         const glm::fvec3 headsetPos(headsetMtx[3]);
         
+        // A hand xrLocateSpace could not place has a zeroed location, which is the tracker's origin
+        // and not the player's body: the waist slot matches a hand there, so a grip press would open
+        // a body slot with a hand that is not tracked. That hand is left out of the gestures instead.
+        const auto handLocated = [](const XrSpaceLocation& location) {
+            return (location.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) != 0;
+        };
         const auto leftHandPos = ToGLM(inputs.shared.poseLocation[0].pose.position);
         const auto rightHandPos = ToGLM(inputs.shared.poseLocation[1].pose.position);
         
-        leftGesture = calculateHandGesture(gameState, leftHandPos, headsetMtx, headsetPos, gameState.left_hand_position_stored, gameState.stored_left_hand_position);
-        rightGesture = calculateHandGesture(gameState, rightHandPos, headsetMtx, headsetPos, gameState.right_hand_position_stored, gameState.stored_right_hand_position);
+        leftGesture = handLocated(inputs.shared.poseLocation[0])
+            ? calculateHandGesture(gameState, leftHandPos, headsetMtx, headsetPos, gameState.left_hand_position_stored, gameState.stored_left_hand_position)
+            : HandGestureState{};
+        rightGesture = handLocated(inputs.shared.poseLocation[1])
+            ? calculateHandGesture(gameState, rightHandPos, headsetMtx, headsetPos, gameState.right_hand_position_stored, gameState.stored_right_hand_position)
+            : HandGestureState{};
     }
 }
 
@@ -1032,17 +1048,29 @@ void CemuHooks::hook_InjectXRInput(PPCInterpreter_t* hCPU) {
     uint32_t vpadStatusOffset = hCPU->gpr[4];
     VPADStatus vpadStatus = {};
 
+    // PS5 diagnostics: that this hook runs at all, and where it leaves early, once per 5 s
+    static uint32_t s_hookCalls = 0, s_hookNoRenderer = 0;
+    static auto s_hookLast = std::chrono::steady_clock::now();
+    s_hookCalls++;
+    if (const auto hookNow = std::chrono::steady_clock::now(); hookNow - s_hookLast >= std::chrono::seconds(5)) {
+        s_hookLast = hookNow;
+        Log::print<INFO>("[diag] VPADRead hook: {} calls in 5 s, {} without a renderer", s_hookCalls, s_hookNoRenderer);
+        s_hookCalls = s_hookNoRenderer = 0;
+    }
+
     auto& xr = VRManager::instance().XR;
     auto* renderer = xr->GetRenderer();
     if (!renderer) {
+        s_hookNoRenderer++;
         return;
     }
     renderer->EnsureFrameInputLatched();
 
+    // PS5: the ImGui overlay is Win32-only (framebuffer.cpp creates it under _WIN32), so on this port it is
+    // never made. Returning here without it skipped the whole function: the XR sticks and buttons, the hand
+    // gestures, the game state, haptics and the motion never reached the game; only the DualSense's own
+    // VPAD did. The mod menu is the only thing that needs the overlay.
     auto* imguiOverlay = renderer->m_imguiOverlay.get();
-    if (!imguiOverlay) {
-        return;
-    }
 
     // todo: revert this to unblock gamepad input
     readMemory(vpadStatusOffset, &vpadStatus);
@@ -1057,7 +1085,9 @@ void CemuHooks::hook_InjectXRInput(PPCInterpreter_t* hCPU) {
             startBtnActionConsumed = false;
         }
         else if (!startBtnActionConsumed && std::chrono::steady_clock::now() - startBtnLastTime > std::chrono::milliseconds(500)) {
-            xr->m_isMenuOpen = !xr->m_isMenuOpen;
+            if (imguiOverlay) {
+                xr->m_isMenuOpen = !xr->m_isMenuOpen;
+            }
             startBtnActionConsumed = true;
         }
         startBtnWasDown = true;
