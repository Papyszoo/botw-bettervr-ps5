+    VkFramebuffer framebuffers[2][2] = { { VK_NULL_HANDLE, VK_NULL_HANDLE }, { VK_NULL_HANDLE, VK_NULL_HANDLE } };
+    bool ready = false;
+    bool failed = false;
+};
