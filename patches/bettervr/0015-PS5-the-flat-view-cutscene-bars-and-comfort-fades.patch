+// Created on the submit thread the first time a fade is drawn. Any failure leaves the flag set
+// and the fade is skipped, so a device that refuses the pipeline shows the scene and HUD as
+// before instead of a wrong overlay.
+static void DestroyFadeOverlayPipeline();
+
+static bool EnsureFadeOverlayPipeline() {
+    if (s_fadeOverlay.ready) return true;
+    if (s_fadeOverlay.failed) return false;
+    if (!s_linux) return false;
+
+    auto* dispatch = VRManager::instance().VK->GetDeviceDispatch();
+    VkDevice device = VRManager::instance().VK->GetDevice();
+    VkShaderModule vertModule = VK_NULL_HANDLE;
+    VkShaderModule fragModule = VK_NULL_HANDLE;
+    auto fail = [&](const char* what, VkResult result) {
+        Log::print<ERROR>("Fade overlay: {} failed ({}); the fade stays off", what, (int)result);
+        // Release whatever this attempt created, including the shader modules that are not part
+        // of the struct, then remember the failure so no later frame retries.
+        if (vertModule != VK_NULL_HANDLE) dispatch->DestroyShaderModule(device, vertModule, nullptr);
+        if (fragModule != VK_NULL_HANDLE) dispatch->DestroyShaderModule(device, fragModule, nullptr);
+        vertModule = VK_NULL_HANDLE;
+        fragModule = VK_NULL_HANDLE;
+        DestroyFadeOverlayPipeline();
+        s_fadeOverlay.failed = true;
+        return false;
+    };
+
+    VkAttachmentDescription attachment = {};
+    attachment.format = VK_FORMAT_R8G8B8A8_SRGB;
+    attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+    attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+    attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
