From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Fri, 20 Nov 2026 17:42:50 +0100
Subject: [PATCH] PS5: the first-time item-get panel presents the 2D layer
 alone for the whole event; built, untested on console

---
 src/game/botw/game_state.cpp | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/game/botw/game_state.cpp b/src/game/botw/game_state.cpp
index 91b492c..c60f6d5 100644
--- a/src/game/botw/game_state.cpp
+++ b/src/game/botw/game_state.cpp
@@ -9,9 +9,10 @@
 #include "instance.h"
 
 static std::atomic_bool s_eventActive = false;
-// Demo003_0 is the Sheikah Slate download panel: a 2D picture the game keeps drawing a 3D scene behind, so
-// its frames stay fresh stereo pairs and the runtime's mono switch only fires near the end. Present the 2D
-// layer alone for the whole event, the way a black-bars cutscene is presented.
+// Demo002_0 (the first-time pick-up panel) and Demo003_0 (the Sheikah Slate download panel) are 2D pictures the
+// game keeps drawing a 3D scene behind, so their frames stay fresh stereo pairs and the runtime's mono switch
+// only fires near the end. Present the 2D layer alone for the whole event, the way a black-bars cutscene is
+// presented.
 static std::atomic_bool s_2DOnlyPresentation = false;
 // the camera picked with the cutscene button, kept across events the game chains together
 static std::atomic<EventMode> s_eventModeOverride = EventMode::NO_EVENT;
@@ -174,7 +175,7 @@ static void hook_GetEventName(PPCInterpreter_t* hCPU) {
     if (s_currentEvent == eventName && s_currentEntryPoint == entryPointName) {
         return;
     }
-    const bool twoDOnly = eventName == "Demo003_0";
+    const bool twoDOnly = eventName == "Demo002_0" || eventName == "Demo003_0";
     if (s_2DOnlyPresentation.exchange(twoDOnly) != twoDOnly) {
         if (twoDOnly) {
             Log::print<INFO>("2D-only presentation starts for '{}' (the 2D layer alone, black around it)", eventName);
