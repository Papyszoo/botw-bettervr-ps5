From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patryk Kowalczyk <papyszoo@gmail.com>
Date: Fri, 6 Nov 2026 16:44:25 +0100
Subject: [PATCH] PS5: the flat view shows the scene and a menu keeps the last
 stereo pair

---
 src/hooking/entity_controller.cpp         |   9 ++
 src/rendering/renderer_members_vulkan.inc |   2 +-
 src/rendering/renderer_vulkan.cpp         | 138 ++++++++++++++++------
 3 files changed, 110 insertions(+), 39 deletions(-)

diff --git a/src/hooking/entity_controller.cpp b/src/hooking/entity_controller.cpp
index b83b98d..bad28c2 100644
--- a/src/hooking/entity_controller.cpp
+++ b/src/hooking/entity_controller.cpp
@@ -675,6 +675,15 @@ extern "C" bool BetterVR_PS5_Fades() {
     return s_fades;
 }
 
+// PS5: bettervr.json's flatScene (default on), cached once. On, the scope / Camera rune shows the
+// mono/left 3D scene with the HUD composited over it, and a menu keeps the last stereo pair instead
+// of projecting its mono capture; off is the old HUD-only flat quad and stereo menu. The renderer
+// reads this and runtime.cpp logs the same value.
+extern "C" bool BetterVR_PS5_FlatScene() {
+    static const bool s_flatScene = BetterVR_PS5_Setting("flatScene", 1.0f) >= 0.5f;
+    return s_flatScene;
+}
+
 // PS5: bettervr.json's poseFreeze (default on), cached once. On, the left eye's BeginCameraSide
 // promotes one view pair and both eyes of that pair render and copy it; off is the old per-read
 // latch. The renderer reads this and runtime.cpp logs the same value.
diff --git a/src/rendering/renderer_members_vulkan.inc b/src/rendering/renderer_members_vulkan.inc
index 5f13b54..0700f21 100644
--- a/src/rendering/renderer_members_vulkan.inc
+++ b/src/rendering/renderer_members_vulkan.inc
@@ -11,7 +11,7 @@ void LinuxBeginStereoCaptureGeneration(long frameIdx);
