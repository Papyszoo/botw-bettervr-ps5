 }
 
+// Eye Aim Assist bends a player's arrow toward where the player looks, by no more than 5 degrees, and
+// only while the gaze is already inside that cone of the aim: a gaze further off leaves the arrow where
+// the bow points. The target moves with the direction, so a homing arrow and the actor's launch
+// transform agree.
+static bool ApplyEyeAimBowAssist(BowVisualizationState& state) {
+    constexpr float maxBendDegrees = 5.0f;
+    constexpr float gazeDistance = kLaunchTargetDistance;
+
+    if (!GetSettings().eyeAimAssist || !state.hasLaunchOrigin || !state.hasLaunchDirection)
+        return false;
+    const std::optional<glm::fvec3> gaze = Tracking::EyeGaze();
+    if (!gaze.has_value() || !HasFiniteDirection(*gaze))
+        return false;
+    const std::optional<glm::fmat4> head = Tracking::HeadPose();
+    if (!head.has_value())
+        return false;
+
+    const glm::mat4 reference = Camera::GetReferenceMtx();
+    const glm::vec3 headWorld = glm::vec3(reference * glm::vec4(glm::vec3((*head)[3]), 1.0f));
+    const glm::vec3 target = headWorld + glm::normalize(glm::mat3(reference) * glm::normalize(*gaze)) * gazeDistance;
+    if (!HasFiniteDirection(target - state.launchOrigin))
+        return false;
+    const glm::vec3 wanted = glm::normalize(target - state.launchOrigin);
+
+    const glm::vec3 aim = glm::normalize(state.launchDirection);
+    const float angle = std::acos(glm::clamp(glm::dot(aim, wanted), -1.0f, 1.0f));
+    if (angle > glm::radians(maxBendDegrees) || angle < glm::radians(0.5f))
+        return false;
+
+    float targetDistance = kLaunchTargetDistance;
+    if (state.hasTargetPos && IsFiniteVec3(state.targetPos)) {
+        const float distance = glm::distance(state.launchOrigin, state.targetPos);
+        if (std::isfinite(distance) && distance > 0.0001f)
+            targetDistance = distance;
+    }
+
+    state.launchDirection = wanted;
+    state.targetPos = state.launchOrigin + wanted * targetDistance;
+    state.hasTargetPos = true;
+    state.eyeAimAssisted = true;
+    state.eyeAimRawDegrees = glm::degrees(angle);
+    state.eyeAimAppliedDegrees = glm::degrees(angle);
+    return true;
+}
+
 static bool TryBuildBowVisualizationState(BowVisualizationState& outState, long cameraFrameIdx = -1) {
     outState = {};
 
@@ -1214,6 +1262,8 @@ static bool TryBuildBowVisualizationState(BowVisualizationState& outState, long
         }
     }
 
+    ApplyEyeAimBowAssist(outState);
+
     outState.launchSpeed = liveBowState.launchSpeed;
     outState.firstSpeed = outState.hasLaunchDirection ? outState.launchDirection * outState.launchSpeed : glm::vec3(0.0f, 0.0f, -outState.launchSpeed);
     outState.relativeVel = glm::vec3(0.0f);
@@ -1441,6 +1491,10 @@ static void hook_OverrideArrowShotTransform(PPCInterpreter_t* hCPU) {
         if (TryBuildBowVisualizationState(launchState) && launchState.hasLaunchOrigin && launchState.hasLaunchDirection) {
             StorePendingShotOverride(launchState);
             SetTransformFromLaunchPose(transform, launchState.launchOrigin, launchState.launchDirection);
+            if (launchState.eyeAimAssisted) {
+                Log::print<INFO>("[BowShot] eye aim assist: arrow, {:.1f} degrees to gaze, {:.1f} applied",
+                    launchState.eyeAimRawDegrees, launchState.eyeAimAppliedDegrees);
+            }
             Log::print<ARROW_SHOT_CAPTURE>(
                 "[BowShot] Override transform origin={} direction={} previewAi=0x{:08X}",
                 launchState.launchOrigin,
