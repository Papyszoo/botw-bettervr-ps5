-			PS5_NoteCopy(fmt::format("clamp {} {} {} {} {}x{}x{}", (int)srcVk->GetFormat(), (int)dstVk->GetFormat(), srcMip, dstMip,
-							 effectiveCopyWidth, effectiveCopyHeight, srcDepth),
-				fmt::format("[copy] image clamped: VkFormat {} mip {} -> VkFormat {} mip {}, {}x{} x{} layers asked, {}x{} x{} copied{}",
+			if (PS5_CopyNoteWanted(PS5_CopyKey({2, (uint32)srcVk->GetFormat(), (uint32)dstVk->GetFormat(), (uint32)srcMip, (uint32)dstMip,
+					(uint32)effectiveCopyWidth, (uint32)effectiveCopyHeight, (uint32)srcDepth}), false))
+				PS5Cemu_LogLine(fmt::format("[copy] image clamped: VkFormat {} mip {} -> VkFormat {} mip {}, {}x{} x{} layers asked, {}x{} x{} copied{}",
 					(int)srcVk->GetFormat(), srcMip, (int)dstVk->GetFormat(), dstMip, effectiveCopyWidth, effectiveCopyHeight, srcDepth,
-					std::max(width, 0), std::max(height, 0), std::max(layers, 0), width <= 0 || height <= 0 || layers <= 0 ? " (nothing: skipped)" : ""),
-				false);
+					std::max(width, 0), std::max(height, 0), std::max(layers, 0), width <= 0 || height <= 0 || layers <= 0 ? " (nothing: skipped)" : ""));
 			if (width <= 0 || height <= 0 || layers <= 0)
 				return;
 			effectiveCopyWidth = width;
@@ -4340,14 +4342,17 @@ void VulkanRenderer::texture_copyImageSubData(LatteTexture* src, sint32 srcMip,
 		const bool layersOk = (src->Is3DTexture() || srcSlice + srcDepth <= (sint32)src->depth) &&
 			(dst->Is3DTexture() || dstSlice + srcDepth <= (sint32)dst->depth);
 		const bool overrun = !srcOk || !dstOk || !layersOk;
-		sint32 srcW, srcH, dstW, dstH; // the images' real (mip 0) sizes, for the line
