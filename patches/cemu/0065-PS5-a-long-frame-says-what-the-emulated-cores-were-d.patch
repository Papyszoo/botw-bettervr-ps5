 uint32 prevScissorX = 0;
@@ -811,6 +814,19 @@ std::atomic<uint64> g_ps5FrameVrEndNs{0};
 std::atomic<uint32> g_ps5FrameProfileSamples{0};
 extern uint64 _rdtscFrequency;
 static uint64 s_ps5LastSwapTsc = 0;
+
+// The long-frame line (patches/cemu 0065): one [stall] line for a frame over 34 ms, with as much of
+// its split as the counters give, and the AX output's feed gap at that moment (port/cemu/PS5AxFeed.h).
+// At most one every 200 ms: a run of long frames is on the [perf] line's counts. The stereo pass and
+// the GPU waits are deltas between two swaps, so they are the frame's own work up to its swap. A
+// second line samples what the emulated cores were doing at that instant (port/cemu/PS5CoreDiag.h).
+extern std::atomic<uint64> g_ps5RecordNs; // VulkanRendererCore.cpp
+extern std::atomic<uint64> g_ps5ReplayNs;
+extern std::atomic<uint64> g_ps5GpuWaitTicks[6]; // VulkanRenderer.cpp
+void PS5Cemu_LogLine(std::string_view line);	 // the port's boot log, written at once
+static uint64 s_ps5PrevRecordNs = 0, s_ps5PrevReplayNs = 0;
+static uint64 s_ps5PrevGpuWait[6] = {};
+static uint64 s_ps5LastStallTsc = 0;
 static uint64 TscToNs(uint64 ticks)
 {
 	return _rdtscFrequency ? ticks * 1000000000ull / _rdtscFrequency : 0;
@@ -835,6 +851,48 @@ void LatteRenderTarget_itHLESwapScanBuffer()
 			while (us > longest && !g_ps5LongestFrameUs.compare_exchange_weak(longest, us, std::memory_order_relaxed))
 			{
 			}
+			// at most one line every 200 ms (a fifth of a second in TSC ticks): a run of long frames
+			// is on the [perf] line's counts
+			if (us > 34000 && (s_ps5LastStallTsc == 0 || now - s_ps5LastStallTsc >= _rdtscFrequency / 5))
+			{
+				s_ps5LastStallTsc = now;
+				const uint64 recordNow = g_ps5RecordNs.load(std::memory_order_relaxed);
+				const uint64 replayNow = g_ps5ReplayNs.load(std::memory_order_relaxed);
+				// The [draws] line zeroes both of these every 5 s on this thread, later in the same
+				// frame (port/bettervr/xr/runtime.cpp's FrameEndedByDraws). A frame that swaps just
+				// after that would subtract across the reset and print a stereo pass of 1.8e13 ms;
+				// then the counter holds only what this frame added, so that is the delta.
+				const uint64 recordNs = recordNow >= s_ps5PrevRecordNs ? recordNow - s_ps5PrevRecordNs : recordNow;
+				const uint64 replayNs = replayNow >= s_ps5PrevReplayNs ? replayNow - s_ps5PrevReplayNs : replayNow;
+				uint64 waitNs[6]{};
+				uint64 waitsTotalNs = 0;
+				for (int kind = 0; kind < 6; kind++)
+				{
+					waitNs[kind] = TscToNs(g_ps5GpuWaitTicks[kind].load(std::memory_order_relaxed) - s_ps5PrevGpuWait[kind]);
+					waitsTotalNs += waitNs[kind];
+				}
+				const ps5ax::FeedStats ax = ps5ax::PeekFeedGap();
+				// "waiting for the game" is this frame's GPU-thread idle: Cemu's command processor
+				// waited for the emulated CPU, so the frame is the guest's, not the GPU thread's.
+				// Everything on this line is this frame's own: the window's longest gap and the feed
+				// counts are on the [perf] line, where the window is named.
+				PS5Cemu_LogLine(fmt::format(
+					"[stall] frame {:.1f} ms: waiting for the game {:.1f} ms, stereo pass {:.1f} ms (record {:.1f}, replay {:.1f}), "
+					"GPU waits {:.1f} ms (the previous frame {:.1f}, an image {:.1f}, its fence {:.1f}, a present {:.1f}, presenting {:.1f}, "
+					"other {:.1f}); AX {:.1f} ms since the last frame and {:.1f} ms since the last block; "
+					"driver submit, textures, images and copies not timed",
+					us / 1000.0, PPCTimer_tscToMicroseconds(performanceMonitor.gpuTime_idleTime.getCurrentFrameValue()) / 1000.0,
+					(recordNs + replayNs) / 1e6, recordNs / 1e6, replayNs / 1e6, waitsTotalNs / 1e6, waitNs[0] / 1e6, waitNs[1] / 1e6,
+					waitNs[2] / 1e6, waitNs[3] / 1e6, waitNs[4] / 1e6, waitNs[5] / 1e6, ax.sinceLastFrameNs / 1e6,
+					ax.sinceLastBlockNs / 1e6));
+				// what the emulated cores were doing while this frame was long: a sample, at this
+				// instant, of state each core publishes about itself (port/cemu/PS5CoreDiag.h)
+				PS5Cemu_LogLine("[stall] " + ps5diag::Describe(ps5diag::Take(ps5ax::NowNs())));
+			}
+			s_ps5PrevRecordNs = g_ps5RecordNs.load(std::memory_order_relaxed);
+			s_ps5PrevReplayNs = g_ps5ReplayNs.load(std::memory_order_relaxed);
+			for (int kind = 0; kind < 6; kind++)
+				s_ps5PrevGpuWait[kind] = g_ps5GpuWaitTicks[kind].load(std::memory_order_relaxed);
 		}
 		s_ps5LastSwapTsc = now;
 	}
