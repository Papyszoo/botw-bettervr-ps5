 void swkbd_keyInput(uint32 keyCode);
 #if defined(CEMU_PS5)
 void swkbd_inputStringChanged();
 void swkbd_finishInput();
+void swkbd_cancelInput();
 // PS5Cemu (ps5cemu/port/app/ingame.cpp) draws the keyboard over the game as it draws its 3DS
 // keyboard: in its menus' language, keys and typeface, read from the DualSense. It changes the form's
 // text (UTF-16) to at most maxLength units (counted: a length the game set, which it shows), starts
 // over when appearance changes, and returns true when the text is done. keyboardOnly says the game
 // asked for the keyboard alone (SwkbdAppearKeyboard), not its form.
 bool PS5Cemu_DrawKeyboard(std::u16string& text, sint32 maxLength, bool counted, uint32 appearance, bool keyboardOnly);
-#endif
-void swkbd_render(bool mainWindow)
-{
-	// only render if active
-	if( swkbdInternalState == NULL || swkbdInternalState->isActive == false)
-		return;
-#if defined(CEMU_PS5)
-	if (!mainWindow)
-		return;
-	// the length swkbd_keyInput allows, within the form
-	sint32 maxLength = swkbdInternalState->maxTextLength;
-	if (swkbdInternalState->keyboardOnlyMode)
+// The same keyboard in BetterVR's stereo frames: the console's own dialog (port/app/ime_dialog.cpp).
+// text is the form's while the game has its keyboard up, nullptr once it has dismissed it, so the
+// dialog is ended even when nothing draws. Called every TV frame from LatteRenderTarget, outside Cemu's
+// ImGui frame, which ImguiBegin can decline. 0 while it is up, 1 when the text is decided (OK, the
+// form's), 2 when it is cancelled: the game's keyboard then ends as a cancel on the hardware does.
+int PS5Cemu_DrawKeyboardVR(std::u16string* text, sint32 maxLength, uint32 appearance, bool keyboardOnly);
+
+namespace
+{
+	// The form as the port's keyboard takes it: its text in UTF-16, the length its key input allows,
+	// and whether that length is the game's (which it shows) rather than the form's maximum.
+	struct PS5SwkbdText
 	{
-		const uint32 stringBufferSize = swkbdInternalState->keyboardArg.receiverArg.stringBufSize;
-		maxLength = stringBufferSize > 1 ? (sint32)stringBufferSize - 1 : 0;
+		std::u16string text;
+		sint32 maxLength = 0;
+		bool counted = false;
+	};
+
+	PS5SwkbdText PS5SwkbdReadText()
+	{
+		PS5SwkbdText out;
+		sint32 maxLength = swkbdInternalState->maxTextLength;
+		if (swkbdInternalState->keyboardOnlyMode)
+		{
+			const uint32 stringBufferSize = swkbdInternalState->keyboardArg.receiverArg.stringBufSize;
+			maxLength = stringBufferSize > 1 ? (sint32)stringBufferSize - 1 : 0;
+		}
+		out.maxLength = std::clamp<sint32>(maxLength, 0, SWKBD_FORM_STRING_MAX_LENGTH - 1);
+		out.counted = out.maxLength < SWKBD_FORM_STRING_MAX_LENGTH - 1;
+		for (sint32 i = 0; i < swkbdInternalState->formStringLength; i++)
+			out.text.push_back((char16_t)swkbdInternalState->formStringBuffer[i]);
+		return out;
 	}
-	maxLength = std::clamp<sint32>(maxLength, 0, SWKBD_FORM_STRING_MAX_LENGTH - 1);
-	std::u16string text;
-	for (sint32 i = 0; i < swkbdInternalState->formStringLength; i++)
-		text.push_back((char16_t)swkbdInternalState->formStringBuffer[i]);
-	const std::u16string before = text;
-	const bool done = PS5Cemu_DrawKeyboard(text, maxLength, maxLength < SWKBD_FORM_STRING_MAX_LENGTH - 1, s_ps5Appearances,
-		swkbdInternalState->keyboardOnlyMode);
-	if (text != before)
+
+	// what the port typed, into the form: its length within maxLength, and the game told it changed
+	void PS5SwkbdWriteText(const std::u16string& text, sint32 maxLength)
 	{
 		const sint32 length = std::min((sint32)text.size(), maxLength);
 		for (sint32 i = 0; i < length; i++)
@@ -446,6 +583,23 @@ void swkbd_render(bool mainWindow)
 		swkbdInternalState->formStringLength = length;
 		swkbd_inputStringChanged();
 	}
+}
+#endif
+void swkbd_render(bool mainWindow)
+{
+	// only render if active
+	if( swkbdInternalState == NULL || swkbdInternalState->isActive == false)
+		return;
+#if defined(CEMU_PS5)
+	if (!mainWindow)
+		return;
+	// flat play's sheet. In stereo with the headset up PS5Cemu_DrawKeyboard declines it and
+	// swkbd_renderVR drives the console's dialog instead.
+	PS5SwkbdText form = PS5SwkbdReadText();
+	const std::u16string before = form.text;
+	const bool done = PS5Cemu_DrawKeyboard(form.text, form.maxLength, form.counted, s_ps5Appearances, swkbdInternalState->keyboardOnlyMode);
+	if (form.text != before)
+		PS5SwkbdWriteText(form.text, form.maxLength);
 	if (done)
 		swkbd_finishInput();
 	return;
@@ -606,6 +760,44 @@ void swkbd_render(bool mainWindow)
 	ImGui::PopStyleColor();
 }
 
+#if defined(CEMU_PS5)
+// The console's keyboard in BetterVR's stereo frames, from swkbd's own state: LatteRenderTarget calls
+// this every TV frame, outside Cemu's ImGui frame, so the dialog opens, is polled and is ended
+// whether or not that frame draws (ImguiBegin can decline). Flat play's sheet stays in swkbd_render.
+void swkbd_renderVR()
+{
+	if (swkbdInternalState == NULL || swkbdInternalState->isActive == false)
+	{
+		PS5Cemu_DrawKeyboardVR(nullptr, 0, 0, false); // a dialog the game dismissed is ended here
+		return;
+	}
+	PS5SwkbdText form = PS5SwkbdReadText();
+	const std::u16string before = form.text;
+	const int answer = PS5Cemu_DrawKeyboardVR(&form.text, form.maxLength, s_ps5Appearances, swkbdInternalState->keyboardOnlyMode);
+	if (form.text != before)
+		PS5SwkbdWriteText(form.text, form.maxLength);
+	if (answer == 1)
+		swkbd_finishInput();
+	else if (answer == 2)
+		swkbd_cancelInput();
+}
+
+// Ends the keyboard the way a cancel on the console's own does: it disappears with no OK pressed, and
+// the form's text stays what it was. The game, which polls SwkbdGetStateKeyboard/InputForm and
+// SwkbdIsDecideOkButton, then leaves the input it was waiting in instead of waiting forever. The port's
+// dialog calls it through swkbd_renderVR when the player cancels, when no dialog can open, or when one
+// is abandoned; never the other way round, so a game's own disappear is untouched.
+void swkbd_cancelInput()
+{
+	if (swkbdInternalState == NULL || swkbdInternalState->isActive == false)
+		return;
+	swkbdInternalState->decideButtonWasPressed = false;
+	swkbdInternalState->isActive = false;
+	if (s_ps5SwkbdLog.cancel++ < 8)
+		PS5SwkbdLogLine(fmt::format("[swkbd] cancel: {}", swkbdInternalState->keyboardOnlyMode ? "keyboard" : "form"));
+}
+#endif
+
 bool swkbd_hasKeyboardInputHook()
 {
 	return swkbdInternalState != NULL && swkbdInternalState->isActive;
@@ -737,6 +929,10 @@ namespace swkbd
 			s_swkbdStaticData.Allocate();
 			isNeedCalcSubThreadFont = 0;
 			isNeedCalcSubThreadPredict = 0;
+#if defined(CEMU_PS5)
+			if (s_ps5SwkbdLog.mapped++ < 2)
+				PS5SwkbdLogLine("[swkbd] HLE module mapped");
+#endif
 			cafeExportRegisterFunc(SwkbdCreate, "swkbd", "SwkbdCreate__3RplFPUcQ3_2nn5swkbd10RegionTypeUiP8FSClient", LogType::SWKBD);
 			cafeExportRegisterFunc(SwkbdCalc, "swkbd", "SwkbdCalc__3RplFRCQ3_2nn5swkbd14ControllerInfo", LogType::SWKBD);
 			cafeExportRegisterFunc(SwkbdGetStateKeyboard, "swkbd", "SwkbdGetStateKeyboard__3RplFv", LogType::SWKBD);
