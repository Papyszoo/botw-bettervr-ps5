 #include "Cafe/OS/libs/coreinit/coreinit_Alarm.h"
 #include "Cafe/OS/libs/coreinit/coreinit_GHS.h"
 #include "Cafe/OS/libs/snd_core/ax.h"
+#if defined(CEMU_PS5)
+#include "PS5AxPump.h" // ps5cemu/port/cemu: whether an idle core other than the main one runs the AX pump
+#endif
 #include "Cafe/HW/Espresso/Debugger/GDBStub.h"
 #include "Cafe/HW/Espresso/Interpreter/PPCInterpreterInternal.h"
 #include "Cafe/HW/Espresso/Recompiler/PPCRecompiler.h"
@@ -1236,7 +1239,7 @@ namespace coreinit
 	void __OSCheckSystemEvents()
 	{
 		// AX update
-		snd_core::AXOut_update();
+		snd_core::AXOut_update(t_assignedCoreIndex);
 		// alarm update
 		coreinit::alarm_update();
 		// nfp update
@@ -1253,6 +1256,20 @@ namespace coreinit
 	// 0: at every turn of the loop, as everywhere else
 	uint64 g_ps5IdleEventTicks = 0;
 	static uint64 s_ps5LastIdleEvents = 0; // the main core's thread's only
+
+	// PS5: another core's idle loop asks the AX output for a frame, at the main core's idleEventsUs
+	// spacing. The audio output is not the main core's alone (bettervr.json's audioAnyCore): while
+	// that core runs or sits in a host call, a core with no runnable thread keeps the 3 ms pace, and
+	// AXOut_update's gate makes exactly one caller an update at a time.
+	static void PS5_CoreIdleAxPump(sint32 coreIndex)
+	{
+		static uint64 s_lastEvents[3] = {};
+		const uint64 now = __rdtsc();
+		if (g_ps5IdleEventTicks != 0 && now - s_lastEvents[coreIndex] < g_ps5IdleEventTicks)
+			return;
+		s_lastEvents[coreIndex] = now;
+		snd_core::AXOut_update(coreIndex);
+	}
 #endif
 
 	// idle fiber per core if no thread is runnable
@@ -1307,8 +1324,17 @@ namespace coreinit
 				// thread wake-up latency; then asleep, as everywhere else
 				// (coreIndex is t_assignedCoreIndex here, without a thread-local read each turn: on the
 				// console thread_local is emulated, a call into the system library)
+				// and the audio output's pump on the way in and while spinning, when bettervr.json's
+				// audioAnyCore lets a core other than the main one run it (patch 0065)
+				const bool pumpAudio = ps5ax::AnyCore();
+				if (pumpAudio)
+					PS5_CoreIdleAxPump(coreIndex);
 				for (uint32 spin = g_ps5IdleSpinIterations; spin && g_coreRunQueueThreadCount[coreIndex].isZeroNow(); spin--)
+				{
 					_mm_pause();
+					if (pumpAudio && (spin & 63) == 0)
+						PS5_CoreIdleAxPump(coreIndex);
+				}
 #endif
 				g_coreRunQueueThreadCount[t_assignedCoreIndex].waitUntilNonZero();
 				if (!sSchedulerActive.load(std::memory_order::relaxed))
