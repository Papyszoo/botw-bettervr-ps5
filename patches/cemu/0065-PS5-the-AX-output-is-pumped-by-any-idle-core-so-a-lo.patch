index 0d9d930f..223a346c 100644
--- a/src/Cafe/OS/libs/snd_core/ax_out.cpp
+++ b/src/Cafe/OS/libs/snd_core/ax_out.cpp
@@ -4,6 +4,21 @@
 #include "config/CemuConfig.h"
 #include "Common/CafeStaticVar.h"
 
+#if defined(CEMU_PS5)
+#include "PS5AxPump.h" // ps5cemu/port/cemu: the pump's pacing, its one-caller gate and its feed gap
