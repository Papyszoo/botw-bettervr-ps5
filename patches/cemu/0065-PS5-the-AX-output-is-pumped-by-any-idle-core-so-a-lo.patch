+	ps5ax::FeedGap s_axFeedGap;
+	std::atomic<bool> s_axAnyCore{true}; // bettervr.json's audioAnyCore, on unless the file says 0
+}
+#endif
+
 namespace snd_core
 {
 	uint32 numProcessedFrames = 0;
@@ -184,6 +199,10 @@ namespace snd_core
 		{
 			if(g_tvAudio)
 				g_tvAudio->FeedBlock(tempTVChannelData);
+#if defined(CEMU_PS5)
+			// the gap between two blocks is what the console's queue sees (port/cemu/PS5AxPump.h)
+			s_axFeedGap.Block(ps5ax::NowNs());
+#endif
 
 			tempAudioBlockCounter = 0;
 		}
@@ -476,8 +495,24 @@ namespace snd_core
 	}
 
 	// called periodically to check for AX updates
-	void AXOut_update()
+	// coreIndex: the emulated core whose idle loop calls it (-1: not an idle loop's), for the feed gap's
+	// per-core counts
+	void AXOut_update(sint32 coreIndex)
 	{
+#if defined(CEMU_PS5)
+		// one caller at a time (patches/cemu 0065): with audioAnyCore every idle core asks for the pump,
+		// and the first one in queues this turn's frame while the others leave it to that one. Nothing
+		// waits, and this function never re-enters the gate, so the pacing below and Cemu's one frame in
+		// flight are the same as with the main core alone.
+		static ps5ax::Gate s_pumpGate;
+		if (!s_pumpGate.TryEnter())
+			return;
+		struct LeaveGate
+		{
+			ps5ax::Gate& gate;
+			~LeaveGate() { gate.Leave(); }
+		} leaveGate{s_pumpGate};
+#endif
 		constexpr static auto kTimeout = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::milliseconds(((IAudioAPI::kBlockCount * 3) / 4) * (AX_FRAMES_PER_GROUP * 3)));
 		constexpr static auto kWaitDuration = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::milliseconds(3));
 		constexpr static auto kWaitDurationFast = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::microseconds(2900));
@@ -493,6 +528,18 @@ namespace snd_core
 
 		const auto wait_duration = additional_blocks_required ? kWaitDurationFast : kWaitDuration;
 
+#if defined(CEMU_PS5)
+		// the same schedule as below, in the port's Pacer so the PC test runs it
+		// (tools/tests/test-ax-pump.cpp): the frame's place is kept on host time, whichever core calls
+		const auto nowNs = ps5ax::NowNs();
+		static ps5ax::Pacer s_pacer(nowNs, (uint64_t)kWaitDuration.count());
+		const ps5ax::Pacer::Step step = s_pacer.Due(nowNs, (uint64_t)wait_duration.count(), (uint64_t)kWaitDurationMinimum.count(), (uint64_t)kTimeout.count());
+		if (!step.frame)
+			return;
+		if (step.skipped)
+			s_axFeedGap.Skipped();
+#else
+		(void)coreIndex; // the port's per-core feed counts are the console's (CEMU_PS5)
 		// s_ax_interval_timer increases by the wait period
 		// it can lag behind by multiple periods (up to kTimeout) if there is minor stutter in the CPU thread
 		// s_last_check is always set to the timestamp at the time of firing
@@ -517,6 +564,7 @@ namespace snd_core
 			s_ax_interval_timer = (now - wait_duration);
 		else
 			s_ax_interval_timer += wait_duration;
+#endif
 
 
 		if (snd_core::isInitialized())
@@ -526,8 +574,41 @@ namespace snd_core
 				AXOut_updateDevicePlayState(true);
 				snd_core::AXIst_QueueFrame();
 				numQueuedFramesSndGeneric++;
+#if defined(CEMU_PS5)
+				s_axFeedGap.Fed(nowNs, coreIndex);
+#endif
 			}
 		}
 	}
 
 }
+
+#if defined(CEMU_PS5)
+namespace ps5ax
+{
+	uint64_t NowNs()
+	{
+		return (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(now_cached().time_since_epoch()).count();
+	}
+
+	bool AnyCore()
+	{
+		return s_axAnyCore.load(std::memory_order_relaxed);
+	}
+
+	void SetAnyCore(bool on)
+	{
+		s_axAnyCore.store(on, std::memory_order_relaxed);
+	}
+
+	FeedStats PeekFeedGap()
+	{
+		return s_axFeedGap.Peek(NowNs());
+	}
+
+	FeedStats TakeFeedGap()
+	{
+		return s_axFeedGap.Take(NowNs());
+	}
+}
+#endif
