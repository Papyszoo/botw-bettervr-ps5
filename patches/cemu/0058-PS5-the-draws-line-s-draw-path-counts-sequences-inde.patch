+#endif
 
 	draw_setRenderPass();
 	if (m_view.restoreBindings)
@@ -1649,6 +1728,9 @@ void VulkanRenderer::draw_execute_continued(uint32 baseVertex, uint32 baseInstan
 	// prepare streamout
 	m_streamoutState.verticesPerInstance = count;
