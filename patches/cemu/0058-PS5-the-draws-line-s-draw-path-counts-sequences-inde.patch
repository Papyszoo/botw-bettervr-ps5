+#endif
 
 	m_state.descriptorSetsChanged = false;
 	PipelineInfo* pipeline_info = m_state.activePipelineInfo;
@@ -1745,6 +1836,9 @@ void VulkanRenderer::draw_execute_continued(uint32 baseVertex, uint32 baseInstan
 		}
 #endif
