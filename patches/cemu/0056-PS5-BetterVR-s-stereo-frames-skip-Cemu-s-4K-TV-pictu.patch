From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Thu, 19 Nov 2026 05:21:50 +0100
Subject: [PATCH] PS5: BetterVR's stereo frames skip Cemu's 4K TV picture, Hmd2
 mirrors it; built, untested on console

---
 src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp b/src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp
index a6dbb816..f7656840 100644
--- a/src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp
+++ b/src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp
@@ -23,6 +23,9 @@
 #ifdef ENABLE_VULKAN
 #include "Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h"
 #endif
+#if defined(CEMU_PS5)
+#include "VrPS5.h" // BotW-BetterVR's stereo path (port/bettervr/VrPS5.h)
+#endif
 
 uint32 prevScissorX = 0;
 uint32 prevScissorY = 0;
@@ -1214,9 +1217,15 @@ void LatteRenderTarget_copyToBackbuffer(LatteTextureView* textureView, bool isPa
 	if (HostModule::HasModules() && g_renderer->GetType() == RendererAPI::Vulkan)
 		VulkanRenderer::GetInstance()->HostModule_DeliverScanBuffer(textureView, isPadView);
 #endif
-	g_renderer->DrawBackbufferQuad(textureView, shader, filter==LatteTextureView::MagFilter::kLinear, imageX, imageY, imageWidth, imageHeight, isPadView, clearBackground);
 #if defined(CEMU_PS5)
-	if (!isPadView)
+	// BetterVR stereo: Hmd2's social screen is the TV, and Cemu's 4K picture would only be scaled
+	// there a second time. The gamepad's view and the app's overlays still go through.
+	const bool ps5TvPicture = isPadView || !ps5vr::Stereo();
+	if (ps5TvPicture)
+#endif
+		g_renderer->DrawBackbufferQuad(textureView, shader, filter==LatteTextureView::MagFilter::kLinear, imageX, imageY, imageWidth, imageHeight, isPadView, clearBackground);
+#if defined(CEMU_PS5)
+	if (!isPadView && ps5TvPicture)
 	{
 		PS5Cemu_PostEffects();
 		LatteRenderTarget_ps5DrawSecondScreen(imageX, imageY, imageWidth, imageHeight);
