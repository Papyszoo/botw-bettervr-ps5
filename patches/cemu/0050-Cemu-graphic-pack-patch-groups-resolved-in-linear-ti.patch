From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patryk <papyszoo@gmail.com>
Date: Mon, 16 Nov 2026 11:03:14 +0100
Subject: [PATCH] Cemu: graphic pack patch groups resolved in linear time, with
 the full code cave (cemu-project/Cemu@babd690, @b044641)

patches/cemu 0050: BetterVR's thousands of patch groups were resolved in quadratic time at start, and each group now gets its full code cave.
---
 src/Cafe/GraphicPack/GraphicPack2Patches.h    |  2 ++
 .../GraphicPack/GraphicPack2PatchesApply.cpp  | 26 +++++++++----------
 .../GraphicPack/GraphicPack2PatchesParser.cpp |  4 +--
 3 files changed, 17 insertions(+), 15 deletions(-)

diff --git a/src/Cafe/GraphicPack/GraphicPack2Patches.h b/src/Cafe/GraphicPack/GraphicPack2Patches.h
index 4550506..c5bdca1 100644
--- a/src/Cafe/GraphicPack/GraphicPack2Patches.h
+++ b/src/Cafe/GraphicPack/GraphicPack2Patches.h
@@ -225,6 +225,8 @@ class PatchGroup
 	friend class GraphicPack2;
 
 public:
+	static constexpr uint32 CODECAVE_MAX_OFFSET = 8 * 1024 * 1024;
+
 	PatchGroup(class GraphicPack2* gp, const char* nameStr, sint32 nameLength) : graphicPack(gp)
 	{
 		name = std::string(nameStr, nameLength);
diff --git a/src/Cafe/GraphicPack/GraphicPack2PatchesApply.cpp b/src/Cafe/GraphicPack/GraphicPack2PatchesApply.cpp
index 783d2f0..15fb866 100644
--- a/src/Cafe/GraphicPack/GraphicPack2PatchesApply.cpp
+++ b/src/Cafe/GraphicPack/GraphicPack2PatchesApply.cpp
@@ -8,7 +8,7 @@
 
 bool _relocateAddress(PatchGroup* group, PatchContext_t* ctx, uint32 addr, uint32& relocatedAddress)
 {
-	if (addr >= 0 && addr <= 1024 * 1024 * 8)
+	if (addr <= PatchGroup::CODECAVE_MAX_OFFSET)
 	{
 		// codecave address
 		relocatedAddress = group->getCodeCaveBase() + addr;
@@ -514,37 +514,31 @@ bool _resolverPass(PatchContext_t& patchContext, std::vector<UnresolvedPatches_t
 	{
 		resolverState.currentGroup = unresolvedGroup.patchGroup;
 		auto& list_unresolvedPatches = unresolvedGroup.list_unresolvedPatches;
-		for (auto it = list_unresolvedPatches.begin(); it != list_unresolvedPatches.end();)
+		std::erase_if(list_unresolvedPatches, [&](PatchEntry* entry)
 		{
-			auto r = (*it)->resolve(patchContext);
+			auto r = entry->resolve(patchContext);
 			if (r == PATCH_RESOLVE_RESULT::RESOLVED)
 			{
-				// remove from list
-				it = list_unresolvedPatches.erase(it);
 				numResolvedEntries++;
-				continue;
+				return true;
 			}
 			else if (r == PATCH_RESOLVE_RESULT::UNKNOWN_VARIABLE)
 			{
 				// dependency on other not yet resolved entry, continue iterating
-				it++;
-				continue;
 			}
 			else if (r == PATCH_RESOLVE_RESULT::INVALID_ADDRESS ||
 				r == PATCH_RESOLVE_RESULT::VARIABLE_CONFLICT)
 			{
 				// errors handled and printed inside resolve()
-				it++;
-				continue;
 			}
 			else
 			{
 				// unknown error
-				sint32 lineNumber = (*it)->getLineNumber();
+				sint32 lineNumber = entry->getLineNumber();
 				patchContext.errorHandler.printError(resolverState.currentGroup, lineNumber, "Unable to parse expression or other internal error");
-				it++;
 			}
-		}
+			return false;
+		});
 	}
 	return numResolvedEntries;
 }
@@ -574,6 +568,12 @@ void GraphicPack2::ApplyPatchGroups(std::vector<PatchGroup*>& groups, const RPLM
 		if (patchGroup->codeCaveSize > 0)
 		{
 			auto codeCaveMem = RPLLoader_AllocateCodeCaveMem(256, patchGroup->codeCaveSize);
+			if (!codeCaveMem)
+			{
+				patchContext.errorHandler.printError(patchGroup, -1, fmt::format("Not enough code cave memory for {} bytes, the code caves of all graphic packs share {} bytes", patchGroup->codeCaveSize, MEMORY_CODECAVEAREA_SIZE));
+				patchContext.errorHandler.showStageErrorMessageBox();
+				return;
+			}
 			cemuLog_log(LogType::Force, "Applying patch group \'{}\' (Codecave: {:08x}-{:08x})", patchGroup->name, codeCaveMem.GetMPTR(), codeCaveMem.GetMPTR() + patchGroup->codeCaveSize);
 			patchGroup->codeCaveMem = codeCaveMem;
 		}
diff --git a/src/Cafe/GraphicPack/GraphicPack2PatchesParser.cpp b/src/Cafe/GraphicPack/GraphicPack2PatchesParser.cpp
index d93cc15..31682f2 100644
--- a/src/Cafe/GraphicPack/GraphicPack2PatchesParser.cpp
+++ b/src/Cafe/GraphicPack/GraphicPack2PatchesParser.cpp
@@ -56,9 +56,9 @@ void GraphicPack2::AddPatchGroup(PatchGroup* group)
 		if (patchData)
 		{
 			uint32 patchAddr = patchData->getAddr();
-			if (patchAddr < 0x00100000)
+			if (patchAddr < PatchGroup::CODECAVE_MAX_OFFSET)
 			{
-				// everything in low 1MB of memory we consider part of the code cave
+				// everything that gets relocated relative to the code cave needs to be part of it
 				codeCaveMaxAddr = std::max(codeCaveMaxAddr, patchAddr + patchData->getSize());
 			}
 		}
