From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patryk <papyszoo@gmail.com>
Date: Wed, 18 Nov 2026 00:22:33 +0100
Subject: [PATCH] PS5: the Vulkan log says whether multiview and fragment
 shading rate are there

The BetterVR fork's two-view rendering needs multiview and its foveation a fragment shading rate; Cemu's
log said neither. Two lines after the feature checks: multiview (supported, max views, geometry shader)
and fragment shading rate (supported, layered, 2x2, 4x4).
---
 src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
index b38382ab..d066e86a 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
@@ -384,6 +384,11 @@ void VulkanRenderer::GetDeviceFeatures()
 	m_featureControl.multiview.maxViewCount = multiviewProperties.maxMultiviewViewCount;
 	m_featureControl.multiview.supported = m_featureControl.multiview.supported && multiviewProperties.maxMultiviewViewCount >= 2;
 	m_featureControl.multiview.geometryShader = m_featureControl.multiview.geometryShader && m_featureControl.multiview.supported;
+#if defined(CEMU_PS5)
+	// PS5: the console's driver reports what the BetterVR fork's two-view rendering and foveation need
+	cemuLog_log(LogType::Force, "Vulkan: multiview: {}, max views: {}, geometry shader: {}", m_featureControl.multiview.supported ? "supported" : "unsupported", m_featureControl.multiview.maxViewCount, m_featureControl.multiview.geometryShader);
+	bool ps5Has2x2 = false;
+#endif
 	if (m_featureControl.deviceExtensions.fragment_shading_rate && fragmentShadingRateFeature.attachmentFragmentShadingRate && fragmentShadingRateFeature.pipelineFragmentShadingRate && vkGetPhysicalDeviceFragmentShadingRatesKHR)
 	{
 		auto& rate = m_featureControl.fragmentShadingRate;
@@ -396,9 +401,15 @@ void VulkanRenderer::GetDeviceFeatures()
 		vkGetPhysicalDeviceFragmentShadingRatesKHR(m_physicalDevice, &rateCount, nullptr);
 		std::vector<VkPhysicalDeviceFragmentShadingRateKHR> rates(rateCount, { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADING_RATE_KHR });
 		vkGetPhysicalDeviceFragmentShadingRatesKHR(m_physicalDevice, &rateCount, rates.data());
+#if defined(CEMU_PS5)
+		ps5Has2x2 = std::any_of(rates.begin(), rates.end(), [](const VkPhysicalDeviceFragmentShadingRateKHR& r) { return r.fragmentSize.width == 2 && r.fragmentSize.height == 2; });
+#endif
 		rate.has4x4 = std::any_of(rates.begin(), rates.end(), [](const VkPhysicalDeviceFragmentShadingRateKHR& r) { return r.fragmentSize.width == 4 && r.fragmentSize.height == 4 && (r.sampleCounts & VK_SAMPLE_COUNT_1_BIT) != 0; });
 		cemuLog_log(LogType::Force, "Vulkan: shading rate attachments with {}x{} texels, layered: {}, 4x4: {}", rate.texelSize.width, rate.texelSize.height, rate.layered, rate.has4x4);
 	}
+#if defined(CEMU_PS5)
+	cemuLog_log(LogType::Force, "Vulkan: fragment shading rate: {}, layered: {}, 2x2: {}, 4x4: {}", m_featureControl.fragmentShadingRate.supported ? "supported" : "unsupported", m_featureControl.fragmentShadingRate.layered, ps5Has2x2, m_featureControl.fragmentShadingRate.has4x4);
+#endif
 	if(!m_featureControl.shaderFloatControls.shaderRoundingModeRTEFloat32)
 		cemuLog_log(LogType::Force, "Shader round mode control not available on this device or driver. Some rendering issues might occur.");
 
