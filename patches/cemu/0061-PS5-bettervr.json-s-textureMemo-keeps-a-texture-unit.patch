@@ -10,6 +10,39 @@
 #include "Cafe/HW/Latte/Renderer/OpenGL/LatteTextureViewGL.h"
 #endif
 
+#if defined(CEMU_PS5)
+#include <atomic>
+#include "PS5TexUnitMemo.h" // ps5cemu/port/cemu: the texture-unit memo's key and invalidation
+
+// The runtime's 5 s [draws] line (port/bettervr/xr/runtime.cpp): the texture units a sequence's setup
+// answered from the memo below instead of the view lookup cache. Cemu's GPU thread adds and the runtime
+// takes it on that thread.
+std::atomic<uint64> g_ps5TextureUnitsReused{0};
+
+// bettervr.json's "textureMemo" (port/app/emulator.cpp, on unless "textureMemo": 0): a texture unit whose
+// SQ_TEX resource registers are the same as at its last resolution, with no view added to or removed from
+// the view lookup cache since, keeps the view it resolved to instead of scanning the cache again. What the
+// registers do not carry (the texture's data and swizzle, the shader's depth comparison) is still read from
+// the texture on every sequence, as before.
+bool g_ps5TextureUnitMemo = false;
+
+// one unit's last resolution: the memo's answer, and what the binding reads from the registers besides it
+struct PS5TexUnitMemo
+{
+	ps5texunit::Entry entry;
+	MPTR physMipAddr = 0;
+	uint32 swizzle = 0;
+	uint32 viewFirstMip = 0;
+	uint32 viewNumMips = 0;
+};
+static PS5TexUnitMemo s_texUnitMemo[3][Latte::GPU_LIMITS::NUM_TEXTURES_PER_STAGE];
+
+static inline void ps5TextureUnitReused()
+{
+	g_ps5TextureUnitsReused.store(g_ps5TextureUnitsReused.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+}
+#endif
+
 struct TexScaleXY
 {
 	float xy[2];
@@ -119,79 +152,134 @@ void LatteTexture_updateTexturesForStage(LatteDecompilerShader* shaderContext, u
 		MPTR physAddr = (texRegister.word2.get_BASE_ADDRESS() << 8);
 		if (physAddr == MPTR_NULL)
 			continue; // invalid data
-		MPTR physMipAddr = (texRegister.word3.get_MIP_ADDRESS() << 8);
-
-		// word0
-		const auto word0 = texRegister.word0;
-		auto dim = word0.get_DIM();
-		uint32 pitch = (word0.get_PITCH() + 1) << 3;
-		uint32 width = word0.get_WIDTH() + 1;
-		auto tileMode = word0.get_TILE_MODE();
-		// word1
-		const auto word1 = texRegister.word1;
-		uint32 depth = word1.get_DEPTH();
-		if (dim == Latte::E_DIM::DIM_2D_ARRAY || dim == Latte::E_DIM::DIM_3D || dim == Latte::E_DIM::DIM_2D_ARRAY_MSAA || dim == Latte::E_DIM::DIM_1D_ARRAY)
+
+		const bool isDepthSampler = shaderContext->textureUsesDepthCompare[textureIndex];
+		const auto word4 = texRegister.word4;
+		// what the binding below reads from the registers besides the view; a memo hit takes them from the
+		// entry, a miss from the registers as before
+		MPTR physMipAddr;
+		uint32 swizzle = 0;
+		uint32 viewFirstMip;
+		uint32 viewNumMips;
+		LatteTextureView* textureView = nullptr;
+#if defined(CEMU_PS5)
+		// bettervr.json's textureMemo: the same SQ_TEX words at the same stage and unit, with no view added or
+		// removed since, resolve to the same view as last time; the view lookup cache is not asked again
+		PS5TexUnitMemo* memo = nullptr;
+		ps5texunit::Key memoKey{};
+		if (g_ps5TextureUnitMemo && (uint32)shaderContext->shaderType < 3)
 		{
-			depth = depth + 1;
+			memoKey.words[0] = texRegister.word0.getRawValue();
+			memoKey.words[1] = texRegister.word1.getRawValue();
+			memoKey.words[2] = texRegister.word2.getRawValue();
+			memoKey.words[3] = texRegister.word3.getRawValue();
+			memoKey.words[4] = texRegister.word4.getRawValue();
+			memoKey.words[5] = texRegister.word5.getRawValue();
+			memoKey.words[6] = texRegister.word6.getRawValue();
+			memoKey.stage = (uint32)shaderContext->shaderType;
+			memoKey.unit = (uint32)textureIndex;
+			memoKey.isDepthSampler = isDepthSampler;
+			memo = &s_texUnitMemo[(uint32)shaderContext->shaderType][textureIndex];
+			if (ps5texunit::Hit(memo->entry, memoKey))
+			{
+				textureView = static_cast<LatteTextureView*>(memo->entry.view);
+				physMipAddr = memo->physMipAddr;
+				swizzle = memo->swizzle;
+				viewFirstMip = memo->viewFirstMip;
+				viewNumMips = memo->viewNumMips;
+				ps5TextureUnitReused();
+			}
 		}
-		else
+#endif
+		if (textureView == nullptr)
 		{
-			if (dim == Latte::E_DIM::DIM_CUBEMAP)
-				depth = 6 * (depth + 1);
-			if (depth == 0)
-				depth = 1;
-		}
-		uint32 height = word1.get_HEIGHT() + 1;
-		if (dim == Latte::E_DIM::DIM_1D || dim == Latte::E_DIM::DIM_1D_ARRAY)
-			height = 1;
-		if (Latte::IsCompressedFormat(word1.get_DATA_FORMAT()))
-			pitch /= 4;
-		// view slice
-		const auto word4 = texRegister.word4;
-		const auto word5 = texRegister.word5;
+			physMipAddr = (texRegister.word3.get_MIP_ADDRESS() << 8);
+
+			// word0
+			const auto word0 = texRegister.word0;
+			auto dim = word0.get_DIM();
+			uint32 pitch = (word0.get_PITCH() + 1) << 3;
+			uint32 width = word0.get_WIDTH() + 1;
+			auto tileMode = word0.get_TILE_MODE();
+			// word1
+			const auto word1 = texRegister.word1;
+			uint32 depth = word1.get_DEPTH();
+			if (dim == Latte::E_DIM::DIM_2D_ARRAY || dim == Latte::E_DIM::DIM_3D || dim == Latte::E_DIM::DIM_2D_ARRAY_MSAA || dim == Latte::E_DIM::DIM_1D_ARRAY)
+			{
+				depth = depth + 1;
+			}
+			else
+			{
+				if (dim == Latte::E_DIM::DIM_CUBEMAP)
